{
  "name": "aquila-pro-school-os",
  "version": "1.0.0",
  "description": "Áquila Pro - Sistema de Segurança e Engajamento Escolar (Desktop) - Produção v1.0",
  "main": "dist/main.js",
  "homepage": "./",
  "author": {
    "name": "André Jr",
    "email": "andrejrunb@yahoo.com.br"
  },
  "license": "Proprietary",
  "scripts": {
    "dev": "concurrently \"npm run dev:electron\" \"npm run dev:renderer\"",
    "dev:electron": "tsc --project tsconfig.json && electron .",
    "dev:renderer": "vite --port 3001",
    "build": "rimraf dist && npm run build:renderer && npm run build:electron && npm run build:python",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.js",
    "build:python": "powershell -ExecutionPolicy Bypass -File scripts/build-python.ps1",
    "build:web": "vite build --mode web",
    "build:apk": "npm run build:web && npx cap sync android",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:linux": "npm run build && electron-builder --linux",
    "postinstall": "electron-builder install-app-deps",
    "clean": "rimraf dist build release",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "jest --config jest.config.js"
  },
  "dependencies": {
    "@types/sqlite3": "^3.1.11",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.7.0",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.0",
    "electron-log": "^5.1.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.7.0",
    "node-schedule": "^2.1.1",
    "nodemailer": "^6.9.0",
    "pdf-lib": "^1.17.1",
    "qrcode.react": "^4.2.0",
    "recharts": "^3.8.0",
    "sharp": "^0.33.0",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/crypto-js": "^4.2.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/node-schedule": "^2.1.0",
    "@types/nodemailer": "^6.4.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.0",
    "jest": "^29.7.0",
    "postcss": "^8.5.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^5.0.0",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.0",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vite-plugin-pwa": "^1.2.0"
  },
  "build": {
    "appId": "com.aquilapro.desktop",
    "productName": "Áquila Pro",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sqlite3/**/*",
      "**/node_modules/better-sqlite3/**/*",
      "**/node_modules/onnxruntime-node/**/*",
      "**/node_modules/sharp/**/*",
      "**/node_modules/@serialport/**/*"
    ],
    "artifactName": "AquilaPro-Setup-${version}.${ext}",
    "copyright": "Copyright © 2026 André Jr - Áquila Pro",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "build/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/python_workers/",
        "to": "python_workers/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icons/icon.png",
      "publisherName": "André Jr - Áquila Pro",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "installerHeader": "resources/installerHeader.png",
      "unicode": true,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Áquila Pro",
      "license": "resources/license.txt",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "perMachine": true,
      "runAfterFinish": true,
      "include": "resources/installer.nsh"
    },
    "portable": {
      "artifactName": "AquilaPro-Portable-${version}.exe"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "resources/icons/",
      "category": "Education"
    },
    "publish": {
      "provider": "generic",
      "url": "https://updates.aquilapro.com.br/releases/",
      "channel": "latest"
    }
  }
}
