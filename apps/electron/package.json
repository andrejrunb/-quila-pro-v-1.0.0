{
  "name": "aquila-pro-school-os",
  "version": "2.1.0",
  "description": "Aquila Pro - Sovereign AI Ecosystem (Desktop) - Maturidade Nível 10",
  "main": "dist/main.js",
  "homepage": "./",
  "author": "Andre Jr <andrejrunb@yahoo.com.br>",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:electron\" \"pnpm run dev:renderer\"",
    "dev:electron": "tsc --project tsconfig.json && powershell -Command \"Start-Sleep -s 5\" && electron .",
    "dev:renderer": "vite --port 3001",
    "build": "rimraf dist && pnpm run build:renderer && pnpm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.js",
    "build:python": "powershell -ExecutionPolicy Bypass -File scripts/build-python.ps1",
    "build:web": "vite build --mode web",
    "build:apk": "pnpm run build:web && npx cap sync android",
    "pack": "pnpm run build && electron-builder --dir",
    "dist": "pnpm run build && electron-builder",
    "dist:win": "pnpm run build && pnpm run build:python && electron-builder --win --x64",
    "dist:linux": "pnpm run build && electron-builder --linux",
    "postinstall": "electron-builder install-app-deps",
    "clean": "rimraf dist build release",
    "lint": "eslint src --ext .ts,.tsx",
    "seed": "ts-node -e \"require('./src/tests/seed_full.ts')\" --project tsconfig.json",
    "test": "jest --config jest.config.js",
    "test:e2e": "tsc --project tsconfig.json && playwright test e2e/main_flow.spec.ts"
  },
  "dependencies": {
    "@aquila/api": "workspace:*",
    "@chainsafe/libp2p-noise": "^15.0.0",
    "@google/generative-ai": "^0.24.1",
    "@libp2p/mdns": "^9.0.0",
    "@libp2p/mplex": "^10.0.0",
    "@libp2p/tcp": "^9.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@supabase/supabase-js": "^2.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/three": "^0.184.0",
    "animejs": "^4.3.0-beta.2",
    "axios": "^1.7.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.5.0",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "electron-log": "^5.1.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "exceljs": "^3.4.0",
    "google-auth-library": "^11.1.0",
    "googleapis": "^183.0.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-types": "^0.24.8",
    "inversify": "^6.2.2",
    "it-length-prefixed": "^9.0.0",
    "it-pipe": "^3.0.0",
    "konva": "^10.2.3",
    "libp2p": "^3.3.11",
    "lucide-react": "^1.7.0",
    "minisearch": "^7.2.0",
    "next": "16.3.8",
    "node-schedule": "^2.1.1",
    "nodemailer": "^10.0.13",
    "pdf-lib": "^1.17.1",
    "qrcode-terminal": "^0.12.0",
    "qrcode.react": "^4.2.0",
    "react-is": "^19.2.5",
    "react-konva": "18.2.10",
    "recharts": "^3.8.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.5",
    "three": "^0.184.0",
    "uint8arrays": "^5.0.0",
    "use-image": "^1.1.4",
    "uuid": "^9.0.0",
    "ws": "^8.16.0",
    "zod": "^4.3.6",
    "archiver": "^7.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/crypto-js": "^4.2.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/node-schedule": "^2.1.0",
    "@types/nodemailer": "^6.4.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^8.2.0",
    "electron": "28.3.3",
    "electron-builder": "24.13.3",
    "jest": "^29.7.0",
    "postcss": "^8.5.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^5.0.0",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.21",
    "vite-plugin-node-polyfills": "^0.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-build": "^7.4.0",
    "@types/archiver": "^6.0.2",
    "@jest/globals": "^29.7.0"
  },
  "build": {
    "appId": "com.aquilapro.desktop",
    "productName": "Aquila Pro",
    "npmRebuild": true,
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sqlite3/**/*",
      "**/node_modules/better-sqlite3/**/*",
      "**/node_modules/onnxruntime-node/**/*",
      "**/node_modules/sharp/**/*",
      "**/node_modules/@serialport/**/*"
    ],
    "artifactName": "AquilaPro-Setup-${version}.${ext}",
    "copyright": "Copyright © 2026 André Jr - Áquila Pro",
    "directories": {
      "buildResources": "resources",
      "output": "release_v2_2"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/python_workers",
        "to": "python_workers"
      },
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icons/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "installerHeader": "resources/installerHeader.png",
      "unicode": true,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aquila Pro",
      "license": "resources/license.txt",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "perMachine": true,
      "runAfterFinish": true,
      "include": "resources/installer.nsh"
    },
    "portable": {
      "artifactName": "AquilaPro-Portable-${version}.exe"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "resources/icons/",
      "category": "Education"
    },
    "publish": {
      "provider": "generic",
      "url": "https://updates.aquilapro.com.br/releases/",
      "channel": "latest"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}