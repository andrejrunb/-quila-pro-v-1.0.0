{
  "appId": "com.aquilapro.desktop",
  "productName": "Aquila Pro",
  "npmRebuild": true,
  "asar": true,
  "asarUnpack": [
    "**/node_modules/sqlite3/**/*",
    "**/node_modules/better-sqlite3/**/*",
    "**/node_modules/onnxruntime-node/**/*",
    "**/node_modules/sharp/**/*",
    "**/node_modules/@serialport/**/*"
  ],
  "artifactName": "AquilaPro-Setup-${version}.${ext}",
  "copyright": "Copyright © 2026 André Jr - Áquila Pro",
  "directories": {
    "buildResources": "resources",
    "output": "release_v2_2"
  },
  "files": [
    "dist/**/*",
    "!dist/python_workers/**",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "dist/python_workers",
      "to": "python_workers"
    },
    {
      "from": "resources/",
      "to": "resources/",
      "filter": [
        "**/*"
      ]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "resources/icon.ico",
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "installerHeader": "resources/installerHeader.png",
    "unicode": true,
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "allowElevation": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Aquila Pro",
    "license": "resources/license.txt",
    "installerLanguages": [
      "pt_BR"
    ],
    "language": "1046",
    "perMachine": true,
    "runAfterFinish": true,
    "include": "resources/installer.nsh"
  },
  "portable": {
    "artifactName": "AquilaPro-Portable-${version}.exe"
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "icon": "resources/icons/",
    "category": "Education"
  },
  "publish": {
    "provider": "generic",
    "url": "https://updates.aquilapro.com.br/releases/",
    "channel": "latest"
  },
  "afterPack": "scripts/apply-fuses.js"
}
