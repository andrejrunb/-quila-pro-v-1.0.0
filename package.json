{
  "name": "aquila-monorepo",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@12.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:electron": "pnpm --filter aquila-pro-school-os dev",
    "dev:web": "pnpm --filter @aquila/web dev",
    "dev:mobile": "pnpm --filter aquila-pro-mobile start",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:dr": "node scripts/sqlite_backup_dr.cjs",
    "test:dr:full": "node scripts/test_backup_dr_suite.cjs",
    "test:stress": "node scripts/stress_test_pilot_load.cjs",
    "test:stress:realistic": "node scripts/stress_test_pilot_realistic.cjs",
    "test:e2e:critical": "node scripts/test_e2e_critical_flow.cjs",
    "backup:edge": "node scripts/backup_edge.cjs",
    "restore:drill": "node scripts/restore_edge.cjs",
    "lint": "pnpm -r run lint",
    "test:stress:hostile": "node scripts/stress_test_pilot_hostile_env.cjs",
    "audit:package": "pnpm dlx tsx scripts/audit_distribution_package.ts",
    "gpu:status": "python scripts/gpu_dev_swarm.py --status",
    "gpu:coder": "python scripts/gpu_dev_swarm.py --role coder",
    "gpu:qa": "python scripts/gpu_dev_swarm.py --role qa",
    "gpu:security": "python scripts/gpu_dev_swarm.py --role security",
    "gpu:architect": "python scripts/gpu_dev_swarm.py --role architect",
    "colab:test": "python scripts/colab_tunnel_manager.py --test"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
