{
  "name": "aquila-monorepo",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:electron": "pnpm --filter aquila-pro-school-os dev",
    "dev:web": "pnpm --filter @aquila/web dev",
    "dev:mobile": "pnpm --filter aquila-pro-mobile start",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:dr": "node scripts/sqlite_backup_dr.cjs",
    "test:dr:full": "node scripts/test_backup_dr_suite.cjs",
    "test:stress": "node scripts/stress_test_pilot_load.cjs",
    "test:stress:realistic": "node scripts/stress_test_pilot_realistic.cjs",
    "test:e2e:critical": "node scripts/test_e2e_critical_flow.cjs",
    "backup:edge": "node scripts/backup_edge.cjs",
    "restore:drill": "node scripts/restore_edge.cjs",
    "lint": "pnpm -r run lint",
    "test:stress:hostile": "node scripts/stress_test_pilot_hostile_env.cjs"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
