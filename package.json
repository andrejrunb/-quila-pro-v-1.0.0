{
  "name": "aquila-monorepo",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:electron": "pnpm --filter aquila-pro-school-os dev",
    "dev:web": "pnpm --filter @aquila/web dev",
    "dev:mobile": "pnpm --filter aquila-pro-mobile start",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
