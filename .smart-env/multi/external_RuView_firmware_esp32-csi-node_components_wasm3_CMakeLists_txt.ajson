
"smart_sources:external/RuView/firmware/esp32-csi-node/components/wasm3/CMakeLists.txt": {"path":"external/RuView/firmware/esp32-csi-node/components/wasm3/CMakeLists.txt","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"1q272da","at":1774580075003},"class_name":"SmartSource","last_import":{"mtime":1774491750504,"size":3004,"at":1774580075006,"hash":"1q272da"},"blocks":{"#WASM3 — WebAssembly interpreter for ESP-IDF":[1,2],"#WASM3 — WebAssembly interpreter for ESP-IDF#{1}":[2,2],"#ADR-040: Tier 3 WASM programmable sensing layer.":[3,3],"#WASM3 is an MIT-licensed, lightweight interpreter (~100 KB flash, ~10 KB RAM)":[4,4],"#optimized for embedded targets including Xtensa ESP32-S3.":[5,6],"#optimized for embedded targets including Xtensa ESP32-S3.#{1}":[6,6],"#Pre-download WASM3 source before building:":[7,7],"#cd firmware/esp32-csi-node/components/wasm3":[8,8],"#git clone --depth 1 https://github.com/wasm3/wasm3.git wasm3-src":[9,10],"#git clone --depth 1 https://github.com/wasm3/wasm3.git wasm3-src#{1}":[10,10],"#Or run: scripts/fetch-wasm3.sh":[11,20],"#Or run: scripts/fetch-wasm3.sh#{1}":[13,20],"#Try downloading inside build environment.":[21,44],"#Try downloading inside build environment.#{1}":[22,44],"#Register empty component so ESP-IDF doesn't error.":[45,50],"#Register empty component so ESP-IDF doesn't error.#{1}":[46,50],"#Collect all WASM3 source files.":[51,58],"#Collect all WASM3 source files.#{1}":[52,58],"#WASM3 configuration for ESP32-S3 Xtensa target.":[59,69],"#WASM3 configuration for ESP32-S3 Xtensa target.#{1}":[60,69],"#Suppress warnings from third-party code.":[70,77],"#Suppress warnings from third-party code.#{1}":[71,77]},"outlinks":[],"task_lines":[],"tasks":{},"codeblock_ranges":[]},