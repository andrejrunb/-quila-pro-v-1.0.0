
"smart_sources:docs/SCALABILITY_ANALYSIS.md": {"path":"docs/SCALABILITY_ANALYSIS.md","embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.06357282,-0.02362803,-0.00346684,-0.04993184,0.00218755,0.03526022,-0.00665036,0.01517968,0.03896698,0.01326771,-0.0034441,-0.09723269,0.00844477,0.04042079,0.0025939,0.00541289,0.04644337,0.01657169,-0.0260642,-0.02149422,0.05646138,-0.06651691,-0.05459864,-0.03781592,0.04298513,0.03960805,-0.00559846,-0.04837466,-0.02215133,-0.24125944,0.05373362,-0.06418096,0.07315446,-0.01286431,-0.01045646,0.04069312,-0.00467478,0.03594988,-0.03401376,0.00933145,-0.0373816,0.04809857,-0.08250973,-0.02502366,-0.02205276,-0.08684394,-0.03511159,0.00509447,-0.08209109,-0.00392489,-0.07854798,-0.03054338,0.04506734,-0.02379941,-0.04164346,0.01172955,0.03871994,0.01803328,0.06471093,-0.00574615,0.05298354,0.05785172,-0.21888302,-0.01214048,0.03333562,0.04358088,-0.02850405,-0.02881197,-0.01336287,0.01354916,-0.05407669,0.00078926,0.06166143,0.05874455,0.07750834,0.03314865,0.01828486,-0.07753327,-0.04446119,-0.00836039,0.02186421,0.03707894,-0.03523371,-0.0108781,0.00890353,-0.0157094,0.07945059,-0.01694665,0.05936773,-0.0098211,-0.03829928,0.03261742,-0.01282149,0.02646662,-0.03332959,-0.03576808,0.03245243,0.05352352,0.03786895,0.08554108,-0.04098206,0.00456683,0.07327942,-0.02332234,0.06073215,0.00696712,-0.04191502,-0.06044265,-0.03178189,0.00662761,-0.04794413,-0.01533591,-0.01484973,-0.0492596,0.02919644,-0.01585888,-0.02120228,-0.00011363,-0.00583791,-0.00936833,0.00914191,0.03283852,0.04295828,-0.01986439,0.04074971,-0.04473707,0.05308929,0.0840288,0.05144965,0.06250951,0.03664548,0.0240467,-0.05177743,0.05097213,0.00229725,0.04894745,0.02309912,0.01610479,-0.01859641,0.01268341,-0.06174581,-0.0004687,0.06488866,-0.06343168,-0.04264717,0.14211483,-0.01428083,0.055077,-0.04869394,-0.06704844,-0.04190131,0.04894556,-0.03777314,-0.01332806,-0.03953144,0.00495993,-0.00512281,0.04145377,-0.08969182,0.01935657,-0.05355227,-0.06447612,0.04637011,0.1