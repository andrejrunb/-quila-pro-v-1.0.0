
"smart_sources:docs/PERFORMANCE_OPTIMIZATION.md": {"path":"docs/PERFORMANCE_OPTIMIZATION.md","embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.1022576,0.01991351,0.0031366,0.03367921,0.01830987,0.02887111,-0.02859569,0.01767856,0.10959949,0.02545965,0.04749116,-0.05475238,-0.0149731,0.03323189,-0.02216345,0.01018098,0.02402312,0.02440364,-0.01507398,-0.0391934,0.03631342,-0.04134506,-0.04488309,-0.08339936,0.04671451,-0.00786639,-0.03513201,0.0059126,-0.00194556,-0.21243234,0.03619809,-0.04681191,0.04136169,0.00175182,0.01112687,0.01966351,-0.01515858,0.03012105,-0.0592874,0.02763376,0.01019184,0.12364397,-0.05958599,-0.06003277,0.02160476,-0.01381005,-0.02876562,-0.0436491,-0.06187308,0.01953116,-0.08618384,-0.04280902,0.0073409,-0.01732513,0.00196385,0.01083181,0.02963208,0.0222781,0.00417229,0.00635955,-0.00302472,0.0199867,-0.19220014,0.02203362,0.06050888,-0.00147606,-0.04949274,-0.04546224,0.00807857,0.03017357,-0.01726254,0.05835705,0.11076301,0.05706453,-0.00342597,0.03332885,0.00707489,-0.04196726,0.05232896,0.01125691,-0.01824891,-0.02655066,-0.06957006,-0.05978078,0.02222241,-0.00358065,0.0144181,0.02531867,0.05639596,0.01606882,-0.0636481,-0.00419071,0.00456436,0.04634612,0.06192216,0.01042852,0.01274581,0.06744136,-0.0220486,0.12241396,-0.03321384,0.00257899,0.0375785,-0.03797819,0.06846991,-0.01695643,-0.01917281,-0.00406504,-0.04019027,-0.00765587,0.01071089,-0.05464675,0.0087001,-0.03013937,0.03746249,-0.01365512,-0.03100288,0.04079556,-0.00489472,0.03371998,0.03116531,0.02085494,0.03662455,-0.0443921,0.05360902,-0.02048716,0.03858921,0.07645047,-0.01498823,0.06798018,0.05005205,0.02675578,0.00144524,0.0553432,0.03797252,-0.01082405,0.02886741,0.02377664,-0.04124484,-0.01768651,-0.04701529,-0.02679327,0.05655923,-0.10090381,-0.01736581,0.15460329,-0.03445439,0.06842923,-0.06509051,-0.08586957,-0.02426699,0.04350887,-0.0770745,-0.05045392,-0.04980807,0.00723213,-0.0146345,0.06338017,-0.07144657,0.00360404,-0.07197405,0.00343029,-0.02076266,0.07143907,0.00703825,-0.05538528,-0.05330877,0.03348698,-0.01343806,0.01818571,0.01282536,0.00678096,-0.06065883,-0.01452525,0.01516551,-0.02239731,-0.05611672,0.0168923,-0.03081659,-0.0474066,0.01823347,0.01650043,-0.06391586,-0.03488672,0.08214578,-0.0000833,0.01109366,-0.00528951,0.00945178,-0.02087175,-0.08611862,-0.08205092,-0.01095104,0.03512855,0.01734048,-0.00187744,0.02180285,-0.00796645,0.01315045,0.01586687,0.1033861,0.05217255,0.00537105,0.0693672,-0.00675487,0.02727065,-0.08508866,-0.03499632,0.0389629,0.0657404,-0.08115528,-0.07753996,0.06273458,0.0178172,0.00671251,-0.0145998,0.02051724,0.11992254,0.03609866,0.03581507,0.03896945,0.01756277,-0.07784837,-0.19603957,0.00920117,-0.01388103,0.04079608,0.05522506,-0.04539406,0.03528871,-0.00711647,0.04778885,0.01370832,0.06069452,-0.04049986,-0.04277689,0.00233634,-0.01645646,-0.01069397,-0.04119568,-0.01453832,-0.02145624,-0.01077486,0.0300783,0.05402045,0.01438693,-0.0362865,-0.00140416,-0.01619958,0.13592441,-0.03926144,0.03122896,-0.01577995,0.02700517,-0.00098484,-0.02496218,-0.06391013,0.03978682,0.06263397,0.05904879,-0.00616248,0.02968321,0.03048339,-0.00019125,0.03554382,0.01888167,-0.09180839,-0.06635656,0.00386363,0.01114253,0.01797327,-0.12164997,0.02135117,0.01115995,-0.00587077,0.01026313,-0.00520719,0.04496447,-0.03443736,-0.09050979,0.01340053,-0.10118517,0.06264955,0.02971658,-0.03474019,-0.03847424,0.01225659,0.07271745,0.00185547,0.0165978,-0.07033741,-0.03496278,0.01229136,0.04504677,0.1110338,-0.0047951,0.00610918,0.06968381,0.0034238,0.00348427,-0.05964697,-0.03078488,-0.05705896,0.07199232,0.00624887,0.03681787,0.05622176,0.01419755,-0.02544846,0.09380193,-0.02827516,-0.05051902,0.00221946,0.01810106,-0.0032423,-0.06470393,0.02293735,0.04858904,0.05396983,-0.29475677,-0.03304172,0.04369883,-0.03294974,-0.00214633,-0.03171698,0.06716396,-0.0769354,-0.03040519,0.06372882,-0.04333724,0.0514733,-0.06577915,0.00596637,0.01416789,0.01074276,0.0397973,-0.02758527,0.09482774,-0.01375313,-0.01997693,0.01816671,0.19834119,-0.03591338,-0.00500724,0.04579899,-0.02837562,0.00042051,0.04861435,0.00904378,0.00001289,-0.01745574,0.09283326,-0.03647204,-0.03235321,0.068467,-0.00469765,0.0304643,0.043339,0.03805083,0.02620111,-0.01744501,0.03921657,-0.03204064,0.06037659,-0.0331291,-0.04895407,-0.03436507,-0.03980412,0.02321765,-0.03529281,0.01753064,0.04496082,-0.03470767,0.08201607,0.00531627,-0.03648515,-0.01197974,-0.04848279,-0.02034348,0.03448889,-0.03601053,0.01128607,0.03355585,-0.04309789],"last_embed":{"hash":"1b0rw7b","tokens":439}}},"last_read":{"hash":"1b0rw7b","at":1774580832113},"class_name":"SmartSource","last_import":{"mtime":1773447493344,"size":11454,"at":1774579781554,"hash":"1b0rw7b"},"blocks":{"#Guia de Otimizações de Performance - Áquila Pro\\n\\n## 🎯 Objetivos de Performance\\n\\n```\\nMétrica              | Target   | Aceitável | Crítico\\n─────────────────────┼──────────┼───────────┼─────────\\nLatência Detecção    | <100ms   | <200ms    | >500ms\\nLatência Reconhecimento | <500ms | <1000ms   | >2000ms\\nThroughput (FPS)     | 30+      | 20+       | <10\\nUso de CPU           | <70%     | <85%      | >95%\\nUso de RAM           | <60%     | <75%      | >90%\\nUptime               | 99.9%    | 99.5%     | <99%\\nTempo de Resposta UI | <100ms   | <200ms    | >500ms\\n```\\n\\n---\\n\\n## 🔧 Otimizações de CPU\\n\\n### 1. Processamento Paralelo com Worker Threads\\n\\n```typescript\\n// ❌ Ineficiente: Sequencial (1000ms para 10 frames)\\nfor (const frame of frames) {\\n  const detections = await detectPeople(frame); // 100ms\\n  const faces = await extractFaces(frame); // 50ms\\n  const matches = await recognizeFaces(faces); // 150ms\\n  // Total: 300ms por frame × 10 = 3000ms\\n}\\n\\n// ✅ Eficiente: Paralelo com threads (300ms para 10 frames)\\nimport { Worker } from 'worker_threads';\\n\\nconst workerPool = new WorkerPool(4);\\nconst results = await Promise.all(\\n  frames.map(frame => workerPool.process(frame))\\n);\\n// Total: ~300ms (processamento paralelo)\\n\\n// Ganho: 10x mais rápido\\n```\\n\\n### 2. Batch Processing para Reconhecimento Facial\\n\\n```typescript\\n// ❌ Ineficiente: Processar cada face individualmente\\nfor (const face of faces) {\\n  const embedding = await model.predict(face); // 50ms cada\\n  // Total: 50ms × 100 faces = 5000ms\\n}\\n\\n// ✅ Eficiente: Batch processing\\nconst embeddings = await model.predict(faces); // 50ms para 100\\n// Total: 50ms (processamento vetorizado)\\n\\n// Ganho: 100x mais rápido\\n```\\n\\n### 3. Caching de Embeddings\\n\\n```typescript\\n// ❌ Ineficiente: Recalcular embedding a cada frame\\nfor (const detection of detections) {\\n  const embedding = await faceModel.predict(detection.face);\\n  const match = await findMatch(embedding);\\n}\\n\\n// ✅ Eficiente: Cache com TTL\\nconst embeddingCache = new Map();\\n\\nfor (const detection of detections) {\\n  const cacheKey = `${detection.faceId}`;\\n  \\n  let embedding = embeddingCache.get(cacheKey);\\n  if (!embedding) {\\n    embedding = await faceModel.predict(detection.face);\\n    embeddingCache.set(cacheKey, embedding);\\n    \\n    // Auto-limpeza após 5 minutos\\n    setTimeout(() => embeddingCache.delete(cacheKey), 5 * 60 * 1000);\\n  }\\n  \\n  const match = await findMatch(embedding);\\n}\\n\\n// Ganho: 50-80% redução de CPU\\n```\\n\\n### 4. Lazy Loading de Modelos\\n\\n```typescript\\n// ❌ Ineficiente: Carregar todos os modelos na inicialização\\nconst yoloModel = await loadModel('yolo.onnx'); // 500ms\\nconst faceModel = await loadModel('face_recognition.onnx'); // 500ms\\nconst trackingModel = await loadModel('tracking.onnx'); // 500ms\\n// Total: 1500ms na inicialização\\n\\n// ✅ Eficiente: Lazy loading sob demanda\\nclass ModelManager {\\n  private models = new Map();\\n  \\n  async getModel(name: string) {\\n    if (!this.models.has(name)) {\\n      console.log(`Carregando modelo: ${name}`);\\n      const model = await loadModel(`${name}.onnx`);\\n      this.models.set(name, model);\\n    }\\n    return this.models.get(name);\\n  }\\n}\\n\\nconst modelMgr = new ModelManager();\\nconst yolo = await modelMgr.getModel('yolo'); // Carrega na primeira vez\\n// Próximas chamadas: <1ms (cache)\\n\\n// Ganho: 1500ms → 0ms na inicialização\\n```\\n\\n---\\n\\n## 💾 Otimizações de RAM\\n\\n### 1. Buffer Circular para Frames\\n\\n```typescript\\n// ❌ Ineficiente: Manter todos os frames em memória\\nconst allFrames = [];\\nfor (const stream of streams) {\\n  const frame = await stream.getFrame();\\n  allFrames.push(frame); // Cresce indefinidamente\\n  // 1920×1080×3 bytes × 30 FPS × 5 câmeras = 900MB/s\\n}\\n\\n// ✅ Eficiente: Buffer circular com tamanho fixo\\nclass CircularFrameBuffer {\\n  private buffer: Buffer[];\\n  private index = 0;\\n  \\n  constructor(size: number) {\\n    this.buffer = new Array(size);\\n  }\\n  \\n  push(frame: Buffer) {\\n    this.buffer[this.index] = frame;\\n    this.index = (this.index + 1) % this.buffer.length;\\n  }\\n  \\n  getLatest() {\\n    return this.buffer[(this.index - 1 + this.buffer.length) % this.buffer.length];\\n  }\\n}\\n\\nconst frameBuffer = new CircularFrameBuffer(10); // Apenas 10 frames\\nfor (const stream of streams) {\\n  const frame = await stream.getFrame();\\n  frameBuffer.push(frame);\\n  processFrame(frameBuffer.getLatest());\\n}\\n\\n// Ganho: 900MB/s → 27MB (fixo)\\n```\\n\\n### 2. Compressão de Imagens\\n\\n```typescript\\n// ❌ Ineficiente: Armazenar frames em resolução total\\nconst frame = await camera.getFrame(); // 1920×1080 = 6.2MB\\nembeddings.push(frame); // Cresce rapidamente\\n\\n// ✅ Eficiente: Comprimir antes de armazenar\\nimport sharp from 'sharp';\\n\\nconst compressed = await sharp(frame)\\n  .resize(640, 480) // Reduzir resolução\\n  .jpeg({ quality: 70 }) // Comprimir JPEG\\n  .toBuffer();\\n// 1920×1080 → 640×480 = 0.9MB (85% redução)\\n\\nembeddings.push(compressed);\\n\\n// Ganho: 6.2MB → 0.9MB por frame (85% redução)\\n```\\n\\n### 3. Object Pool para Detecções\\n\\n```typescript\\n// ❌ Ineficiente: Criar novo objeto a cada detecção\\nfor (const detection of rawDetections) {\\n  const obj = {\\n    x: detection.x,\\n    y: detection.y,\\n    width: detection.width,\\n    height: detection.height,\\n    confidence: detection.confidence,\\n  }; // Aloca memória a cada iteração\\n  processDetection(obj);\\n}\\n\\n// ✅ Eficiente: Reutilizar objetos do pool\\nclass DetectionPool {\\n  private pool: Detection[] = [];\\n  \\n  acquire(data: any): Detection {\\n    const detection = this.pool.pop() || new Detection();\\n    detection.x = data.x;\\n    detection.y = data.y;\\n    detection.width = data.width;\\n    detection.height = data.height;\\n    detection.confidence = data.confidence;\\n    return detection;\\n  }\\n  \\n  release(detection: Detection) {\\n    this.pool.push(detection);\\n  }\\n}\\n\\nconst pool = new DetectionPool();\\nfor (const rawDetection of rawDetections) {\\n  const detection = pool.acquire(rawDetection);\\n  processDetection(detection);\\n  pool.release(detection);\\n}\\n\\n// Ganho: Reduz garbage collection em 70%\\n```\\n\\n---\\n\\n## 💿 Otimizações de Disco\\n\\n### 1. Armazenamento Seletivo\\n\\n```typescript\\n// ❌ Ineficiente: Salvar todos os frames\\nfor (const frame of frames) {\\n  await fs.writeFile(`frame-${i}.jpg`, frame);\\n  // 30 FPS × 5 câmeras × 0.9MB = 135MB/s\\n  // 1 dia = 11.7TB\\n}\\n\\n// ✅ Eficiente: Salvar apenas alertas\\nfor (const frame of frames) {\\n  const detections = await detectPeople(frame);\\n  \\n  if (detections.length > THRESHOLD) {\\n    // Salvar apenas se houver alerta\\n    await fs.writeFile(`alert-${alertId}.jpg`, frame);\\n  }\\n}\\n\\n// Ganho: 11.7TB/dia → 100GB/dia (99% redução)\\n```\\n\\n### 2. Rotação de Logs com Compressão\\n\\n```typescript\\n// ❌ Ineficiente: Arquivo de log crescendo indefinidamente\\nlogger.info('Evento'); // Append ao arquivo\\n// Arquivo cresce 1GB/dia\\n\\n// ✅ Eficiente: Rotação automática + compressão\\nclass RollingFileLogger {\\n  private currentFile = 'app.log';\\n  private maxSize = 100 * 1024 * 1024; // 100MB\\n  \\n  async log(message: string) {\\n    const stat = await fs.stat(this.currentFile);\\n    \\n    if (stat.size > this.maxSize) {\\n      // Comprimir arquivo antigo\\n      await compress(this.currentFile, `${this.currentFile}.gz`);\\n      \\n      // Criar novo arquivo\\n      this.currentFile = `app-${Date.now()}.log`;\\n    }\\n    \\n    await fs.appendFile(this.currentFile, message + '\\\\n');\\n  }\\n}\\n\\n// Ganho: 1GB/dia → 50MB/dia (95% redução)\\n```\\n\\n### 3. Backup Incremental\\n\\n```typescript\\n// ❌ Ineficiente: Backup completo diariamente\\nconst backup = await db.export(); // 500MB\\nawait upload(backup); // 1 hora\\n\\n// ✅ Eficiente: Backup incremental\\nclass IncrementalBackup {\\n  private lastBackupTime = 0;\\n  \\n  async backup() {\\n    const changes = await db.getChangesSince(this.lastBackupTime);\\n    const backup = JSON.stringify(changes); // 50MB\\n    \\n    await upload(backup);\\n    this.lastBackupTime = Date.now();\\n  }\\n}\\n\\n// Ganho: 500MB → 50MB (90% redução)\\n```\\n\\n---\\n\\n## 🌐 Otimizações de Rede\\n\\n### 1. Compressão de WebSocket\\n\\n```typescript\\n// ❌ Ineficiente: Enviar JSON sem compressão\\nconst message = JSON.stringify({\\n  type: 'detections',\\n  data: detections,\\n  timestamp: Date.now(),\\n});\\nws.send(message); // 50KB\\n\\n// ✅ Eficiente: Comprimir com gzip\\nimport zlib from 'zlib';\\n\\nconst compressed = zlib.gzipSync(message);\\nws.send(compressed); // 5KB (90% redução)\\n\\n// Ganho: 50KB → 5KB por mensagem\\n```\\n\\n### 2. Batching de Mensagens\\n\\n```typescript\\n// ❌ Ineficiente: Enviar cada detecção individualmente\\nfor (const detection of detections) {\\n  ws.send(JSON.stringify({type: 'detection', data: detection}));\\n}\\n// 100 detecções = 100 mensagens\\n\\n// ✅ Eficiente: Agrupar em batches\\nconst batch = [];\\nfor (const detection of detections) {\\n  batch.push(detection);\\n  \\n  if (batch.length >= 50) {\\n    ws.send(JSON.stringify({type: 'batch', data: batch}));\\n    batch.length = 0;\\n  }\\n}\\n\\n// Ganho: 100 mensagens → 2 mensagens\\n```\\n\\n### 3. Delta Encoding\\n\\n```typescript\\n// ❌ Ineficiente: Enviar frame completo a cada atualização\\nconst frame = await camera.getFrame();\\nws.send(JSON.stringify({type: 'frame', data: frame}));\\n// 900KB por frame\\n\\n// ✅ Eficiente: Enviar apenas mudanças\\nlet lastFrame = null;\\n\\nfor (const frame of frames) {\\n  const delta = calculateDelta(lastFrame, frame);\\n  ws.send(JSON.stringify({type: 'delta', data: delta}));\\n  lastFrame = frame;\\n}\\n\\n// Ganho: 900KB → 50KB (94% redução)\\n```\\n\\n---\\n\\n## 📊 Benchmarks de Performance\\n\\n### Teste 1: Detecção de Pessoas (YOLO)\\n\\n```\\nResolução | CPU | GPU | Tempo | FPS\\n───────────────────────────────────\\n640×480   | 10% | 5%  | 20ms  | 50\\n1280×720  | 25% | 15% | 50ms  | 20\\n1920×1080 | 50% | 30% | 100ms | 10\\n```\\n\\n### Teste 2: Reconhecimento Facial\\n\\n```\\nModo      | Tempo | Throughput\\n──────────────────────────────\\nSequencial| 500ms | 2 faces/s\\nBatch (10)| 50ms  | 200 faces/s\\nBatch (50)| 100ms | 500 faces/s\\n```\\n\\n### Teste 3: Rastreamento\\n\\n```\\nAlgoritmo | CPU | Latência | Acurácia\\n──────────────────────────────────────\\nCentroid  | 5%  | 10ms     | 85%\\nKalman    | 15% | 30ms     | 92%\\nDeep SORT | 40% | 100ms    | 96%\\n```\\n\\n---\\n\\n## 🎯 Checklist de Otimização\\n\\n- [ ] Implementar worker threads para processamento paralelo\\n- [ ] Adicionar caching de embeddings com TTL\\n- [ ] Usar buffer circular para frames\\n- [ ] Comprimir imagens antes de armazenar\\n- [ ] Implementar object pool para detecções\\n- [ ] Configurar rotação de logs com compressão\\n- [ ] Implementar backup incremental\\n- [ ] Adicionar compressão de WebSocket\\n- [ ] Implementar batching de mensagens\\n- [ ] Usar delta encoding para frames\\n- [ ] Monitorar métricas de performance\\n- [ ] Fazer load testing com carga esperada\\n- [ ] Documentar limites de sistema\\n- [ ] Criar plano de escalabilidade\\n":[1,2]},"outlinks":[],"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"1b0rw7b","at":1774580831971}},"smart_blocks:docs/PERFORMANCE_OPTIMIZATION.md#Guia de Otimizações de Performance - Áquila Pro\\n\\n## 🎯 Objetivos de Performance\\n\\n```\\nMétrica              | Target   | Aceitável | Crítico\\n─────────────────────┼──────────┼───────────┼─────────\\nLatência Detecção    | <100ms   | <200ms    | >500ms\\nLatência Reconhecimento | <500ms | <1000ms   | >2000ms\\nThroughput (FPS)     | 30+      | 20+       | <10\\nUso de CPU           | <70%     | <85%      | >95%\\nUso de RAM           | <60%     | <75%      | >90%\\nUptime               | 99.9%    | 99.5%     | <99%\\nTempo de Resposta UI | <100ms   | <200ms    | >500ms\\n```\\n\\n---\\n\\n## 🔧 Otimizações de CPU\\n\\n### 1. Processamento Paralelo com Worker Threads\\n\\n```typescript\\n// ❌ Ineficiente: Sequencial (1000ms para 10 frames)\\nfor (const frame of frames) {\\n  const detections = await detectPeople(frame); // 100ms\\n  const faces = await extractFaces(frame); // 50ms\\n  const matches = await recognizeFaces(faces); // 150ms\\n  // Total: 300ms por frame × 10 = 3000ms\\n}\\n\\n// ✅ Eficiente: Paralelo com threads (300ms para 10 frames)\\nimport { Worker } from 'worker_threads';\\n\\nconst workerPool = new WorkerPool(4);\\nconst results = await Promise.all(\\n  frames.map(frame => workerPool.process(frame))\\n);\\n// Total: ~300ms (processamento paralelo)\\n\\n// Ganho: 10x mais rápido\\n```\\n\\n### 2. Batch Processing para Reconhecimento Facial\\n\\n```typescript\\n// ❌ Ineficiente: Processar cada face individualmente\\nfor (const face of faces) {\\n  const embedding = await model.predict(face); // 50ms cada\\n  // Total: 50ms × 100 faces = 5000ms\\n}\\n\\n// ✅ Eficiente: Batch processing\\nconst embeddings = await model.predict(faces); // 50ms para 100\\n// Total: 50ms (processamento vetorizado)\\n\\n// Ganho: 100x mais rápido\\n```\\n\\n### 3. Caching de Embeddings\\n\\n```typescript\\n// ❌ Ineficiente: Recalcular embedding a cada frame\\nfor (const detection of detections) {\\n  const embedding = await faceModel.predict(detection.face);\\n  const match = await findMatch(embedding);\\n}\\n\\n// ✅ Eficiente: Cache com TTL\\nconst embeddingCache = new Map();\\n\\nfor (const detection of detections) {\\n  const cacheKey = `${detection.faceId}`;\\n  \\n  let embedding = embeddingCache.get(cacheKey);\\n  if (!embedding) {\\n    embedding = await faceModel.predict(detection.face);\\n    embeddingCache.set(cacheKey, embedding);\\n    \\n    // Auto-limpeza após 5 minutos\\n    setTimeout(() => embeddingCache.delete(cacheKey), 5 * 60 * 1000);\\n  }\\n  \\n  const match = await findMatch(embedding);\\n}\\n\\n// Ganho: 50-80% redução de CPU\\n```\\n\\n### 4. Lazy Loading de Modelos\\n\\n```typescript\\n// ❌ Ineficiente: Carregar todos os modelos na inicialização\\nconst yoloModel = await loadModel('yolo.onnx'); // 500ms\\nconst faceModel = await loadModel('face_recognition.onnx'); // 500ms\\nconst trackingModel = await loadModel('tracking.onnx'); // 500ms\\n// Total: 1500ms na inicialização\\n\\n// ✅ Eficiente: Lazy loading sob demanda\\nclass ModelManager {\\n  private models = new Map();\\n  \\n  async getModel(name: string) {\\n    if (!this.models.has(name)) {\\n      console.log(`Carregando modelo: ${name}`);\\n      const model = await loadModel(`${name}.onnx`);\\n      this.models.set(name, model);\\n    }\\n    return this.models.get(name);\\n  }\\n}\\n\\nconst modelMgr = new ModelManager();\\nconst yolo = await modelMgr.getModel('yolo'); // Carrega na primeira vez\\n// Próximas chamadas: <1ms (cache)\\n\\n// Ganho: 1500ms → 0ms na inicialização\\n```\\n\\n---\\n\\n## 💾 Otimizações de RAM\\n\\n### 1. Buffer Circular para Frames\\n\\n```typescript\\n// ❌ Ineficiente: Manter todos os frames em memória\\nconst allFrames = [];\\nfor (const stream of streams) {\\n  const frame = await stream.getFrame();\\n  allFrames.push(frame); // Cresce indefinidamente\\n  // 1920×1080×3 bytes × 30 FPS × 5 câmeras = 900MB/s\\n}\\n\\n// ✅ Eficiente: Buffer circular com tamanho fixo\\nclass CircularFrameBuffer {\\n  private buffer: Buffer[];\\n  private index = 0;\\n  \\n  constructor(size: number) {\\n    this.buffer = new Array(size);\\n  }\\n  \\n  push(frame: Buffer) {\\n    this.buffer[this.index] = frame;\\n    this.index = (this.index + 1) % this.buffer.length;\\n  }\\n  \\n  getLatest() {\\n    return this.buffer[(this.index - 1 + this.buffer.length) % this.buffer.length];\\n  }\\n}\\n\\nconst frameBuffer = new CircularFrameBuffer(10); // Apenas 10 frames\\nfor (const stream of streams) {\\n  const frame = await stream.getFrame();\\n  frameBuffer.push(frame);\\n  processFrame(frameBuffer.getLatest());\\n}\\n\\n// Ganho: 900MB/s → 27MB (fixo)\\n```\\n\\n### 2. Compressão de Imagens\\n\\n```typescript\\n// ❌ Ineficiente: Armazenar frames em resolução total\\nconst frame = await camera.getFrame(); // 1920×1080 = 6.2MB\\nembeddings.push(frame); // Cresce rapidamente\\n\\n// ✅ Eficiente: Comprimir antes de armazenar\\nimport sharp from 'sharp';\\n\\nconst compressed = await sharp(frame)\\n  .resize(640, 480) // Reduzir resolução\\n  .jpeg({ quality: 70 }) // Comprimir JPEG\\n  .toBuffer();\\n// 1920×1080 → 640×480 = 0.9MB (85% redução)\\n\\nembeddings.push(compressed);\\n\\n// Ganho: 6.2MB → 0.9MB por frame (85% redução)\\n```\\n\\n### 3. Object Pool para Detecções\\n\\n```typescript\\n// ❌ Ineficiente: Criar novo objeto a cada detecção\\nfor (const detection of rawDetections) {\\n  const obj = {\\n    x: detection.x,\\n    y: detection.y,\\n    width: detection.width,\\n    height: detection.height,\\n    confidence: detection.confidence,\\n  }; // Aloca memória a cada iteração\\n  processDetection(obj);\\n}\\n\\n// ✅ Eficiente: Reutilizar objetos do pool\\nclass DetectionPool {\\n  private pool: Detection[] = [];\\n  \\n  acquire(data: any): Detection {\\n    const detection = this.pool.pop() || new Detection();\\n    detection.x = data.x;\\n    detection.y = data.y;\\n    detection.width = data.width;\\n    detection.height = data.height;\\n    detection.confidence = data.confidence;\\n    return detection;\\n  }\\n  \\n  release(detection: Detection) {\\n    this.pool.push(detection);\\n  }\\n}\\n\\nconst pool = new DetectionPool();\\nfor (const rawDetection of rawDetections) {\\n  const detection = pool.acquire(rawDetection);\\n  processDetection(detection);\\n  pool.release(detection);\\n}\\n\\n// Ganho: Reduz garbage collection em 70%\\n```\\n\\n---\\n\\n## 💿 Otimizações de Disco\\n\\n### 1. Armazenamento Seletivo\\n\\n```typescript\\n// ❌ Ineficiente: Salvar todos os frames\\nfor (const frame of frames) {\\n  await fs.writeFile(`frame-${i}.jpg`, frame);\\n  // 30 FPS × 5 câmeras × 0.9MB = 135MB/s\\n  // 1 dia = 11.7TB\\n}\\n\\n// ✅ Eficiente: Salvar apenas alertas\\nfor (const frame of frames) {\\n  const detections = await detectPeople(frame);\\n  \\n  if (detections.length > THRESHOLD) {\\n    // Salvar apenas se houver alerta\\n    await fs.writeFile(`alert-${alertId}.jpg`, frame);\\n  }\\n}\\n\\n// Ganho: 11.7TB/dia → 100GB/dia (99% redução)\\n```\\n\\n### 2. Rotação de Logs com Compressão\\n\\n```typescript\\n// ❌ Ineficiente: Arquivo de log crescendo indefinidamente\\nlogger.info('Evento'); // Append ao arquivo\\n// Arquivo cresce 1GB/dia\\n\\n// ✅ Eficiente: Rotação automática + compressão\\nclass RollingFileLogger {\\n  private currentFile = 'app.log';\\n  private maxSize = 100 * 1024 * 1024; // 100MB\\n  \\n  async log(message: string) {\\n    const stat = await fs.stat(this.currentFile);\\n    \\n    if (stat.size > this.maxSize) {\\n      // Comprimir arquivo antigo\\n      await compress(this.currentFile, `${this.currentFile}.gz`);\\n      \\n      // Criar novo arquivo\\n      this.currentFile = `app-${Date.now()}.log`;\\n    }\\n    \\n    await fs.appendFile(this.currentFile, message + '\\\\n');\\n  }\\n}\\n\\n// Ganho: 1GB/dia → 50MB/dia (95% redução)\\n```\\n\\n### 3. Backup Incremental\\n\\n```typescript\\n// ❌ Ineficiente: Backup completo diariamente\\nconst backup = await db.export(); // 500MB\\nawait upload(backup); // 1 hora\\n\\n// ✅ Eficiente: Backup incremental\\nclass IncrementalBackup {\\n  private lastBackupTime = 0;\\n  \\n  async backup() {\\n    const changes = await db.getChangesSince(this.lastBackupTime);\\n    const backup = JSON.stringify(changes); // 50MB\\n    \\n    await upload(backup);\\n    this.lastBackupTime = Date.now();\\n  }\\n}\\n\\n// Ganho: 500MB → 50MB (90% redução)\\n```\\n\\n---\\n\\n## 🌐 Otimizações de Rede\\n\\n### 1. Compressão de WebSocket\\n\\n```typescript\\n// ❌ Ineficiente: Enviar JSON sem compressão\\nconst message = JSON.stringify({\\n  type: 'detections',\\n  data: detections,\\n  timestamp: Date.now(),\\n});\\nws.send(message); // 50KB\\n\\n// ✅ Eficiente: Comprimir com gzip\\nimport zlib from 'zlib';\\n\\nconst compressed = zlib.gzipSync(message);\\nws.send(compressed); // 5KB (90% redução)\\n\\n// Ganho: 50KB → 5KB por mensagem\\n```\\n\\n### 2. Batching de Mensagens\\n\\n```typescript\\n// ❌ Ineficiente: Enviar cada detecção individualmente\\nfor (const detection of detections) {\\n  ws.send(JSON.stringify({type: 'detection', data: detection}));\\n}\\n// 100 detecções = 100 mensagens\\n\\n// ✅ Eficiente: Agrupar em batches\\nconst batch = [];\\nfor (const detection of detections) {\\n  batch.push(detection);\\n  \\n  if (batch.length >= 50) {\\n    ws.send(JSON.stringify({type: 'batch', data: batch}));\\n    batch.length = 0;\\n  }\\n}\\n\\n// Ganho: 100 mensagens → 2 mensagens\\n```\\n\\n### 3. Delta Encoding\\n\\n```typescript\\n// ❌ Ineficiente: Enviar frame completo a cada atualização\\nconst frame = await camera.getFrame();\\nws.send(JSON.stringify({type: 'frame', data: frame}));\\n// 900KB por frame\\n\\n// ✅ Eficiente: Enviar apenas mudanças\\nlet lastFrame = null;\\n\\nfor (const frame of frames) {\\n  const delta = calculateDelta(lastFrame, frame);\\n  ws.send(JSON.stringify({type: 'delta', data: delta}));\\n  lastFrame = frame;\\n}\\n\\n// Ganho: 900KB → 50KB (94% redução)\\n```\\n\\n---\\n\\n## 📊 Benchmarks de Performance\\n\\n### Teste 1: Detecção de Pessoas (YOLO)\\n\\n```\\nResolução | CPU | GPU | Tempo | FPS\\n───────────────────────────────────\\n640×480   | 10% | 5%  | 20ms  | 50\\n1280×720  | 25% | 15% | 50ms  | 20\\n1920×1080 | 50% | 30% | 100ms | 10\\n```\\n\\n### Teste 2: Reconhecimento Facial\\n\\n```\\nModo      | Tempo | Throughput\\n──────────────────────────────\\nSequencial| 500ms | 2 faces/s\\nBatch (10)| 50ms  | 200 faces/s\\nBatch (50)| 100ms | 500 faces/s\\n```\\n\\n### Teste 3: Rastreamento\\n\\n```\\nAlgoritmo | CPU | Latência | Acurácia\\n──────────────────────────────────────\\nCentroid  | 5%  | 10ms     | 85%\\nKalman    | 15% | 30ms     | 92%\\nDeep SORT | 40% | 100ms    | 96%\\n```\\n\\n---\\n\\n## 🎯 Checklist de Otimização\\n\\n- [ ] Implementar worker threads para processamento paralelo\\n- [ ] Adicionar caching de embeddings com TTL\\n- [ ] Usar buffer circular para frames\\n- [ ] Comprimir imagens antes de armazenar\\n- [ ] Implementar object pool para detecções\\n- [ ] Configurar rotação de logs com compressão\\n- [ ] Implementar backup incremental\\n- [ ] Adicionar compressão de WebSocket\\n- [ ] Implementar batching de mensagens\\n- [ ] Usar delta encoding para frames\\n- [ ] Monitorar métricas de performance\\n- [ ] Fazer load testing com carga esperada\\n- [ ] Documentar limites de sistema\\n- [ ] Criar plano de escalabilidade\\n": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.10722679,0.01820281,-0.01153151,0.02112237,0.0182005,0.03185039,-0.02267953,0.00779346,0.10093845,0.01943812,0.04694775,-0.05662671,-0.01774515,0.02701826,-0.01538185,0.00377949,0.02582936,0.01792572,-0.00572648,-0.04852585,0.03536686,-0.04429717,-0.05007456,-0.07760736,0.0385969,0.00340119,-0.03021502,0.0