
"smart_sources:docs/HIGH_PRIORITY_IMPLEMENTATION.md": {"path":"docs/HIGH_PRIORITY_IMPLEMENTATION.md","embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.07715844,0.002247,0.02058756,-0.01911613,0.00050435,0.04786804,0.00069718,-0.01423146,0.04086214,0.04737987,0.00617087,-0.11035101,-0.02080947,0.04928573,0.00958023,-0.00785226,0.05063725,0.05961936,-0.0409669,-0.01234979,0.04721573,-0.03510807,0.01158569,-0.06599316,-0.00329739,0.04408583,-0.05160924,0.01711278,0.00174846,-0.22456782,-0.00540779,-0.0760327,0.06614765,-0.02158245,-0.02196236,-0.02528531,-0.06778008,0.02205884,-0.04161013,-0.00168139,-0.01745716,0.0443297,-0.09105811,-0.05477279,-0.04301563,-0.06164106,-0.00388499,-0.03821235,-0.04488651,-0.04733465,0.03510037,-0.05959878,0.01341966,0.01843749,0.02803151,0.03695794,0.06593244,0.0314884,0.05074481,0.08205376,0.03743587,0.04399329,-0.15861598,0.06655451,-0.0365525,0.00236919,-0.03325697,-0.01317865,-0.01380476,0.02915368,-0.03123053,-0.04150124,0.02433937,0.05734504,0.03966876,-0.02386224,0.0690955,-0.03532898,0.01764845,-0.05967281,0.00173018,0.0912974,0.00749396,-0.03395422,0.01423841,-0.0259953,0.0673102,-0.08048318,-0.00989895,-0.02494066,-0.08224234,-0.0054363,-0.04518506,0.02461841,0.01669382,0.0061446,-0.01375839,0.03089295,-0.06906374,0.11332903,-0.02620344,0.00112638,-0.01964016,-0.02904308,0.06968188,-0.03629889,0.03202105,-0.0265745,-0.06847387,-0.00684114,-0.04043892,-0.09266714,0.03787192,-0.02763089,-0.00679003,0.029882,0.01402536,0.07064795,0.01693226,-0.03777761,0.03799225,-0.00037083,0.0637785,-0.01072433,-0.01094537,0.01229841,0.06798221,0.05358288,0.04479516,0.07572131,0.07600565,0.03520581,-0.03286674,0.02540749,-0.01145629,0.00413132,-0.00628491,-0.01747633,-0.04530389,-0.03006757,-0.02299627,0.00446936,0.03919235,-0.05951108,-0.04483666,0.09534155,-0.06020789,0.09069826,-0.04061686,-0.06261442,-0.02392097,0.03425623,-0.06464354,0.03236775,-0.02258218,-0.02802667,0.00809168,0.03067276,-0.040775,0.02722582,-0.02830583,-0.07705835,-0.0