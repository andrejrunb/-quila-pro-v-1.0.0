
"smart_sources:skills/antigravity-awesome-skills/hig-foundations/references/materials.md": {"path":"skills/antigravity-awesome-skills/hig-foundations/references/materials.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"1hafqd","at":1774580040121},"class_name":"SmartSource","last_import":{"mtime":1774321842245,"size":24534,"at":1774580040287,"hash":"1hafqd"},"blocks":{"#---frontmatter---":[1,null]},"outlinks":[{"title":"A sketch of overlapping squares, suggesting the use of transparency to hint at background content. The image is overlaid with rectangular and circular grid lines and is tinted yellow to subtly reflect the yellow in the original six-color Apple logo.","target":"https://docs-assets.developer.apple.com/published/7dbd8b65138bed71acdeb36135193681/foundations-materials-intro%402x.png","line":9,"embedded":true},{"title":"Liquid Glass","target":"https://developer.apple.com/design/human-interface-guidelines/materials#Liquid-Glass","line":13},{"title":"standard materials","target":"https://developer.apple.com/design/human-interface-guidelines/materials#Standard-materials","line":13},{"title":"Liquid Glass","target":"https://developer.apple.com/design/human-interface-guidelines/materials#Liquid-Glass","line":15},{"title":"standard materials","target":"https://developer.apple.com/design/human-interface-guidelines/materials#Standard-materials","line":19},{"title":"sliders","target":"https://developer.apple.com/design/human-interface-guidelines/sliders","line":19},{"title":"toggles","target":"https://developer.apple.com/design/human-interface-guidelines/toggles","line":19},{"title":"Applying Liquid Glass to custom views","target":"https://developer.apple.com/documentation/SwiftUI/Applying-Liquid-Glass-to-custom-views","line":21},{"title":"`clear`","target":"https://developer.apple.com/documentation/SwiftUI/Glass/clear","line":23},{"title":"`regular`","target":"https://developer.apple.com/documentation/SwiftUI/Glass/regular","line":23},{"title":"A visual example of the regular variant of Liquid Glass, which appears darker when there is a dark background beneath it.","target":"https://docs-assets.developer.apple.com/published/91bd48556358ab3deb6720c982aa8503/materials-ios-liquid-glass-regular-on-dark%402x.png","line":27,"embedded":true},{"title":"A visual example of the regular variant of Liquid Glass, which appears lighter when there is a light background beneath it.","target":"https://docs-assets.developer.apple.com/published/07aee30876315c8b2985a59a3ac1df31/materials-ios-liquid-glass-regular-on-light%402x.png","line":29,"embedded":true},{"title":"A visual example of the clear variant of Liquid Glass, which allows the visual detail of the background beneath it to show through.","target":"https://docs-assets.developer.apple.com/published/fe0cd9171626ada19f9ea7343f60a426/materials-ios-liquid-glass-clear%402x.png","line":33,"embedded":true},{"title":"`clear`","target":"https://developer.apple.com/documentation/SwiftUI/Glass/clear","line":37},{"title":"Liquid Glass color","target":"https://developer.apple.com/design/human-interface-guidelines/color#Liquid-Glass-color","line":44},{"title":"Standard materials","target":"https://developer.apple.com/design/human-interface-guidelines/materials#Standard-materials","line":46},{"title":"blending modes","target":"https://developer.apple.com/documentation/AppKit/NSVisualEffectView/BlendingMode-swift.enum","line":48},{"title":"blur","target":"https://developer.apple.com/documentation/UIKit/UIBlurEffect","line":48},{"title":"vibrancy","target":"https://developer.apple.com/documentation/UIKit/UIVibrancyEffect","line":48},{"title":"System colors","target":"https://developer.apple.com/design/human-interface-guidelines/color#System-colors","line":52},{"title":"An illustration of a Share button with a translucent background material and a symbol. The symbol uses the systemGray3 color and is difficult to see against the background material.","target":"https://docs-assets.developer.apple.com/published/8a395765f911660a5e16b3bdb30ddd2f/materials-legibility-non-vibrant-label%402x.png","line":54,"embedded":true},{"title":"An X in a circle to indicate incorrect usage","target":"https://docs-assets.developer.apple.com/published/209f6f0fc8ad99d9bf59e12d82d06584/crossout%402x.png","line":56,"embedded":true},{"title":"An illustration of a Share button with a translucent background material and a symbol. The symbol uses vibrant color and is clearly visible against the background material.","target":"https://docs-assets.developer.apple.com/published/7495cfbce7d79a1f5635ea2a729dfc24/materials-legibility-primary-label%402x.png","line":58,"embedded":true},{"title":"A checkmark in a circle to indicate correct usage","target":"https://docs-assets.developer.apple.com/published/88662da92338267bb64cd2275c84e484/checkmark%402x.png","line":60,"embedded":true},{"title":"`Material`","target":"https://developer.apple.com/documentation/SwiftUI/Material","line":71},{"title":"Platform considerations","target":"https://developer.apple.com/design/human-interface-guidelines/materials#Platform-considerations","line":73},{"title":"iOS, iPadOS","target":"https://developer.apple.com/design/human-interface-guidelines/materials#iOS-iPadOS","line":75},{"title":"An illustration of the iOS and iPadOS ultraThin material above a colorful background. Where the material overlaps the background, it provides a diffuse gradient of the background colors.","target":"https://docs-assets.developer.apple.com/published/2ad0598be0bf67fb23e479f102e16b59/materials-ios-material-background-ultrathin%402x.png","line":79,"embedded":true},{"title":"An illustration of the iOS and iPadOS thin material above a colorful background. Where the material overlaps the background, it provides a diffuse and slightly darkened gradient of the background colors.","target":"https://docs-assets.developer.apple.com/published/d298de701d98a146b1436fdf21d0b7ce/materials-ios-material-background-thin%402x.png","line":81,"embedded":true},{"title":"An illustration of the iOS and iPadOS regular material above a colorful background. Where the material overlaps the background, it provides a diffuse and darkened gradient of the background colors.","target":"https://docs-assets.developer.apple.com/published/93a77ac4cfc0786664563a0691498b05/materials-ios-material-background-regular%402x.png","line":83,"embedded":true},{"title":"An illustration of the iOS and iPadOS thick material above a colorful background. Where the material overlaps the background, it provides a dark, muted gradient of the background colors.","target":"https://docs-assets.developer.apple.com/published/2532ddf965d0effa12f528ac10b5a0b3/materials-ios-material-background-thick%402x.png","line":85,"embedded":true},{"title":"`thin`","target":"https://developer.apple.com/documentation/SwiftUI/Material/thin","line":89},{"title":"`ultraThin`","target":"https://developer.apple.com/documentation/SwiftUI/Material/ultraThin","line":89},{"title":"`UIVibrancyEffectStyle.label`","target":"https://developer.apple.com/documentation/UIKit/UIVibrancyEffectStyle/label","line":91},{"title":"`UIVibrancyEffectStyle.secondaryLabel`","target":"https://developer.apple.com/documentation/UIKit/UIVibrancyEffectStyle/secondaryLabel","line":93},{"title":"`UIVibrancyEffectStyle.tertiaryLabel`","target":"https://developer.apple.com/documentation/UIKit/UIVibrancyEffectStyle/tertiaryLabel","line":95},{"title":"`UIVibrancyEffectStyle.quaternaryLabel`","target":"https://developer.apple.com/documentation/UIKit/UIVibrancyEffectStyle/quaternaryLabel","line":97},{"title":"`UIVibrancyEffectStyle.fill`","target":"https://developer.apple.com/documentation/UIKit/UIVibrancyEffectStyle/fill","line":104},{"title":"`UIVibrancyEffectStyle.secondaryFill`","target":"https://developer.apple.com/documentation/UIKit/UIVibrancyEffectStyle/secondaryFill","line":106},{"title":"`UIVibrancyEffectStyle.tertiaryFill`","target":"https://developer.apple.com/documentation/UIKit/UIVibrancyEffectStyle/tertiaryFill","line":108},{"title":"separator","target":"https://developer.apple.com/documentation/UIKit/UIVibrancyEffectStyle/separator","line":113},{"title":"macOS","target":"https://developer.apple.com/design/human-interface-guidelines/materials#macOS","line":115},{"title":"system colors","target":"https://developer.apple.com/design/human-interface-guidelines/color#Specifications","line":117},{"title":"`NSVisualEffectView.Material`","target":"https://developer.apple.com/documentation/AppKit/NSVisualEffectView/Material-swift.enum","line":117},{"title":"`NSVisualEffectView.BlendingMode`","target":"https://developer.apple.com/documentation/AppKit/NSVisualEffectView/BlendingMode-swift.enum","line":121},{"title":"tvOS","target":"https://developer.apple.com/design/human-interface-guidelines/materials#tvOS","line":123},{"title":"A screenshot of the Destination Video app running in tvOS. The app shows a screen with details about a video called A BOT-anist Adventure. The background is a colorful image of the main character in a scene from the video. The interface elements floating above the background adopt a Liquid Glass appearance to allow background color to show through and create a more immersive media experience.","target":"https://docs-assets.developer.apple.com/published/fd83bb7f079cac7b59cb692d8e1c6707/materials-tvos-media-player%402x.png","line":127,"embedded":true},{"title":"`ultraThin`","target":"https://developer.apple.com/documentation/SwiftUI/Material/ultraThin","line":133},{"title":"`thin`","target":"https://developer.apple.com/documentation/SwiftUI/Material/thin","line":134},{"title":"`regular`","target":"https://developer.apple.com/documentation/SwiftUI/Material/regular","line":135},{"title":"`thick`","target":"https://developer.apple.com/documentation/SwiftUI/Material/thick","line":136},{"title":"visionOS","target":"https://developer.apple.com/design/human-interface-guidelines/materials#visionOS","line":138},{"title":"An illustration of a field of view in visionOS with a window in the center. The window has an opaque background that obstructs its surroundings.","target":"https://docs-assets.developer.apple.com/published/137ceb38a96227aa8a9d2021ee82a8e2/materials-visionos-opaque-window-incorrect%402x.png","line":154,"embedded":true},{"title":"An X in a circle to indicate incorrect usage","target":"https://docs-assets.developer.apple.com/published/209f6f0fc8ad99d9bf59e12d82d06584/crossout%402x.png","line":156,"embedded":true},{"title":"An illustration of a field of view in visionOS with a window in the center. The window has a translucent material background that allows its surroundings to pass through.","target":"https://docs-assets.developer.apple.com/published/3f23b3476f6cf8cc77fdcb91a0c15063/materials-visionos-glass-window%402x.png","line":158,"embedded":true},{"title":"A checkmark in a circle to indicate correct usage","target":"https://docs-assets.developer.apple.com/published/88662da92338267bb64cd2275c84e484/checkmark%402x.png","line":160,"embedded":true},{"title":"`thin`","target":"https://developer.apple.com/documentation/SwiftUI/Material/thin","line":164},{"title":"`regular`","target":"https://developer.apple.com/documentation/SwiftUI/Material/regular","line":166},{"title":"`thick`","target":"https://developer.apple.com/documentation/SwiftUI/Material/thick","line":168},{"title":"An illustration of a field of view in visionOS with a window in the center. The window is composed of a sidebar on the left and a content area on the right, with a text field at the top and a button in the lower-right corner. The sidebar uses regular material, while the text field uses thick material and the button uses thin material.","target":"https://docs-assets.developer.apple.com/published/c3577aa1e00689431e49973173a151f9/visionos-materials-window-example%402x.png","line":173,"embedded":true},{"title":"`UIVibrancyEffectStyle.label`","target":"https://developer.apple.com/documentation/UIKit/UIVibrancyEffectStyle/label","line":179},{"title":"`UIVibrancyEffectStyle.secondaryLabel`","target":"https://developer.apple.com/documentation/UIKit/UIVibrancyEffectStyle/secondaryLabel","line":181},{"title":"`UIVibrancyEffectStyle.tertiaryLabel`","target":"https://developer.apple.com/documentation/UIKit/UIVibrancyEffectStyle/tertiaryLabel","line":183},{"title":"An illustration of a Share button with a translucent background material and a symbol. The symbol uses the default vibrant label color and has very high contrast against the background material.","target":"https://docs-assets.developer.apple.com/published/8f850521ecc2e3953e8e693fe7b4887b/materials-visionos-label-vibrant-primary%402x.png","line":188,"embedded":true},{"title":"An illustration of a Share button with a translucent background material and a symbol. The symbol uses the secondary vibrant label color and has high contrast against the background material.","target":"https://docs-assets.developer.apple.com/published/876503f2b2b5fd1783e359128ffd2482/materials-visionos-label-vibrant-secondary%402x.png","line":190,"embedded":true},{"title":"An illustration of a Share button with a translucent background material and a symbol. The symbol uses the tertiary vibrant label color and has muted contrast against the background material.","target":"https://docs-assets.developer.apple.com/published/b3b80e5f23b286f6c7897780676e6dfe/materials-visionos-label-vibrant-tertiary%402x.png","line":192,"embedded":true},{"title":"watchOS","target":"https://developer.apple.com/design/human-interface-guidelines/materials#watchOS","line":194},{"title":"An illustration of a modal view in watchOS with an example title, descriptive text, and a single action button. The modal completely covers the screen with a transparent material, and uses a thinner material for the button along with vibrant label text.","target":"https://docs-assets.developer.apple.com/published/b9bdbaa947d461e98681c9fbb87a7052/watchos-modal-view-material-background%402x.png","line":198,"embedded":true},{"title":"Resources","target":"https://developer.apple.com/design/human-interface-guidelines/materials#Resources","line":200},{"title":"Related","target":"https://developer.apple.com/design/human-interface-guidelines/materials#Related","line":202},{"title":"Color","target":"https://developer.apple.com/design/human-interface-guidelines/color","line":204},{"title":"Accessibility","target":"https://developer.apple.com/design/human-interface-guidelines/accessibility","line":206},{"title":"Dark Mode","target":"https://developer.apple.com/design/human-interface-guidelines/dark-mode","line":208},{"title":"Developer documentation","target":"https://developer.apple.com/design/human-interface-guidelines/materials#Developer-documentation","line":210},{"title":"Adopting Liquid Glass","target":"https://developer.apple.com/documentation/TechnologyOverviews/adopting-liquid-glass","line":212},{"title":"`glassEffect(_:in:)`","target":"https://developer.apple.com/documentation/SwiftUI/View/glassEffect\\(_:in:\\","line":214},{"title":"`Material`","target":"https://developer.apple.com/documentation/SwiftUI/Material","line":216},{"title":"`UIVisualEffectView`","target":"https://developer.apple.com/documentation/UIKit/UIVisualEffectView","line":218},{"title":"`NSVisualEffectView`","target":"https://developer.apple.com/documentation/AppKit/NSVisualEffectView","line":220},{"title":"Videos","target":"https://developer.apple.com/design/human-interface-guidelines/materials#Videos","line":222},{"title":"![","target":"https://devimages-cdn.apple.com/wwdc-services/images/3055294D-836B-4513-B7B0-0BC5666246B0/5CD0E251-424E-490F-89CF-1E64848209A6/9910_wide_250x141_1x.jpg","line":224},{"title":"![","target":"https://devimages-cdn.apple.com/wwdc-services/images/3055294D-836B-4513-B7B0-0BC5666246B0/1AAA030E-2ECA-47D8-AE09-6D7B72A840F6/10044_wide_250x141_1x.jpg","line":226},{"title":"Change log","target":"https://developer.apple.com/design/human-interface-guidelines/materials#Change-log","line":228}],"task_lines":[],"tasks":{},"codeblock_ranges":[]},