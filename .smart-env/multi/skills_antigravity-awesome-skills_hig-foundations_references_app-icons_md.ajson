
"smart_sources:skills/antigravity-awesome-skills/hig-foundations/references/app-icons.md": {"path":"skills/antigravity-awesome-skills/hig-foundations/references/app-icons.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"4nyi8q","at":1774580040109},"class_name":"SmartSource","last_import":{"mtime":1774321842231,"size":21082,"at":1774580040287,"hash":"4nyi8q"},"blocks":{"#---frontmatter---":[1,null]},"outlinks":[{"title":"A sketch of the App Store icon. The image is overlaid with rectangular and circular grid lines and is tinted yellow to subtly reflect the yellow in the original six-color Apple logo.","target":"https://docs-assets.developer.apple.com/published/05b8bbb4aac9f98ba8c77876fe5068b7/foundations-app-icons-intro%402x.png","line":9,"embedded":true},{"title":"An image that shows three variations of the Photos app's app icon as it appears on different platforms. The first variation is a rounded rectangle shape, and represents the iOS, iPadOS, and macOS icons. The second variation is an elongated, rounded rectangular shape, and represents the tvOS icon. The third variation is a circular shape, and represents the visionOS and watchOS icons. All variations have the same overall design over different background shapes.","target":"https://docs-assets.developer.apple.com/published/298204fa29c2dc771deb8651963ce75a/app-icons-platform-appearance-overview%402x.png","line":13,"embedded":true},{"title":"Layer design","target":"https://developer.apple.com/design/human-interface-guidelines/app-icons#Layer-design","line":15},{"title":"Creating your app icon using Icon Composer","target":"https://developer.apple.com/documentation/Xcode/creating-your-app-icon-using-icon-composer","line":49},{"title":"Apple Developer website","target":"https://developer.apple.com/icon-composer","line":49},{"title":"A screenshot of the Photos app icon in Icon Composer.","target":"https://docs-assets.developer.apple.com/published/3d4f8c4c6b744e77f32802201fb48fb7/app-icons-icon-composer-overview-photos%402x.png","line":51,"embedded":true},{"title":"Configuring your app icon using an asset catalog","target":"https://developer.apple.com/documentation/Xcode/configuring-your-app-icon","line":53},{"title":"Icon shape","target":"https://developer.apple.com/design/human-interface-guidelines/app-icons#Icon-shape","line":63},{"title":"An image of the Settings icon for iOS. The iOS, iPadOS, and macOS icon grid is overlaid on the icon to show how the icon's shape and its elements map to the grid.","target":"https://docs-assets.developer.apple.com/published/a116649a6bdc5124779475fcd769caac/app-icons-settings-app-grid-square%402x.png","line":73,"embedded":true},{"title":"An image of the Settings icon for tvOS. The tvOS icon grid is overlaid on the icon to show how the icon's shape and its elements map to the grid.","target":"https://docs-assets.developer.apple.com/published/770ec58a9f9985410cdff8c38b8166ab/app-icons-settings-app-grid-rectangle%402x.png","line":75,"embedded":true},{"title":"An image of the Settings icon for watchOS. The visionOS and watchOS icon grid is overlaid on the icon to show how the icon's shape and its elements map to the grid.","target":"https://docs-assets.developer.apple.com/published/2ceefd0eeb7e039a43ab05fd4a5050fb/app-icons-settings-app-grid-circle%402x.png","line":77,"embedded":true},{"title":"Apple Design Resources","target":"https://developer.apple.com/design/resources/","line":81},{"title":"Design","target":"https://developer.apple.com/design/human-interface-guidelines/app-icons#Design","line":83},{"title":"An image of the Podcasts app icon.","target":"https://docs-assets.developer.apple.com/published/58a62b07273dbbc302df7a428103a16e/app-icons-embrace-simplicity-podcasts%402x.png","line":87,"embedded":true},{"title":"An image of the Home app icon.","target":"https://docs-assets.developer.apple.com/published/4932ee4d526fc1b112e611f610a18b08/app-icons-embrace-simplicity-home%402x.png","line":89,"embedded":true},{"title":"An illustration of two circles centered above a grid. One circle encloses the other. The inner circle has a solid fill. The outer circle is larger than the inner circle, allowing some space between them. The outer circle has no fill and shows just an outline.","target":"https://docs-assets.developer.apple.com/published/6b02e91996a97adb2dbe53a8131cc380/app-icons-element-outline-shape%402x.png","line":95,"embedded":true},{"title":"An X in a circle to indicate incorrect usage.","target":"https://docs-assets.developer.apple.com/published/209f6f0fc8ad99d9bf59e12d82d06584/crossout%402x.png","line":97,"embedded":true},{"title":"An illustration of two circles centered above a grid. One circle encloses the other. The inner circle has a solid fill. The outer circle is larger than the inner circle, has no outline, and has a semi-transparent fill that allows the background grid to show through. Together, the two circles give the impression that the inner circle is resting upon the outer circle.","target":"https://docs-assets.developer.apple.com/published/a8d0e9d7b802123c594cf9910fb44a50/app-icons-element-filled-shape%402x.png","line":99,"embedded":true},{"title":"A checkmark in a circle to indicate correct usage.","target":"https://docs-assets.developer.apple.com/published/88662da92338267bb64cd2275c84e484/checkmark%402x.png","line":101,"embedded":true},{"title":"Visual effects","target":"https://developer.apple.com/design/human-interface-guidelines/app-icons#Visual-effects","line":109},{"title":"Appearances","target":"https://developer.apple.com/design/human-interface-guidelines/app-icons#Appearances","line":115},{"title":"A grid showing the six different appearances of the Photos app icon in iOS. The top row shows the default, clear light, and tinted light icon variants. The bottom row shows the dark, clear dark, and tinted dark variants.","target":"https://docs-assets.developer.apple.com/published/a91b68946df73b81596a9a29b0356a4a/app-icons-rendering-modes%402x.png","line":119,"embedded":true},{"title":"Dark Mode","target":"https://developer.apple.com/design/human-interface-guidelines/dark-mode","line":125},{"title":"App Review Guidelines","target":"https://developer.apple.com/app-store/review/guidelines/#design","line":131},{"title":"Platform considerations","target":"https://developer.apple.com/design/human-interface-guidelines/app-icons#Platform-considerations","line":133},{"title":"tvOS","target":"https://developer.apple.com/design/human-interface-guidelines/app-icons#tvOS","line":137},{"title":"A diagram of the Photos app icon in tvOS with a white dotted line inside the outer border, which indicates the safe zone.","target":"https://docs-assets.developer.apple.com/published/f2f3bf70c87e53889768b64a2faf5cf5/tvos-app-icon-safe-zone%402x.png","line":141,"embedded":true},{"title":"visionOS","target":"https://developer.apple.com/design/human-interface-guidelines/app-icons#visionOS","line":143},{"title":"watchOS","target":"https://developer.apple.com/design/human-interface-guidelines/app-icons#watchOS","line":147},{"title":"Specifications","target":"https://developer.apple.com/design/human-interface-guidelines/app-icons#Specifications","line":151},{"title":"Resources","target":"https://developer.apple.com/design/human-interface-guidelines/app-icons#Resources","line":175},{"title":"Related","target":"https://developer.apple.com/design/human-interface-guidelines/app-icons#Related","line":177},{"title":"Apple Design Resources","target":"https://developer.apple.com/design/resources/","line":179},{"title":"Icon Composer","target":"https://developer.apple.com/icon-composer/","line":181},{"title":"Icons","target":"https://developer.apple.com/design/human-interface-guidelines/icons","line":183},{"title":"Images","target":"https://developer.apple.com/design/human-interface-guidelines/images","line":185},{"title":"Dark Mode","target":"https://developer.apple.com/design/human-interface-guidelines/dark-mode","line":187},{"title":"Developer documentation","target":"https://developer.apple.com/design/human-interface-guidelines/app-icons#Developer-documentation","line":189},{"title":"Creating your app icon using Icon Composer","target":"https://developer.apple.com/documentation/Xcode/creating-your-app-icon-using-icon-composer","line":191},{"title":"Configuring your app icon using an asset catalog","target":"https://developer.apple.com/documentation/Xcode/configuring-your-app-icon","line":193},{"title":"Videos","target":"https://developer.apple.com/design/human-interface-guidelines/app-icons#Videos","line":195},{"title":"![","target":"https://devimages-cdn.apple.com/wwdc-services/images/3055294D-836B-4513-B7B0-0BC5666246B0/2C0F206D-6728-49F7-940E-DC5BC5C51B54/9911_wide_250x141_1x.jpg","line":197},{"title":"![","target":"https://devimages-cdn.apple.com/wwdc-services/images/3055294D-836B-4513-B7B0-0BC5666246B0/93AA149B-9ACF-4281-8BAF-5AFF7CFA1CF0/10087_wide_250x141_1x.jpg","line":199},{"title":"Change log","target":"https://developer.apple.com/design/human-interface-guidelines/app-icons#Change-log","line":201}],"task_lines":[],"tasks":{},"codeblock_ranges":[]},