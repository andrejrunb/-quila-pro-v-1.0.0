
"smart_sources:skills/antigravity-awesome-skills/007/scripts/requirements.txt": {"path":"skills/antigravity-awesome-skills/007/scripts/requirements.txt","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"157b6oi","at":1774580030864},"class_name":"SmartSource","last_import":{"mtime":1774321839714,"size":1157,"at":1774580030866,"hash":"157b6oi"},"blocks":{"#007 Security Skill - Dependencies":[1,1],"#==================================":[2,3],"#==================================#{1}":[3,3],"#The 007 scanners, analyzers, and reporting tools are designed to work":[4,4],"#entirely with the Python standard library (stdlib). This means:":[5,6],"#entirely with the Python standard library (stdlib). This means:#{1}":[6,6],"#- No pip install required for basic scanning and auditing":[7,7],"#- Works out of the box on any Python 3.10+ installation":[8,8],"#- Zero supply-chain risk from third-party dependencies":[9,9],"#- Portable across Windows, Linux, and macOS":[10,11],"#- Portable across Windows, Linux, and macOS#{1}":[11,11],"#Modules used from stdlib:":[12,12],"#- re           (regex-based pattern detection)":[13,13],"#- json         (audit logs, reports, config files)":[14,14],"#- pathlib      (cross-platform path handling)":[15,15],"#- logging      (structured console output)":[16,16],"#- datetime     (timestamps for audit trail)":[17,17],"#- ast          (Python AST analysis for deeper code inspection)":[18,18],"#- os / os.path (filesystem traversal fallback)":[19,19],"#- sys          (CLI argument handling)":[20,20],"#- hashlib      (file hashing for change detection)":[21,21],"#- argparse     (CLI interface for all scripts)":[22,22],"#- textwrap     (report formatting)":[23,23],"#- collections  (counters, defaultdicts for aggregation)":[24,25],"#- collections  (counters, defaultdicts for aggregation)#{1}":[25,25],"#No external dependencies required.":[26,27]},"outlinks":[],"task_lines":[],"tasks":{},"codeblock_ranges":[]},