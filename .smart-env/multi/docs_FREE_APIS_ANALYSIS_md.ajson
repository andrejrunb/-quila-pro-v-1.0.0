
"smart_sources:docs/FREE_APIS_ANALYSIS.md": {"path":"docs/FREE_APIS_ANALYSIS.md","embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.00404228,-0.00564012,-0.01845279,-0.01996592,0.03311416,-0.03349343,-0.01292816,0.01511488,0.04676588,0.02910956,-0.02137365,-0.09121296,-0.01340501,0.05373066,0.00133996,-0.05005681,0.04896891,-0.0112175,-0.01469433,-0.0003634,0.09238476,-0.06685074,-0.0472302,-0.08783581,-0.05045028,0.08155293,-0.02957343,-0.03766404,0.02129782,-0.2060492,-0.02032585,-0.02808566,0.03415152,-0.00853516,-0.00436416,0.03265962,-0.02749624,0.00988289,-0.01694817,0.0330899,0.02805829,0.02019186,-0.04973561,0.02038723,-0.01008096,-0.0151427,-0.02478376,0.02807768,-0.06727506,-0.00158622,-0.04979886,-0.0428782,0.00169668,0.00277989,-0.03546038,0.00973865,0.03794156,0.02708889,-0.00515147,0.04180083,0.06301721,0.03981829,-0.22524415,0.0369971,0.01113877,0.06957812,-0.05355842,0.01540635,-0.00619626,-0.05332341,0.00781334,0.0267712,0.03862319,-0.01421503,0.05758999,0.04611937,0.0172433,-0.02012336,0.0087654,0.02733724,0.01132707,0.04640025,-0.01759122,0.01004629,0.00499798,-0.04381434,0.00786559,-0.00891246,0.06506889,-0.03737261,-0.05797226,-0.03830183,0.0545328,0.02832581,0.0204659,0.00342763,0.04225326,0.0336962,-0.04385851,0.11340948,-0.01284284,-0.01232638,0.0389536,-0.03086293,0.04413392,-0.02660905,0.0279725,-0.07839022,-0.00947883,0.05483116,-0.02672169,0.00512426,0.05547216,-0.03514573,-0.04099749,-0.02691296,0.008236,-0.00249853,0.04988484,-0.01999225,-0.02755714,0.00077829,0.02195689,0.01763045,0.0474634,-0.02285643,0.07092921,0.05318318,0.00397337,0.05983366,0.02134149,0.04030556,-0.0596027,0.00202362,-0.02050772,-0.00754491,0.09956628,0.05157883,-0.02679477,0.03091677,-0.06257749,-0.05679674,0.02750883,-0.05770472,0.01430299,0.15701394,0.01565525,0.1129045,0.01145379,-0.07130422,-0.0204414,0.09744535,-0.05216841,-0.01118706,-0.00714084,-0.02548053,0.01749267,0.06572892,-0.05070382,0.05853035,-0.04556022,-0.08046777,0.00128943,0.12190966,0.01195026,-0.07686844,-0.00649136,0.029727,-0.03294626,0.00472309,0.06263025,0.03461355,0.00316689,-0.01089443,0.0230641,0.01221624,-0.05115848,0.01141873,-0.04137528,-0.0088865,-0.02830284,-0.06099981,-0.08961156,0.00715635,-0.00887439,-0.05555748,-0.02787236,-0.05228537,-0.00826905,-0.01851368,-0.06095873,-0.01045776,-0.04313265,0.02022297,-0.0212068,0.0015922,0.00317863,-0.01160958,0.00795232,-0.03165832,0.10163864,0.02570808,0.01001549,-0.01741822,0.0160695,0.02361817,-0.0314354,0.06311878,0.03391227,0.04079938,-0.08218325,0.00631676,0.02251867,0.0420704,0.01058724,-0.00910509,0.0455662,0.03521705,-0.04504235,0.0034518,0.00799078,-0.04408442,-0.05207602,-0.2235136,0.00840068,-0.03510523,0.02838794,-0.00867245,-0.10882226,0.05268616,-0.04324586,0.0525263,0.08533999,0.078652,0.01633384,-0.05158184,0.04961208,-0.03791748,-0.01643911,-0.01433002,0.02760616,-0.01893188,0.01945014,0.01357315,0.03800092,0.05479241,-0.05924263,0.04000323,0.03694974,0.14545839,0.01241788,0.01373771,-0.02230139,0.01941594,-0.02845962,-0.01147994,-0.11213079,0.04312001,0.09112383,0.03049985,-0.01086557,0.04829742,-0.01851456,0.02315432,0.06870673,0.03653492,-0.04670081,-0.0418188,-0.00606584,0.00371574,0.00329939,-0.08922744,0.04111189,-0.00523915,0.01900846,0.02367706,0.04499348,0.00512845,-0.02205729,-0.08542269,0.00683819,-0.05120518,0.03336436,-0.0456391,-0.00846822,-0.01684423,-0.05741138,0.0511319,-0.0456937,-0.01880812,-0.03896927,0.02751767,-0.02081995,0.01180757,0.14042692,-0.03418431,-0.0075148,0.06478396,0.00763075,0.04273833,-0.08081745,-0.04236737,0.00830277,-0.00064957,0.00033253,-0.03985152,0.03813016,0.032122,0.09678344,0.05476619,-0.03330378,-0.01144464,-0.02917124,0.03253126,0.02682834,-0.05374629,-0.02689945,0.06078965,0.04865202,-0.29846439,0.02724561,-0.0031632,-0.01472937,0.02451991,0.03348382,0.05002578,-0.08397949,-0.0394153,-0.02319212,-0.0337606,0.06125974,0.03393523,-0.02279329,0.00857173,-0.00246354,0.0684884,-0.02182204,0.11494384,-0.00966835,-0.0120883,0.03640725,0.19304903,-0.05594583,-0.05001098,-0.00087516,-0.02822927,0.00907761,0.02666055,0.04776789,-0.01939319,0.0138644,0.11509003,-0.00985712,0.02088893,0.0931449,-0.06547529,0.0099432,0.03208201,-0.03589904,-0.02002456,-0.02529661,0.02291965,0.04520056,0.06076064,-0.04074669,-0.06320432,-0.01902778,0.01708565,0.04102189,-0.03509137,-0.06117737,-0.01413588,-0.00171456,0.02816269,0.00841594,-0.05874762,0.00081795,-0.04444178,-0.05711265,-0.02454524,-0.01394243,0.00733694,0.05683818,-0.00440681],"last_embed":{"hash":"hev66r","tokens":457}}},"last_read":{"hash":"hev66r","at":1774580780144},"class_name":"SmartSource","last_import":{"mtime":1773447493314,"size":13312,"at":1774579779528,"hash":"hev66r"},"blocks":{"#💰 Análise de APIs Gratuitas para Áquila Pro\\n\\n## 📋 Visão Geral\\n\\nEste documento analisa **APIs gratuitas e open-source** que podem substituir serviços pagos no Áquila Pro, reduzindo significativamente os custos de operação para escolas.\\n\\n---\\n\\n## 🎯 Categorias de APIs Necessárias\\n\\n### 1. **Reconhecimento Facial** (Crítico)\\n\\n#### ❌ PAGO: OpenAI Vision API\\n- **Custo**: $0.01 por imagem (Vision API)\\n- **Limite**: Sem limite oficial, mas caro em escala\\n- **Latência**: 2-5 segundos\\n- **Precisão**: 95%+\\n- **Custo Anual (500 alunos, 250 dias)**: ~$1,250\\n\\n#### ✅ GRATUITO: CompreFace (Open-Source)\\n- **Custo**: $0 (self-hosted)\\n- **Requisitos**: Docker, GPU recomendada\\n- **Latência**: 100-500ms (com GPU)\\n- **Precisão**: 95%+ (comparável ao OpenAI)\\n- **Vantagens**:\\n  - Totalmente open-source\\n  - Self-hosted (dados privados)\\n  - Sem limites de requisições\\n  - Suporta múltiplos modelos\\n  - Integração com Docker\\n- **Desvantagens**:\\n  - Requer infraestrutura própria\\n  - Precisa de GPU para performance\\n\\n**Implementação**:\\n```bash\\n# Docker Compose\\ndocker run -d -p 8000:8000 exadel/compreface:latest\\n\\n# API Usage\\ncurl -X POST http://localhost:8000/api/v1/recognition/recognize \\\\\\n  -F \\\"file=@photo.jpg\\\" \\\\\\n  -F \\\"det_prob_threshold=0.8\\\"\\n```\\n\\n#### ✅ GRATUITO: face_recognition (Python Library)\\n- **Custo**: $0 (pip install)\\n- **Latência**: 50-200ms (CPU), 10-50ms (GPU)\\n- **Precisão**: 99.38% (dlib-based)\\n- **Vantagens**:\\n  - Extremamente rápido\\n  - Sem dependências externas\\n  - Já implementado no projeto\\n  - Melhor para edge computing\\n- **Desvantagens**:\\n  - Requer processamento local\\n  - Menos robusto em ângulos extremos\\n\\n#### ✅ GRATUITO: DeepFace (Python Library)\\n- **Custo**: $0 (pip install)\\n- **Latência**: 100-300ms (CPU)\\n- **Precisão**: 98%+\\n- **Vantagens**:\\n  - Múltiplos backends (VGGFace, FaceNet, ArcFace)\\n  - Detecção de emoções\\n  - Análise de idade/gênero\\n  - Muito flexível\\n\\n**Comparação de Custos (500 alunos, 250 dias):**\\n\\n| Solução | Custo Anual | Latência | Precisão | Recomendação |\\n|---------|-----------|----------|----------|---------------|\\n| OpenAI Vision | $1,250 | 2-5s | 95% | ❌ Caro |\\n| CompreFace | $0 (+GPU) | 100-500ms | 95% | ✅ Melhor |\\n| face_recognition | $0 | 50-200ms | 99% | ✅ Ideal |\\n| DeepFace | $0 | 100-300ms | 98% | ✅ Alternativa |\\n\\n**Recomendação**: **face_recognition** (já implementado) + **CompreFace** como backup\\n\\n---\\n\\n### 2. **Notificações e Alertas** (Alto)\\n\\n#### ❌ PAGO: Twilio SMS\\n- **Custo**: $0.0075 por SMS (Brasil ~R$0.03)\\n- **Custo Anual (500 alunos, 2 alertas/dia)**: ~$3,650/ano\\n- **Latência**: 1-3 segundos\\n- **Confiabilidade**: 99.9%\\n\\n#### ✅ GRATUITO: Mailgun Email API\\n- **Custo**: Gratuito até 5,000 emails/mês\\n- **Custo Anual (500 alunos)**: $0 (dentro do limite)\\n- **Latência**: <1 segundo\\n- **Vantagens**:\\n  - 5,000 emails/mês gratuitos\\n  - Excelente deliverability\\n  - Webhooks para tracking\\n  - SMTP integrado\\n- **Implementação**:\\n```typescript\\nimport FormData from 'form-data';\\nimport Mailgun from 'mailgun.js';\\n\\nconst mailgun = new Mailgun(FormData);\\nconst client = mailgun.client({username: 'api', key: 'key-xxx'});\\n\\nawait client.messages.create('school.com', {\\n  from: 'alerts@school.com',\\n  to: 'parent@email.com',\\n  subject: 'Alerta: Aluno Ausente',\\n  text: 'João Silva está ausente há 30 minutos',\\n});\\n```\\n\\n#### ✅ GRATUITO: SendGrid Email API\\n- **Custo**: Gratuito até 100 emails/dia\\n- **Custo Anual (500 alunos)**: $0 (dentro do limite)\\n- **Latência**: <1 segundo\\n- **Vantagens**:\\n  - 100 emails/dia gratuitos\\n  - Ótimo para alertas críticos\\n  - Templates profissionais\\n  - Analytics integrado\\n\\n#### ✅ GRATUITO: Ntfy.sh (Push Notifications)\\n- **Custo**: $0 (open-source)\\n- **Latência**: <100ms\\n- **Vantagens**:\\n  - Self-hosted ou SaaS gratuito\\n  - Push notifications no navegador\\n  - Sem autenticação necessária\\n  - Muito simples de usar\\n- **Implementação**:\\n```bash\\n# Enviar notificação\\ncurl -d \\\"Aluno ausente: João Silva\\\" \\\\\\n  https://ntfy.sh/aquila-alerts\\n\\n# Receber no navegador\\nconst eventSource = new EventSource('https://ntfy.sh/aquila-alerts/sse');\\neventSource.onmessage = (e) => {\\n  console.log(e.data);\\n};\\n```\\n\\n#### ✅ GRATUITO: Telegram Bot API\\n- **Custo**: $0 (completamente gratuito)\\n- **Latência**: <500ms\\n- **Vantagens**:\\n  - Notificações instantâneas\\n  - Sem limite de mensagens\\n  - Integração com grupos\\n  - Botões interativos\\n- **Implementação**:\\n```typescript\\nimport TelegramBot from 'node-telegram-bot-api';\\n\\nconst bot = new TelegramBot('BOT_TOKEN', {polling: true});\\n\\nawait bot.sendMessage(chatId, \\n  '🚨 Alerta: João Silva está ausente há 30 minutos'\\n);\\n```\\n\\n**Comparação de Custos (500 alunos, 2 alertas/dia, 250 dias):**\\n\\n| Solução | Custo Anual | Latência | Tipo | Recomendação |\\n|---------|-----------|----------|------|---------------|\\n| Twilio SMS | $3,650 | 1-3s | SMS | ❌ Caro |\\n| Mailgun Email | $0 | <1s | Email | ✅ Ideal |\\n| SendGrid Email | $0 | <1s | Email | ✅ Ideal |\\n| Ntfy.sh | $0 | <100ms | Push | ✅ Excelente |\\n| Telegram Bot | $0 | <500ms | Chat | ✅ Excelente |\\n\\n**Recomendação**: **Mailgun** (email) + **Telegram Bot** (alertas críticos) = $0/ano\\n\\n---\\n\\n### 3. **Mapas e Geolocalização** (Médio)\\n\\n#### ❌ PAGO: Google Maps API\\n- **Custo**: $7 por 1,000 requisições (Maps, Geocoding, Directions)\\n- **Custo Anual (1,000 requisições/mês)**: ~$840/ano\\n- **Precisão**: Excelente\\n- **Funcionalidades**: Completas\\n\\n#### ✅ GRATUITO: OpenStreetMap + Leaflet\\n- **Custo**: $0 (open-source)\\n- **Latência**: Depende do tile server\\n- **Vantagens**:\\n  - Completamente gratuito\\n  - Dados abertos\\n  - Sem limites de requisições\\n  - Comunidade ativa\\n- **Implementação**:\\n```typescript\\nimport L from 'leaflet';\\n\\nconst map = L.map('map').setView([51.505, -0.09], 13);\\n\\nL.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {\\n  attribution: '© OpenStreetMap contributors',\\n  maxZoom: 19,\\n}).addTo(map);\\n```\\n\\n#### ✅ GRATUITO: Nominatim (Geocoding)\\n- **Custo**: $0 (open-source)\\n- **Latência**: 1-2 segundos\\n- **Vantagens**:\\n  - Geocoding e reverse geocoding\\n  - Sem limites (com rate limiting)\\n  - Dados OpenStreetMap\\n- **Implementação**:\\n```typescript\\nconst response = await fetch(\\n  'https://nominatim.openstreetmap.org/search?q=Rua+A,+São+Paulo&format=json'\\n);\\nconst results = await response.json();\\n```\\n\\n**Recomendação**: **OpenStreetMap + Leaflet** = $0/ano\\n\\n---\\n\\n### 4. **Análise de Dados e BI** (Médio)\\n\\n#### ❌ PAGO: Google Analytics\\n- **Custo**: Gratuito (limitado) ou $150,000+/ano (GA360)\\n- **Funcionalidades**: Limitadas na versão gratuita\\n\\n#### ✅ GRATUITO: Plausible Analytics\\n- **Custo**: Gratuito (open-source self-hosted)\\n- **Vantagens**:\\n  - Privacy-focused\\n  - Sem cookies\\n  - Simples e rápido\\n  - GDPR compliant\\n\\n#### ✅ GRATUITO: Matomo\\n- **Custo**: Gratuito (self-hosted)\\n- **Vantagens**:\\n  - Google Analytics alternativa\\n  - Dados 100% seus\\n  - Sem limites de dados\\n  - Muito customizável\\n\\n**Recomendação**: **Matomo** (self-hosted) = $0/ano\\n\\n---\\n\\n### 5. **Armazenamento de Arquivos** (Alto)\\n\\n#### ❌ PAGO: AWS S3\\n- **Custo**: $0.023 por GB/mês (storage) + transferência\\n- **Custo Anual (500 alunos, 100 fotos cada, 5MB média)**: ~$1,150/ano\\n\\n#### ✅ GRATUITO: MinIO (Self-Hosted S3)\\n- **Custo**: $0 (open-source)\\n- **Vantagens**:\\n  - S3-compatible\\n  - Self-hosted\\n  - Sem limites de armazenamento\\n  - Muito rápido\\n- **Implementação**:\\n```bash\\n# Docker\\ndocker run -d -p 9000:9000 -p 9001:9001 \\\\\\n  -e MINIO_ROOT_USER=minioadmin \\\\\\n  -e MINIO_ROOT_PASSWORD=minioadmin \\\\\\n  minio/minio server /data --console-address \\\":9001\\\"\\n```\\n\\n#### ✅ GRATUITO: Backblaze B2\\n- **Custo**: $0.006 por GB/mês (10x mais barato que AWS)\\n- **Custo Anual (500 alunos)**: ~$290/ano\\n- **Vantagens**:\\n  - Muito barato\\n  - Confiável\\n  - Sem taxa de transferência\\n\\n**Recomendação**: **MinIO** (self-hosted) = $0/ano\\n\\n---\\n\\n## 💰 Resumo de Economia Anual\\n\\n### Cenário: Escola com 500 alunos\\n\\n| Serviço | Solução Paga | Custo Anual | Solução Gratuita | Economia |\\n|---------|------------|-----------|-----------------|----------|\\n| Reconhecimento Facial | OpenAI | $1,250 | face_recognition | $1,250 |\\n| Notificações | Twilio SMS | $3,650 | Mailgun + Telegram | $3,650 |\\n| Mapas | Google Maps | $840 | OpenStreetMap | $840 |\\n| Análise de Dados | GA360 | $150,000 | Matomo | $150,000 |\\n| Armazenamento | AWS S3 | $1,150 | MinIO | $1,150 |\\n| **TOTAL** | | **$156,890** | | **$156,890** |\\n\\n### Custo de Infraestrutura (One-time + Anual)\\n\\n| Item | Custo |\\n|------|-------|\\n| Servidor (GPU para face_recognition) | $3,000-5,000 (one-time) |\\n| Manutenção/Suporte | $500-1,000/ano |\\n| Internet/Hosting | $100-200/mês |\\n| **Total Anual** | **~$2,400-3,600** |\\n\\n**Economia Líquida: $153,290 - $154,490 por ano!**\\n\\n---\\n\\n## 🔧 Implementação no Projeto\\n\\n### Passo 1: Substituir OpenAI por face_recognition\\n\\n**Já implementado!** Usar `face_recognition_module.py` existente.\\n\\n### Passo 2: Adicionar Mailgun para Email\\n\\n```typescript\\n// server/services/NotificationService.ts\\nimport FormData from 'form-data';\\nimport Mailgun from 'mailgun.js';\\n\\nexport class NotificationService {\\n  private mailgun: any;\\n\\n  constructor() {\\n    const mailgun = new Mailgun(FormData);\\n    this.mailgun = mailgun.client({\\n      username: 'api',\\n      key: process.env.MAILGUN_API_KEY,\\n    });\\n  }\\n\\n  async sendAlert(to: string, subject: string, message: string) {\\n    return await this.mailgun.messages.create(\\n      process.env.MAILGUN_DOMAIN,\\n      {\\n        from: `alerts@${process.env.MAILGUN_DOMAIN}`,\\n        to,\\n        subject,\\n        text: message,\\n      }\\n    );\\n  }\\n\\n  async sendStudentAbsentAlert(parentEmail: string, studentName: string, minutesAbsent: number) {\\n    return this.sendAlert(\\n      parentEmail,\\n      `Alerta: ${studentName} está ausente`,\\n      `${studentName} está ausente há ${minutesAbsent} minutos. Por favor, entre em contato com a escola.`\\n    );\\n  }\\n}\\n```\\n\\n### Passo 3: Adicionar Telegram Bot\\n\\n```typescript\\n// server/services/TelegramAlertService.ts\\nimport TelegramBot from 'node-telegram-bot-api';\\n\\nexport class TelegramAlertService {\\n  private bot: TelegramBot;\\n\\n  constructor() {\\n    this.bot = new TelegramBot(process.env.TELEGRAM_BOT_TOKEN, {\\n      polling: false,\\n    });\\n  }\\n\\n  async sendAlert(chatId: string, message: string) {\\n    return await this.bot.sendMessage(chatId, message, {\\n      parse_mode: 'Markdown',\\n    });\\n  }\\n\\n  async sendCriticalAlert(chatId: string, studentName: string) {\\n    return this.sendAlert(\\n      chatId,\\n      `🚨 *ALERTA CRÍTICO*\\\\n\\\\n${studentName} saiu da escola!\\\\n\\\\nAcionar segurança imediatamente.`\\n    );\\n  }\\n}\\n```\\n\\n### Passo 4: Integrar com AlertManager\\n\\n```typescript\\n// Modificar AlertManagerComplete.ts\\nimport { NotificationService } from './NotificationService';\\nimport { TelegramAlertService } from './TelegramAlertService';\\n\\nexport class AlertManagerComplete {\\n  private notificationService: NotificationService;\\n  private telegramService: TelegramAlertService;\\n\\n  async alertStudentLeftSchool(\\n    studentId: string,\\n    studentName: string,\\n    parentEmail: string,\\n    parentTelegramId: string\\n  ) {\\n    // Criar alerta\\n    const alert = await this.createAlert({\\n      type: 'student_left_school',\\n      severity: 'critical',\\n      title: `ALUNO SAIU DA ESCOLA: ${studentName}`,\\n      message: `${studentName} saiu da escola`,\\n      studentId,\\n      studentName,\\n    });\\n\\n    // Enviar email\\n    await this.notificationService.sendStudentAbsentAlert(\\n      parentEmail,\\n      studentName,\\n      0\\n    );\\n\\n    // Enviar Telegram\\n    await this.telegramService.sendCriticalAlert(\\n      parentTelegramId,\\n      studentName\\n    );\\n\\n    return alert;\\n  }\\n}\\n```\\n\\n---\\n\\n## 🎯 Recomendações Finais\\n\\n### ✅ APIs Recomendadas (Gratuitas)\\n\\n1. **face_recognition** - Reconhecimento facial\\n2. **Mailgun** - Email de alertas\\n3. **Telegram Bot** - Alertas críticos em tempo real\\n4. **OpenStreetMap** - Mapas\\n5. **MinIO** - Armazenamento de fotos\\n6. **Matomo** - Analytics\\n\\n### ❌ APIs a Evitar\\n\\n1. ❌ OpenAI Vision (caro)\\n2. ❌ Twilio SMS (caro para volume)\\n3. ❌ Google Maps (caro)\\n4. ❌ AWS S3 (caro para storage)\\n5. ❌ Google Analytics 360 (muito caro)\\n\\n### 💡 Economia Total\\n\\n- **Sem otimizações**: $156,890/ano\\n- **Com APIs gratuitas**: $2,400-3,600/ano\\n- **Economia**: **97.5% de redução de custos!**\\n\\n---\\n\\n## 📚 Recursos Adicionais\\n\\n- [CompreFace GitHub](https://github.com/exadel-inc/CompreFace)\\n- [face_recognition Documentation](https://github.com/ageitgey/face_recognition)\\n- [Mailgun Documentation](https://documentation.mailgun.com/)\\n- [Telegram Bot API](https://core.telegram.org/bots/api)\\n- [OpenStreetMap](https://www.openstreetmap.org/)\\n- [MinIO Documentation](https://docs.min.io/)\\n- [Matomo Documentation](https://matomo.org/docs/)\\n":[1,2]},"outlinks":[{"title":"Telegram Bot API","target":"https://core.telegram.org/bots/api","line":1},{"title":"MinIO Documentation","target":"https://docs.min.io/","line":1},{"title":"Mailgun Documentation","target":"https://documentation.mailgun.com/","line":1},{"title":"face_recognition Documentation","target":"https://github.com/ageitgey/face_recognition","line":1},{"title":"CompreFace GitHub","target":"https://github.com/exadel-inc/CompreFace","line":1},{"title":"Matomo Documentation","target":"https://matomo.org/docs/","line":1},{"title":"OpenStreetMap","target":"https://www.openstreetmap.org/","line":1}],"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"hev66r","at":1774580780009}},"smart_blocks:docs/FREE_APIS_ANALYSIS.md#💰 Análise de APIs Gratuitas para Áquila Pro\\n\\n## 📋 Visão Geral\\n\\nEste documento analisa **APIs gratuitas e open-source** que podem substituir serviços pagos no Áquila Pro, reduzindo significativamente os custos de operação para escolas.\\n\\n---\\n\\n## 🎯 Categorias de APIs Necessárias\\n\\n### 1. **Reconhecimento Facial** (Crítico)\\n\\n#### ❌ PAGO: OpenAI Vision API\\n- **Custo**: $0.01 por imagem (Vision API)\\n- **Limite**: Sem limite oficial, mas caro em escala\\n- **Latência**: 2-5 segundos\\n- **Precisão**: 95%+\\n- **Custo Anual (500 alunos, 250 dias)**: ~$1,250\\n\\n#### ✅ GRATUITO: CompreFace (Open-Source)\\n- **Custo**: $0 (self-hosted)\\n- **Requisitos**: Docker, GPU recomendada\\n- **Latência**: 100-500ms (com GPU)\\n- **Precisão**: 95%+ (comparável ao OpenAI)\\n- **Vantagens**:\\n  - Totalmente open-source\\n  - Self-hosted (dados privados)\\n  - Sem limites de requisições\\n  - Suporta múltiplos modelos\\n  - Integração com Docker\\n- **Desvantagens**:\\n  - Requer infraestrutura própria\\n  - Precisa de GPU para performance\\n\\n**Implementação**:\\n```bash\\n# Docker Compose\\ndocker run -d -p 8000:8000 exadel/compreface:latest\\n\\n# API Usage\\ncurl -X POST http://localhost:8000/api/v1/recognition/recognize \\\\\\n  -F \\\"file=@photo.jpg\\\" \\\\\\n  -F \\\"det_prob_threshold=0.8\\\"\\n```\\n\\n#### ✅ GRATUITO: face_recognition (Python Library)\\n- **Custo**: $0 (pip install)\\n- **Latência**: 50-200ms (CPU), 10-50ms (GPU)\\n- **Precisão**: 99.38% (dlib-based)\\n- **Vantagens**:\\n  - Extremamente rápido\\n  - Sem dependências externas\\n  - Já implementado no projeto\\n  - Melhor para edge computing\\n- **Desvantagens**:\\n  - Requer processamento local\\n  - Menos robusto em ângulos extremos\\n\\n#### ✅ GRATUITO: DeepFace (Python Library)\\n- **Custo**: $0 (pip install)\\n- **Latência**: 100-300ms (CPU)\\n- **Precisão**: 98%+\\n- **Vantagens**:\\n  - Múltiplos backends (VGGFace, FaceNet, ArcFace)\\n  - Detecção de emoções\\n  - Análise de idade/gênero\\n  - Muito flexível\\n\\n**Comparação de Custos (500 alunos, 250 dias):**\\n\\n| Solução | Custo Anual | Latência | Precisão | Recomendação |\\n|---------|-----------|----------|----------|---------------|\\n| OpenAI Vision | $1,250 | 2-5s | 95% | ❌ Caro |\\n| CompreFace | $0 (+GPU) | 100-500ms | 95% | ✅ Melhor |\\n| face_recognition | $0 | 50-200ms | 99% | ✅ Ideal |\\n| DeepFace | $0 | 100-300ms | 98% | ✅ Alternativa |\\n\\n**Recomendação**: **face_recognition** (já implementado) + **CompreFace** como backup\\n\\n---\\n\\n### 2. **Notificações e Alertas** (Alto)\\n\\n#### ❌ PAGO: Twilio SMS\\n- **Custo**: $0.0075 por SMS (Brasil ~R$0.03)\\n- **Custo Anual (500 alunos, 2 alertas/dia)**: ~$3,650/ano\\n- **Latência**: 1-3 segundos\\n- **Confiabilidade**: 99.9%\\n\\n#### ✅ GRATUITO: Mailgun Email API\\n- **Custo**: Gratuito até 5,000 emails/mês\\n- **Custo Anual (500 alunos)**: $0 (dentro do limite)\\n- **Latência**: <1 segundo\\n- **Vantagens**:\\n  - 5,000 emails/mês gratuitos\\n  - Excelente deliverability\\n  - Webhooks para tracking\\n  - SMTP integrado\\n- **Implementação**:\\n```typescript\\nimport FormData from 'form-data';\\nimport Mailgun from 'mailgun.js';\\n\\nconst mailgun = new Mailgun(FormData);\\nconst client = mailgun.client({username: 'api', key: 'key-xxx'});\\n\\nawait client.messages.create('school.com', {\\n  from: 'alerts@school.com',\\n  to: 'parent@email.com',\\n  subject: 'Alerta: Aluno Ausente',\\n  text: 'João Silva está ausente há 30 minutos',\\n});\\n```\\n\\n#### ✅ GRATUITO: SendGrid Email API\\n- **Custo**: Gratuito até 100 emails/dia\\n- **Custo Anual (500 alunos)**: $0 (dentro do limite)\\n- **Latência**: <1 segundo\\n- **Vantagens**:\\n  - 100 emails/dia gratuitos\\n  - Ótimo para alertas críticos\\n  - Templates profissionais\\n  - Analytics integrado\\n\\n#### ✅ GRATUITO: Ntfy.sh (Push Notifications)\\n- **Custo**: $0 (open-source)\\n- **Latência**: <100ms\\n- **Vantagens**:\\n  - Self-hosted ou SaaS gratuito\\n  - Push notifications no navegador\\n  - Sem autenticação necessária\\n  - Muito simples de usar\\n- **Implementação**:\\n```bash\\n# Enviar notificação\\ncurl -d \\\"Aluno ausente: João Silva\\\" \\\\\\n  https://ntfy.sh/aquila-alerts\\n\\n# Receber no navegador\\nconst eventSource = new EventSource('https://ntfy.sh/aquila-alerts/sse');\\neventSource.onmessage = (e) => {\\n  console.log(e.data);\\n};\\n```\\n\\n#### ✅ GRATUITO: Telegram Bot API\\n- **Custo**: $0 (completamente gratuito)\\n- **Latência**: <500ms\\n- **Vantagens**:\\n  - Notificações instantâneas\\n  - Sem limite de mensagens\\n  - Integração com grupos\\n  - Botões interativos\\n- **Implementação**:\\n```typescript\\nimport TelegramBot from 'node-telegram-bot-api';\\n\\nconst bot = new TelegramBot('BOT_TOKEN', {polling: true});\\n\\nawait bot.sendMessage(chatId, \\n  '🚨 Alerta: João Silva está ausente há 30 minutos'\\n);\\n```\\n\\n**Comparação de Custos (500 alunos, 2 alertas/dia, 250 dias):**\\n\\n| Solução | Custo Anual | Latência | Tipo | Recomendação |\\n|---------|-----------|----------|------|---------------|\\n| Twilio SMS | $3,650 | 1-3s | SMS | ❌ Caro |\\n| Mailgun Email | $0 | <1s | Email | ✅ Ideal |\\n| SendGrid Email | $0 | <1s | Email | ✅ Ideal |\\n| Ntfy.sh | $0 | <100ms | Push | ✅ Excelente |\\n| Telegram Bot | $0 | <500ms | Chat | ✅ Excelente |\\n\\n**Recomendação**: **Mailgun** (email) + **Telegram Bot** (alertas críticos) = $0/ano\\n\\n---\\n\\n### 3. **Mapas e Geolocalização** (Médio)\\n\\n#### ❌ PAGO: Google Maps API\\n- **Custo**: $7 por 1,000 requisições (Maps, Geocoding, Directions)\\n- **Custo Anual (1,000 requisições/mês)**: ~$840/ano\\n- **Precisão**: Excelente\\n- **Funcionalidades**: Completas\\n\\n#### ✅ GRATUITO: OpenStreetMap + Leaflet\\n- **Custo**: $0 (open-source)\\n- **Latência**: Depende do tile server\\n- **Vantagens**:\\n  - Completamente gratuito\\n  - Dados abertos\\n  - Sem limites de requisições\\n  - Comunidade ativa\\n- **Implementação**:\\n```typescript\\nimport L from 'leaflet';\\n\\nconst map = L.map('map').setView([51.505, -0.09], 13);\\n\\nL.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {\\n  attribution: '© OpenStreetMap contributors',\\n  maxZoom: 19,\\n}).addTo(map);\\n```\\n\\n#### ✅ GRATUITO: Nominatim (Geocoding)\\n- **Custo**: $0 (open-source)\\n- **Latência**: 1-2 segundos\\n- **Vantagens**:\\n  - Geocoding e reverse geocoding\\n  - Sem limites (com rate limiting)\\n  - Dados OpenStreetMap\\n- **Implementação**:\\n```typescript\\nconst response = await fetch(\\n  'https://nominatim.openstreetmap.org/search?q=Rua+A,+São+Paulo&format=json'\\n);\\nconst results = await response.json();\\n```\\n\\n**Recomendação**: **OpenStreetMap + Leaflet** = $0/ano\\n\\n---\\n\\n### 4. **Análise de Dados e BI** (Médio)\\n\\n#### ❌ PAGO: Google Analytics\\n- **Custo**: Gratuito (limitado) ou $150,000+/ano (GA360)\\n- **Funcionalidades**: Limitadas na versão gratuita\\n\\n#### ✅ GRATUITO: Plausible Analytics\\n- **Custo**: Gratuito (open-source self-hosted)\\n- **Vantagens**:\\n  - Privacy-focused\\n  - Sem cookies\\n  - Simples e rápido\\n  - GDPR compliant\\n\\n#### ✅ GRATUITO: Matomo\\n- **Custo**: Gratuito (self-hosted)\\n- **Vantagens**:\\n  - Google Analytics alternativa\\n  - Dados 100% seus\\n  - Sem limites de dados\\n  - Muito customizável\\n\\n**Recomendação**: **Matomo** (self-hosted) = $0/ano\\n\\n---\\n\\n### 5. **Armazenamento de Arquivos** (Alto)\\n\\n#### ❌ PAGO: AWS S3\\n- **Custo**: $0.023 por GB/mês (storage) + transferência\\n- **Custo Anual (500 alunos, 100 fotos cada, 5MB média)**: ~$1,150/ano\\n\\n#### ✅ GRATUITO: MinIO (Self-Hosted S3)\\n- **Custo**: $0 (open-source)\\n- **Vantagens**:\\n  - S3-compatible\\n  - Self-hosted\\n  - Sem limites de armazenamento\\n  - Muito rápido\\n- **Implementação**:\\n```bash\\n# Docker\\ndocker run -d -p 9000:9000 -p 9001:9001 \\\\\\n  -e MINIO_ROOT_USER=minioadmin \\\\\\n  -e MINIO_ROOT_PASSWORD=minioadmin \\\\\\n  minio/minio server /data --console-address \\\":9001\\\"\\n```\\n\\n#### ✅ GRATUITO: Backblaze B2\\n- **Custo**: $0.006 por GB/mês (10x mais barato que AWS)\\n- **Custo Anual (500 alunos)**: ~$290/ano\\n- **Vantagens**:\\n  - Muito barato\\n  - Confiável\\n  - Sem taxa de transferência\\n\\n**Recomendação**: **MinIO** (self-hosted) = $0/ano\\n\\n---\\n\\n## 💰 Resumo de Economia Anual\\n\\n### Cenário: Escola com 500 alunos\\n\\n| Serviço | Solução Paga | Custo Anual | Solução Gratuita | Economia |\\n|---------|------------|-----------|-----------------|----------|\\n| Reconhecimento Facial | OpenAI | $1,250 | face_recognition | $1,250 |\\n| Notificações | Twilio SMS | $3,650 | Mailgun + Telegram | $3,650 |\\n| Mapas | Google Maps | $840 | OpenStreetMap | $840 |\\n| Análise de Dados | GA360 | $150,000 | Matomo | $150,000 |\\n| Armazenamento | AWS S3 | $1,150 | MinIO | $1,150 |\\n| **TOTAL** | | **$156,890** | | **$156,890** |\\n\\n### Custo de Infraestrutura (One-time + Anual)\\n\\n| Item | Custo |\\n|------|-------|\\n| Servidor (GPU para face_recognition) | $3,000-5,000 (one-time) |\\n| Manutenção/Suporte | $500-1,000/ano |\\n| Internet/Hosting | $100-200/mês |\\n| **Total Anual** | **~$2,400-3,600** |\\n\\n**Economia Líquida: $153,290 - $154,490 por ano!**\\n\\n---\\n\\n## 🔧 Implementação no Projeto\\n\\n### Passo 1: Substituir OpenAI por face_recognition\\n\\n**Já implementado!** Usar `face_recognition_module.py` existente.\\n\\n### Passo 2: Adicionar Mailgun para Email\\n\\n```typescript\\n// server/services/NotificationService.ts\\nimport FormData from 'form-data';\\nimport Mailgun from 'mailgun.js';\\n\\nexport class NotificationService {\\n  private mailgun: any;\\n\\n  constructor() {\\n    const mailgun = new Mailgun(FormData);\\n    this.mailgun = mailgun.client({\\n      username: 'api',\\n      key: process.env.MAILGUN_API_KEY,\\n    });\\n  }\\n\\n  async sendAlert(to: string, subject: string, message: string) {\\n    return await this.mailgun.messages.create(\\n      process.env.MAILGUN_DOMAIN,\\n      {\\n        from: `alerts@${process.env.MAILGUN_DOMAIN}`,\\n        to,\\n        subject,\\n        text: message,\\n      }\\n    );\\n  }\\n\\n  async sendStudentAbsentAlert(parentEmail: string, studentName: string, minutesAbsent: number) {\\n    return this.sendAlert(\\n      parentEmail,\\n      `Alerta: ${studentName} está ausente`,\\n      `${studentName} está ausente há ${minutesAbsent} minutos. Por favor, entre em contato com a escola.`\\n    );\\n  }\\n}\\n```\\n\\n### Passo 3: Adicionar Telegram Bot\\n\\n```typescript\\n// server/services/TelegramAlertService.ts\\nimport TelegramBot from 'node-telegram-bot-api';\\n\\nexport class TelegramAlertService {\\n  private bot: TelegramBot;\\n\\n  constructor() {\\n    this.bot = new TelegramBot(process.env.TELEGRAM_BOT_TOKEN, {\\n      polling: false,\\n    });\\n  }\\n\\n  async sendAlert(chatId: string, message: string) {\\n    return await this.bot.sendMessage(chatId, message, {\\n      parse_mode: 'Markdown',\\n    });\\n  }\\n\\n  async sendCriticalAlert(chatId: string, studentName: string) {\\n    return this.sendAlert(\\n      chatId,\\n      `🚨 *ALERTA CRÍTICO*\\\\n\\\\n${studentName} saiu da escola!\\\\n\\\\nAcionar segurança imediatamente.`\\n    );\\n  }\\n}\\n```\\n\\n### Passo 4: Integrar com AlertManager\\n\\n```typescript\\n// Modificar AlertManagerComplete.ts\\nimport { NotificationService } from './NotificationService';\\nimport { TelegramAlertService } from './TelegramAlertService';\\n\\nexport class AlertManagerComplete {\\n  private notificationService: NotificationService;\\n  private telegramService: TelegramAlertService;\\n\\n  async alertStudentLeftSchool(\\n    studentId: string,\\n    studentName: string,\\n    parentEmail: string,\\n    parentTelegramId: string\\n  ) {\\n    // Criar alerta\\n    const alert = await this.createAlert({\\n      type: 'student_left_school',\\n      severity: 'critical',\\n      title: `ALUNO SAIU DA ESCOLA: ${studentName}`,\\n      message: `${studentName} saiu da escola`,\\n      studentId,\\n      studentName,\\n    });\\n\\n    // Enviar email\\n    await this.notificationService.sendStudentAbsentAlert(\\n      parentEmail,\\n      studentName,\\n      0\\n    );\\n\\n    // Enviar Telegram\\n    await this.telegramService.sendCriticalAlert(\\n      parentTelegramId,\\n      studentName\\n    );\\n\\n    return alert;\\n  }\\n}\\n```\\n\\n---\\n\\n## 🎯 Recomendações Finais\\n\\n### ✅ APIs Recomendadas (Gratuitas)\\n\\n1. **face_recognition** - Reconhecimento facial\\n2. **Mailgun** - Email de alertas\\n3. **Telegram Bot** - Alertas críticos em tempo real\\n4. **OpenStreetMap** - Mapas\\n5. **MinIO** - Armazenamento de fotos\\n6. **Matomo** - Analytics\\n\\n### ❌ APIs a Evitar\\n\\n1. ❌ OpenAI Vision (caro)\\n2. ❌ Twilio SMS (caro para volume)\\n3. ❌ Google Maps (caro)\\n4. ❌ AWS S3 (caro para storage)\\n5. ❌ Google Analytics 360 (muito caro)\\n\\n### 💡 Economia Total\\n\\n- **Sem otimizações**: $156,890/ano\\n- **Com APIs gratuitas**: $2,400-3,600/ano\\n- **Economia**: **97.5% de redução de custos!**\\n\\n---\\n\\n## 📚 Recursos Adicionais\\n\\n- [CompreFace GitHub](https://github.com/exadel-inc/CompreFace)\\n- [face_recognition Documentation](https://github.com/ageitgey/face_recognition)\\n- [Mailgun Documentation](https://documentation.mailgun.com/)\\n- [Telegram Bot API](https://core.telegram.org/bots/api)\\n- [OpenStreetMap](https://www.openstreetmap.org/)\\n- [MinIO Documentation](https://docs.min.io/)\\n- [Matomo Documentation](https://matomo.org/docs/)\\n": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[0.00413036,-0.00450249,-0.01600496,-0.0204004,0.03339497,-0.0272717,-0.01788563,0.01360029,0.04763404,0.02855517,-0.02548729,-0.09084906,-0.0122673,0.05737874,-0.00121278,-0.05923707,0.04574973,-0.00836909,-0.01500932,0.00673764,0.10197727,-0.06730349,-0.04945508,-0.08186648,-0.05736849,0.0797781,-0.02939355,-0.02901866,0.01714854,-0.2039144,-0.01967446,-0.02578384,0.02968515,-0.0088291,-0.00834295,0.02905203,-0.02669292,0.01273793,-0.02332909,0.04038981,0.02508271,0.01567335,-0.04952204,0.01422093,-0.00980935,-0.01939915,-0.02933509,0.02523406,-0.06247569,-0.00555999,-0.04810672,-0.03906715,-0.00119594,0.00076258,-0.03389371,0.00925509,0.0308727,0.02802781,-0.00307213,0.04904005,0.07063357,0.02858429,-0.22684564,0.03285712,0.00131241,0.06437405,-0.05556749,0.01769523,-0.01616121,-0.05018466,0.01399327,0.02314804,0.03490634,-0.01124358,0.04672547,0.0454868,0.01595914,-0.02082868,0.01057456,0.02637494,0.01896101,0.04820648,-0.02036662,-0.00061188,0.00035488,-0.04888294,0.00826913,-0.01101532,0.06276105,-0.03964353,-0.0624522,-0.04002909,0.05079525,0.027178,0.01703566,0.00092502,0.03667805,0.03902689,-0.04510524,0.10967154,-0.0035442,-0.01529458,0.03905036,-0.02610106,0.04823979,-0.02410908,0.03387377,-0.07165451,-0.00552125,0.05649622,-0.03010471,0.0083845,0.06017865,-0.03147462,-0.04228985,-0.02232992,0.0030027,-0.00819399,0.05335705,-0.01