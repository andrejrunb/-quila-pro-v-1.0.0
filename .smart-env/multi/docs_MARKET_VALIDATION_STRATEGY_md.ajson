
"smart_sources:docs/MARKET_VALIDATION_STRATEGY.md": {"path":"docs/MARKET_VALIDATION_STRATEGY.md","embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.06802583,0.02828255,-0.00652183,-0.04402444,0.02267101,0.04095035,-0.0235939,0.07794549,0.03942737,0.01006555,-0.03256533,-0.08520029,-0.04009782,0.03948409,0.01599457,-0.03487675,0.0295106,-0.03216189,0.01677299,0.01943671,0.08446524,-0.0076079,-0.03490429,-0.02246831,0.02534322,0.03670549,0.01756226,-0.05304145,-0.07912616,-0.2305932,0.00151462,-0.07279801,0.04334292,-0.01969977,-0.02039613,0.00840862,-0.0544591,0.00624664,-0.01993917,0.04018044,-0.01277456,0.01134314,-0.0407129,-0.01269267,-0.04958116,-0.07991838,0.00785999,0.01831747,-0.02084953,-0.00376901,-0.07134929,-0.01818617,0.0019212,0.00680224,-0.01892097,0.03891134,0.01465918,0.02071126,0.05753325,0.05101236,0.08655158,0.08375049,-0.2699151,0.00383966,-0.02909128,0.02896021,-0.04055744,0.04472133,-0.08525589,0.05179771,0.03142295,-0.04311331,0.0840646,0.03278854,0.07721632,0.05712875,0.01032662,-0.03535103,0.04039026,0.00921053,0.0157262,0.05993553,-0.0250463,-0.05710984,-0.02312592,-0.01329238,0.05356985,0.01819601,0.05799322,-0.00571312,0.01637531,0.01866232,0.00688605,0.02049494,-0.0383538,-0.03928703,0.00385232,-0.01505635,-0.09542587,0.06202497,0.02342765,0.02900653,-0.02036436,-0.06616899,0.02931516,-0.03777867,0.02243665,-0.04522812,-0.01195861,0.0315293,0.00154655,-0.00166986,0.03425611,-0.04253876,-0.03152258,0.06850287,0.01095724,0.00123201,0.03350187,-0.07123102,-0.02389206,-0.00940285,0.09826877,0.01157475,0.00983475,-0.09061793,0.05208267,0.07574854,-0.02476922,0.10232997,0.01802478,0.00382713,-0.0887798,-0.00206443,-0.02855093,-0.01861449,0.01711803,0.01240196,0.02985542,0.03525317,-0.11366424,-0.0381738,0.02404127,-0.09856235,-0.07158925,0.06836122,0.01244844,0.03310196,-0.00999114,-0.00516609,-0.01436604,0.03000671,-0.04225194,0.01874882,0.00856304,-0.03793006,0.03738067,0.05631113,-0.04156275,-0.02880464,-0.03614778,0.00615544,-0.03136906,0.1