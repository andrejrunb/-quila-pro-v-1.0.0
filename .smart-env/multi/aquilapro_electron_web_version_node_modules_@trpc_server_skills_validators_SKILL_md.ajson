#tRPC -- Validators#See Also#{3}":[227,227],"#tRPC -- Validators#See Also#{4}":[228,229]},"outlinks":[],"metadata":{"name":"validators","description":"Configure input and output validation with .input() and .output() using Zod, Yup, Superstruct, ArkType, Valibot, Effect, or custom validator functions. Chain multiple .input() calls to merge object schemas. Standard Schema protocol support. Output validation returns INTERNAL_SERVER_ERROR on failure.\n","type":"core","library":"trpc","library_version":"11.14.0","requires":["server-setup"],"sources":["trpc/trpc:www/docs/server/validators.md","trpc/trpc:packages/server/src/unstable-core-do-not-import/parser.ts"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[22,30],[32,47],[53,67],[71,91],[97,108],[114,133],[141,146],[150,157],[167,174],[178,185],[195,204],[208,217]]},