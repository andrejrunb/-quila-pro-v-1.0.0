
"smart_sources:skills/antigravity-awesome-skills/hig-inputs/references/focus-and-selection.md": {"path":"skills/antigravity-awesome-skills/hig-inputs/references/focus-and-selection.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"eq47hx","at":1774580040137},"class_name":"SmartSource","last_import":{"mtime":1774321842265,"size":16364,"at":1774580040287,"hash":"eq47hx"},"blocks":{"#---frontmatter---":[1,null]},"outlinks":[{"title":"A sketch of a frame around a circular interface element, suggesting locking focus on an object. The image is overlaid with rectangular and circular grid lines and is tinted purple to subtly reflect the purple in the original six-color Apple logo.","target":"https://docs-assets.developer.apple.com/published/13b5befef4936f31ce74db6aa05b7a0e/inputs-focus-and-selection-intro%402x.png","line":9,"embedded":true},{"title":"parallax effect","target":"https://developer.apple.com/design/human-interface-guidelines/images#Parallax-effect","line":15},{"title":"Best practices","target":"https://developer.apple.com/design/human-interface-guidelines/focus-and-selection#Best-practices","line":17},{"title":"`NSTableView`","target":"https://developer.apple.com/documentation/AppKit/NSTableView","line":25},{"title":"`UICollectionView`","target":"https://developer.apple.com/documentation/UIKit/UICollectionView","line":25},{"title":"Platform considerations","target":"https://developer.apple.com/design/human-interface-guidelines/focus-and-selection#Platform-considerations","line":29},{"title":"iPadOS","target":"https://developer.apple.com/design/human-interface-guidelines/focus-and-selection#iPadOS","line":33},{"title":"tvOS","target":"https://developer.apple.com/design/human-interface-guidelines/focus-and-selection#tvOS","line":37},{"title":"An illustration of a collection view of photos showing the standard halo effect that outlines the focused photo.","target":"https://docs-assets.developer.apple.com/published/2bfe6fedc5a6a8ecf6d7e74e9492a096/focus-and-selection-halo-focus-effect%402x.png","line":50,"embedded":true},{"title":"`UIFocusHaloEffect`","target":"https://developer.apple.com/documentation/UIKit/UIFocusHaloEffect","line":52},{"title":"An illustration of a collection view of photos showing a rounded-rectangle halo effect that outlines the focused photo.","target":"https://docs-assets.developer.apple.com/published/1a84f872d0624355e89fa03b357ddd13/focus-and-selection-customized-halo%402x.png","line":54,"embedded":true},{"title":"`UICollectionViewCell`","target":"https://developer.apple.com/documentation/UIKit/UICollectionViewCell","line":56},{"title":"An illustration of a list of menu items with the second item highlighted. The item's title and icon are tinted with a red accent color.","target":"https://docs-assets.developer.apple.com/published/01261865c38379fa118f16057a54f23e/focus-and-selection-highlighted-appearance%402x.png","line":58,"embedded":true},{"title":"`focusGroupIdentifier`","target":"https://developer.apple.com/documentation/UIKit/UIFocusEnvironment/focusGroupIdentifier","line":60},{"title":"`UIFocusGroupPriority`","target":"https://developer.apple.com/documentation/UIKit/UIFocusGroupPriority","line":62},{"title":"tvOS","target":"https://developer.apple.com/design/human-interface-guidelines/focus-and-selection#tvOS","line":64},{"title":"An image of an unfocused button on top of a photograph. A small drop shadow makes it appear very close to the content behind it, with a translucent background infused by the colors of the content, and a high-contrast text color.","target":"https://docs-assets.developer.apple.com/published/bfc53c88dc7a84a9ca45d43d8f7fb550/focus-and-selection-state-unfocused%402x.png","line":74,"embedded":true},{"title":"An image of a focused button on top of a photograph. It’s larger than an unfocused button, and a drop shadow makes it appear farther away from the content behind it, with an opaque white background and a black text label.","target":"https://docs-assets.developer.apple.com/published/882b1286aa16b7a8d4a6367778a984b9/focus-and-selection-state-focused%402x.png","line":75,"embedded":true},{"title":"An image of a highlighted button on top of a photograph. It’s the same size as an unfocused button, and a drop shadow makes it appear a little farther away from the surface of the content behind it, with an opaque white background and a black text label.","target":"https://docs-assets.developer.apple.com/published/d5388fe044717ba970895f33bdbebe3c/focus-and-selection-state-highlighted%402x.png","line":76,"embedded":true},{"title":"An image of a selected button on top of a photograph. It’s the same size as an unfocused button, and a small drop shadow makes it appear very close to the content behind it, with an opaque white background and a black text label.","target":"https://docs-assets.developer.apple.com/published/ea6520ec5576b19ad7952c35a28c2dfc/focus-and-selection-state-selected%402x.png","line":77,"embedded":true},{"title":"An image of an unavailable button on top of a photograph. It’s the same size as an unfocused button. It lacks a drop shadow and appears to rest directly on the content behind it, with a translucent background tinted by the the colors of nearby content, and a low-contrast text color.","target":"https://docs-assets.developer.apple.com/published/c1d9c327cbefe45ef0aeef12b93b956c/focus-and-selection-state-unavailable%402x.png","line":78,"embedded":true},{"title":"Adding user-focusable elements to a tvOS app","target":"https://developer.apple.com/documentation/UIKit/adding-user-focusable-elements-to-a-tvos-app","line":80},{"title":"visionOS","target":"https://developer.apple.com/design/human-interface-guidelines/focus-and-selection#visionOS","line":82},{"title":"Eyes","target":"https://developer.apple.com/design/human-interface-guidelines/eyes","line":88},{"title":"Resources","target":"https://developer.apple.com/design/human-interface-guidelines/focus-and-selection#Resources","line":90},{"title":"Related"