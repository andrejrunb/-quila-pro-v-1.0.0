
"smart_sources:skills/antigravity-awesome-skills/hig-foundations/references/color.md": {"path":"skills/antigravity-awesome-skills/hig-foundations/references/color.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"mu8qbx","at":1774580040113},"class_name":"SmartSource","last_import":{"mtime":1774321842235,"size":45867,"at":1774580040287,"hash":"mu8qbx"},"blocks":{"#---frontmatter---":[1,null]},"outlinks":[{"title":"A sketch of a paint palette, suggesting the use of color. The image is overlaid with rectangular and circular grid lines and is tinted yellow to subtly reflect the yellow in the original six-color Apple logo.","target":"https://docs-assets.developer.apple.com/published/10ec5551985c77cabaeaaaff016cdfd8/foundations-color-intro%402x.png","line":9,"embedded":true},{"title":"Best practices","target":"https://developer.apple.com/design/human-interface-guidelines/color#Best-practices","line":15},{"title":"System colors","target":"https://developer.apple.com/design/human-interface-guidelines/color#System-colors","line":19},{"title":"dark","target":"https://developer.apple.com/design/human-interface-guidelines/dark-mode","line":19},{"title":"A screenshot of the Notes app in iOS with the light system appearance and default contrast. The Notes app is open to a note with the text 'Note'. The text is selected, which shows a yellow selection highlight and text editing menu. The Done button appears in the upper-right corner. The Liquid Glass background of the button is yellow, and its label, which shows a checkmark, is white. The shade of yellow is vibrant.","target":"https://docs-assets.developer.apple.com/published/033f3f6540cc36385bc5993e2152895b/color-context-light-mode%402x.png","line":21,"embedded":true},{"title":"A screenshot of the Notes app in iOS with the light system appearance and increased contrast. The Notes app is open to a note with the text 'Note'. The text is selected, which shows a yellow selection highlight and text editing menu. The Done button appears in the upper-right corner. The Liquid Glass background of the button is yellow, and its label, which shows a checkmark, is black. The shade of yellow is darker to provide more contrast and differentiation against the note's white background.","target":"https://docs-assets.developer.apple.com/published/9fa4e239f30421b0f00ee77dcace0c14/color-context-light-mode-high-contrast%402x.png","line":25,"embedded":true},{"title":"A screenshot of the Notes app in iOS with the dark system appearance and default contrast. The Notes app is open to a note with the text 'Note'. The text is selected, which shows a yellow selection highlight and text editing menu. The Done button appears in the upper-right corner. The Liquid Glass background of the button is yellow, and its label, which shows a checkmark, is white.","target":"https://docs-assets.developer.apple.com/published/dc3523da3cba1dd53d3501c763335e6c/color-context-dark-mode%402x.png","line":29,"embedded":true},{"title":"A screenshot of the Notes app in iOS with the dark system appearance and increased contrast. The Notes app is open to a note with the text 'Note'. The text is selected, which shows a yellow selection highlight and text editing menu. The Done button appears in the upper-right corner. The Liquid Glass background of the button is yellow, and its label, which shows a checkmark, is black.","target":"https://docs-assets.developer.apple.com/published/95af2bc7dece914a5f870f38edac2998/color-context-dark-mode-high-contrast%402x.png","line":33,"embedded":true},{"title":"Color management","target":"https://developer.apple.com/design/human-interface-guidelines/color#Color-management","line":39},{"title":"`UIWhitePointAdaptivityStyle`","target":"https://developer.apple.com/documentation/BundleResources/Information-Property-List/UIWhitePointAdaptivityStyle","line":39},{"title":"`ColorPicker`","target":"https://developer.apple.com/documentation/SwiftUI/ColorPicker","line":43},{"title":"Inclusive color","target":"https://developer.apple.com/design/human-interface-guidelines/color#Inclusive-color","line":45},{"title":"Accessibility","target":"https://developer.apple.com/design/human-interface-guidelines/accessibility","line":49},{"title":"An illustration of an upward-trending stock chart in the Stocks app in English. The line of the graph is green to indicate the rising value of the stock during the selected time period.","target":"https://docs-assets.developer.apple.com/published/5969ae10a6eaca6879fb43df4f651e4d/color-inclusive-color-charts-english%402x.png","line":53,"embedded":true},{"title":"An illustration of an upward-trending stock chart in the Stocks app in Chinese. The line of the graph is red to indicate the rising value of the stock during the selected time period.","target":"https://docs-assets.developer.apple.com/published/e84b6e7089f1fb8f73712da462d66164/color-inclusive-color-charts-chinese%402x.png","line":55,"embedded":true},{"title":"System colors","target":"https://developer.apple.com/design/human-interface-guidelines/color#System-colors","line":57},{"title":"`Color`","target":"https://developer.apple.com/documentation/SwiftUI/Color","line":59},{"title":"secondary text label","target":"https://developer.apple.com/documentation/uikit/uicolor/secondarylabel","line":63},{"title":"separator","target":"https://developer.apple.com/documentation/uikit/uicolor/separator","line":63},{"title":"Liquid Glass color","target":"https://developer.apple.com/design/human-interface-guidelines/color#Liquid-Glass-color","line":65},{"title":"Liquid Glass","target":"https://developer.apple.com/design/human-interface-guidelines/materials#Liquid-Glass","line":67},{"title":"A screenshot of the Done button in iOS, which appears as a checkmark on a blue Liquid Glass background.","target":"https://docs-assets.developer.apple.com/published/df4d0a0bca32edb16d7ff86e34d6fe2d/color-liquid-glass-overview-tinted%402x.png","line":69,"embedded":true},{"title":"A screenshot of a tab bar in i