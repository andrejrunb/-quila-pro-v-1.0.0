
"smart_sources:docs/FACE_RECOGNITION_INTEGRATION.md": {"path":"docs/FACE_RECOGNITION_INTEGRATION.md","embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.04681971,-0.00729512,0.0155278,0.00891108,-0.02241754,-0.01210142,0.04186345,-0.01436198,0.03473542,0.01918141,0.02936071,-0.1191426,-0.00539995,0.02320963,0.06436747,-0.00519268,0.0317339,0.09181827,-0.05614326,-0.0325169,0.02364662,-0.0257199,-0.02370783,-0.02811824,-0.00590349,0.04207529,0.01679279,-0.02539028,0.00363332,-0.23402871,0.0307692,-0.0377361,0.03088402,0.00835383,0.02609989,-0.01112491,-0.06914375,0.01176179,-0.04733723,-0.00278883,-0.0068079,0.02127138,-0.04801679,-0.02007876,-0.01468566,-0.04786718,-0.02714173,0.01912172,-0.05385515,-0.00191429,-0.0108189,-0.05341051,0.01860037,0.05362413,-0.06429899,0.08807112,0.06515858,0.05760671,0.08764217,0.05650716,0.05853968,0.05064564,-0.17341742,0.05683846,-0.03226425,0.04553982,-0.04036392,-0.04766336,0.02978177,-0.00408643,-0.02252065,-0.02115611,0.03588491,-0.02475782,-0.0041676,0.03305731,0.03611561,-0.03431536,-0.00445466,-0.00372086,0.02883463,0.09995498,-0.02917597,-0.03872788,0.00489378,-0.00751223,0.032625,-0.06328253,-0.01081104,0.02773272,-0.073819,0.01313701,-0.0043829,0.01499511,0.0202461,-0.03166299,0.03266104,0.04334667,-0.00132666,0.10443578,-0.00144299,-0.00361976,-0.02634092,-0.09063012,0.04751889,-0.02452669,-0.02062672,-0.04480707,-0.08012459,0.01183201,-0.04010321,-0.04003395,0.02094855,-0.02275683,0.01056336,0.02093815,-0.00341777,0.04783924,0.03024524,-0.04875171,0.04903476,-0.01258373,0.02079468,0.0069878,0.01757687,-0.00587951,0.06234477,0.03352679,0.03815861,0.05022845,0.05046458,0.04992548,-0.0205616,0.02344367,-0.02394869,0.0258431,0.01456429,0.00801927,-0.01436295,-0.01980022,-0.03802062,-0.00873746,0.06110513,-0.01953414,-0.05010321,0.132072,-0.03548854,0.04854403,-0.03019699,-0.05969113,-0.00122628,0.11297973,-0.0825801,0.05942934,-0.00662596,-0.04170519,0.05982737,0.03321417,-0.02855418,0.09894045,-0.01024536,-0.06219698,-0.01180982,0.13251606,0.0180322,-0.11631711,0.00392151,0.01145832,0.02943557,-0.0080137,0.03676838,-0.02131334,0.03791199,-0.01752748,0.02394037,0.03838003,-0.03948186,0.01351532,-0.039269,-0.02629828,0.00915812,-0.12093496,-0.06118226,-0.0223451,0.01438167,-0.02454914,0.0046629,-0.07158627,0.01507451,0.01694003,-0.03744908,0.00889119,0.00397303,0.01359236,0.02943818,0.00830424,0.00956869,-0.03458431,-0.02762299,-0.04261478,0.04874013,0.03963255,0.02885401,-0.02670775,-0.02022167,0.01276278,-0.07980483,0.03291413,0.04936708,0.01900783,-0.03099263,0.03178195,0.05349885,-0.04175413,-0.00199877,-0.01204778,0.0805735,0.08313844,0.01128915,0.04994245,-0.02228195,0.00150785,-0.0450093,-0.23353633,0.02674573,0.00416245,0.0410431,0.02193047,-0.12168965,0.04591716,0.0370492,0.05516151,0.06157,0.04510743,0.03482541,-0.03837963,0.04208057,-0.03928019,-0.02185483,0.01068083,-0.00475771,-0.03789286,-0.02074147,-0.03315113,0.05061259,0.01055785,-0.0113388,0.01377307,0.01074801,0.13805228,-0.00549639,0.04333453,0.00321952,-0.0158728,0.05980214,-0.05238479,-0.11727448,0.11044753,-0.00813602,0.02243743,-0.02923209,0.0239745,-0.0754011,-0.01735052,0.00050997,0.07564063,-0.08408272,-0.02484239,0.02782457,-0.02736036,-0.01957534,-0.07457254,0.03988316,0.04237795,-0.02397618,-0.00819641,0.04779496,-0.01499917,-0.0216885,-0.05366644,-0.04043831,-0.09271694,0.03574229,-0.00538465,0.02721384,-0.00964091,-0.07281875,0.10124879,0.06538138,-0.01643443,-0.0515886,0.03390345,-0.00872302,0.02238923,0.1631607,0.03298948,-0.04947967,0.06308375,0.02423873,0.02885991,-0.06342499,-0.04175394,-0.03601665,0.03475991,-0.0126362,0.00775537,0.03668467,0.08730138,0.02774153,0.05797257,-0.07630509,-0.01710782,0.00103636,0.02068071,0.01031053,0.01210856,-0.02589292,0.05133043,0.00999896,-0.280011,-0.00679144,-0.00064922,0.00006842,-0.02854758,0.00299833,0.03772924,-0.07435565,-0.00035811,-0.04262482,-0.02140728,0.01714309,0.05359856,0.03444109,-0.06434257,0.03997174,0.03285491,-0.06175525,0.11462603,-0.01114952,-0.04560051,-0.01018981,0.16760887,-0.03840062,-0.01203798,0.00263204,-0.04866019,-0.04336423,0.06184386,0.02379194,-0.01303177,-0.03091593,0.09692985,-0.00352379,0.02087984,0.08458812,-0.01932957,0.01783079,0.01046298,-0.00964555,0.01752569,-0.02565351,0.03845058,-0.03907345,0.05633992,-0.00721846,-0.02486363,0.01490825,-0.0110703,0.03236584,-0.00875126,-0.06010341,0.00264028,-0.04728516,0.07239943,-0.00653966,-0.03511935,0.01341813,-0.05448029,-0.02744262,0.02938756,-0.02767152,0.01772228,0.02340798,-0.06958228],"last_embed":{"hash":"1dsn4l9","tokens":441}}},"last_read":{"hash":"1dsn4l9","at":1774580776379},"class_name":"SmartSource","last_import":{"mtime":1773447493311,"size":8497,"at":1774579779528,"hash":"1dsn4l9"},"blocks":{"#Integração de Reconhecimento Facial - Áquila Pro\\n\\n## 📋 Visão Geral\\n\\nO módulo de reconhecimento facial integra-se com o ProcessingPipeline para identificar alunos a partir de detecções de pessoas em câmeras.\\n\\n### Fluxo de Funcionamento\\n\\n```\\nCâmera IP\\n    ↓\\n[VideoCapture] → Captura frames\\n    ↓\\n[FrameProcessor] → Detecta pessoas\\n    ↓\\n[FaceRecognition] → Identifica aluno\\n    ↓\\n[PresenceTracker] → Registra presença\\n    ↓\\n[Database] → Persiste dados\\n```\\n\\n---\\n\\n## 🔧 Arquitetura\\n\\n### Componentes Principais\\n\\n#### 1. **FaceRecognition.ts**\\nClasse responsável por:\\n- Carregar modelo de reconhecimento facial\\n- Extrair embeddings de faces\\n- Comparar com banco de dados\\n- Gerenciar faces de alunos\\n\\n#### 2. **ProcessingPipelineWithFace.ts**\\nExtensão do ProcessingPipeline que:\\n- Integra FaceRecognition com detecção\\n- Coordena eventos de reconhecimento\\n- Gerencia status do sistema\\n\\n#### 3. **FaceEmbeddingMethods.ts**\\nMétodos do Database para:\\n- Salvar embeddings\\n- Buscar embeddings\\n- Deletar embeddings\\n- Obter estatísticas\\n\\n---\\n\\n## 💾 Banco de Dados\\n\\n### Tabela: face_embeddings\\n\\n```sql\\nCREATE TABLE face_embeddings (\\n  face_id TEXT PRIMARY KEY,\\n  student_id TEXT NOT NULL,\\n  embedding TEXT NOT NULL,  -- JSON com 128 valores\\n  timestamp DATETIME NOT NULL,\\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\\n  FOREIGN KEY (student_id) REFERENCES students(student_id)\\n);\\n```\\n\\n### Exemplo de Embedding\\n\\n```json\\n{\\n  \\\"face_id\\\": \\\"face-1234567890-abc123\\\",\\n  \\\"student_id\\\": \\\"student-001\\\",\\n  \\\"embedding\\\": [\\n    0.123, -0.456, 0.789, ..., 0.321  // 128 valores\\n  ],\\n  \\\"timestamp\\\": \\\"2026-03-04T12:00:00Z\\\"\\n}\\n```\\n\\n---\\n\\n## 🚀 Uso\\n\\n### Inicializar Pipeline com Reconhecimento Facial\\n\\n```typescript\\nimport ProcessingPipelineWithFace from './services/ProcessingPipelineWithFace';\\nimport Database from './database/Database';\\n\\nconst db = new Database();\\nconst pipeline = new ProcessingPipelineWithFace(db);\\n\\n// Adicionar câmeras\\npipeline.addCamera({\\n  cameraId: 'cam-001',\\n  cameraUrl: 'rtsp://192.168.1.101:554/stream',\\n  location: 'Corredor Principal',\\n  type: 'corridor',\\n});\\n\\n// Iniciar pipeline (carrega modelo de reconhecimento)\\nawait pipeline.start();\\n```\\n\\n### Reconhecer Rosto\\n\\n```typescript\\n// Extrair face do frame e reconhecer\\nconst faceData = Buffer.from(faceImage);\\nconst match = await pipeline.recognizeFace(faceData);\\n\\nif (match) {\\n  console.log(`Aluno identificado: ${match.studentName}`);\\n  console.log(`Confiança: ${(match.confidence * 100).toFixed(2)}%`);\\n} else {\\n  console.log('Aluno não identificado');\\n}\\n```\\n\\n### Adicionar Novo Rosto\\n\\n```typescript\\nconst faceData = Buffer.from(studentPhoto);\\nconst faceId = await pipeline.addStudentFace('student-001', faceData);\\nconsole.log(`Rosto adicionado: ${faceId}`);\\n```\\n\\n### Remover Rosto\\n\\n```typescript\\nawait pipeline.removeFace('face-123');\\nconsole.log('Rosto removido');\\n```\\n\\n### Configurar Limiar de Confiança\\n\\n```typescript\\n// Apenas reconhecer com 80% de confiança ou mais\\npipeline.setFaceConfidenceThreshold(0.8);\\n```\\n\\n### Habilitar/Desabilitar Reconhecimento\\n\\n```typescript\\n// Desabilitar reconhecimento temporariamente\\npipeline.setFaceRecognitionEnabled(false);\\n\\n// Reabilitar\\npipeline.setFaceRecognitionEnabled(true);\\n```\\n\\n---\\n\\n## 📊 Eventos\\n\\n### Eventos de Reconhecimento\\n\\n```typescript\\npipeline.on('face:recognized', (data) => {\\n  console.log(`Aluno ${data.studentId} reconhecido`);\\n  console.log(`Confiança: ${data.confidence}`);\\n});\\n\\npipeline.on('face:unknown', (data) => {\\n  console.log(`Pessoa desconhecida detectada`);\\n  console.log(`Confiança: ${data.confidence}`);\\n});\\n\\npipeline.on('face:added', (data) => {\\n  console.log(`Novo rosto adicionado para ${data.studentId}`);\\n});\\n\\npipeline.on('face:removed', (data) => {\\n  console.log(`Rosto ${data.faceId} removido`);\\n});\\n```\\n\\n---\\n\\n## 🎯 Modelos Suportados\\n\\n### 1. face_recognition.js (Recomendado)\\n- **Precisão**: 99.38%\\n- **Velocidade**: ~30 FPS em GPU\\n- **Tamanho**: ~100 MB\\n- **Dependências**: dlib, OpenCV\\n\\n**Instalação**:\\n```bash\\nnpm install face-recognition\\n```\\n\\n### 2. TensorFlow.js\\n- **Precisão**: 97%\\n- **Velocidade**: ~20 FPS em CPU\\n- **Tamanho**: ~30 MB\\n- **Vantagem**: Roda em CPU\\n\\n**Instalação**:\\n```bash\\nnpm install @tensorflow/tfjs @tensorflow-models/facemesh\\n```\\n\\n### 3. OpenCV + DNN\\n- **Precisão**: 95%\\n- **Velocidade**: ~15 FPS em CPU\\n- **Tamanho**: ~50 MB\\n- **Vantagem**: Integrado com OpenCV\\n\\n---\\n\\n## 🔍 Algoritmo de Reconhecimento\\n\\n### 1. Extração de Embedding\\n\\n```\\nFace Image (224x224)\\n    ↓\\n[Pré-processamento]\\n  - Normalizar pixels\\n  - Alinhar face\\n    ↓\\n[Rede Neural]\\n  - Convolução\\n  - Pooling\\n  - Fully Connected\\n    ↓\\nEmbedding (128 dimensões)\\n```\\n\\n### 2. Comparação de Embeddings\\n\\n```typescript\\n// Distância Euclidiana\\nconst distance = Math.sqrt(\\n  embedding1.reduce((sum, val, i) => {\\n    return sum + Math.pow(val - embedding2[i], 2);\\n  }, 0)\\n);\\n\\n// Converter para confiança (0-1)\\nconst confidence = 1 / (1 + distance);\\n```\\n\\n### 3. Busca por Similaridade\\n\\n```\\nEmbedding do Rosto Detectado\\n    ↓\\n[Calcular distância para cada embedding do banco]\\n    ↓\\n[Encontrar embedding mais próximo]\\n    ↓\\n[Converter distância para confiança]\\n    ↓\\n[Comparar com limiar]\\n    ↓\\nResultado: Match ou Não Identificado\\n```\\n\\n---\\n\\n## ⚙️ Configuração\\n\\n### Arquivo de Configuração\\n\\n```typescript\\n// config/face-recognition.ts\\nexport const faceRecognitionConfig = {\\n  // Modelo a usar\\n  model: 'face-recognition', // 'face-recognition' | 'tensorflow' | 'opencv'\\n\\n  // Limiar de confiança padrão\\n  confidenceThreshold: 0.6,\\n\\n  // Tamanho de face para processar\\n  faceSize: 224,\\n\\n  // Dimensões do embedding\\n  embeddingDimensions: 128,\\n\\n  // Número de faces por aluno\\n  facesPerStudent: 5,\\n\\n  // Atualizar embeddings automaticamente\\n  autoUpdateEmbeddings: true,\\n\\n  // Intervalo de atualização (ms)\\n  updateInterval: 3600000, // 1 hora\\n\\n  // Cache de embeddings em memória\\n  cacheEmbeddings: true,\\n\\n  // Tamanho máximo do cache\\n  maxCacheSize: 10000,\\n};\\n```\\n\\n---\\n\\n## 📈 Performance\\n\\n### Benchmarks\\n\\n| Operação | Tempo | CPU | Memória |\\n|----------|-------|-----|----------|\\n| Carregar modelo | 2-3s | 50% | 200MB |\\n| Extrair embedding | 50-100ms | 30% | 50MB |\\n| Comparar 1000 embeddings | 10-20ms | 20% | 10MB |\\n| Reconhecer face | 100-150ms | 40% | 60MB |\\n\\n### Otimizações\\n\\n1. **Cache de Embeddings**\\n   - Manter embeddings em memória\\n   - Reduz I/O do banco de dados\\n   - Aumenta velocidade de busca\\n\\n2. **Índice FAISS**\\n   - Busca rápida por similaridade\\n   - Suporta milhões de embeddings\\n   - Reduz tempo de comparação\\n\\n3. **Processamento em GPU**\\n   - Usar CUDA para TensorFlow\\n   - Aumenta velocidade 10x\\n   - Requer GPU com CUDA support\\n\\n---\\n\\n## 🐛 Troubleshooting\\n\\n### Problema: Reconhecimento Impreciso\\n\\n**Causa**: Embeddings de baixa qualidade ou limiar muito baixo\\n\\n**Solução**:\\n```typescript\\n// Aumentar limiar de confiança\\npipeline.setFaceConfidenceThreshold(0.8);\\n\\n// Adicionar mais faces de treinamento\\nawait pipeline.addStudentFace('student-001', face1);\\nawait pipeline.addStudentFace('student-001', face2);\\nawait pipeline.addStudentFace('student-001', face3);\\n```\\n\\n### Problema: Lentidão\\n\\n**Causa**: Muitos embeddings ou processamento em CPU\\n\\n**Solução**:\\n```typescript\\n// Usar GPU\\nprocess.env.TF_CPP_MIN_LOG_LEVEL = '0';\\n\\n// Limpar cache periodicamente\\nsetInterval(() => {\\n  pipeline.faceRecognition.clearCache();\\n}, 3600000); // A cada 1 hora\\n```\\n\\n### Problema: Modelo Não Carrega\\n\\n**Causa**: Dependências faltando\\n\\n**Solução**:\\n```bash\\n# Instalar dependências\\nnpm install face-recognition\\n\\n# Ou usar TensorFlow como alternativa\\nnpm install @tensorflow/tfjs @tensorflow-models/facemesh\\n```\\n\\n---\\n\\n## 📚 Referências\\n\\n- [face-recognition.js](https://github.com/justadudewhohacks/face-recognition.js)\\n- [TensorFlow.js Face Detection](https://github.com/tensorflow/tfjs-models/tree/master/face-detection)\\n- [OpenCV Face Recognition](https://docs.opencv.org/master/d5/d6f/tutorial_face_detection.html)\\n- [Embeddings e Similarity Search](https://en.wikipedia.org/wiki/Embedding)\\n\\n---\\n\\n**Última atualização**: 2026-03-04\\n":[1,2]},"outlinks":[{"title":"OpenCV Face Recognition","target":"https://docs.opencv.org/master/d5/d6f/tutorial_face_detection.html","line":1},{"title":"Embeddings e Similarity Search","target":"https://en.wikipedia.org/wiki/Embedding","line":1},{"title":"face-recognition.js","target":"https://github.com/justadudewhohacks/face-recognition.js","line":1},{"title":"TensorFlow.js Face Detection","target":"https://github.com/tensorflow/tfjs-models/tree/master/face-detection","line":1}],"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"1dsn4l9","at":1774580776144}},"smart_blocks:docs/FACE_RECOGNITION_INTEGRATION.md#Integração de Reconhecimento Facial - Áquila Pro\\n\\n## 📋 Visão Geral\\n\\nO módulo de reconhecimento facial integra-se com o ProcessingPipeline para identificar alunos a partir de detecções de pessoas em câmeras.\\n\\n### Fluxo de Funcionamento\\n\\n```\\nCâmera IP\\n    ↓\\n[VideoCapture] → Captura frames\\n    ↓\\n[FrameProcessor] → Detecta pessoas\\n    ↓\\n[FaceRecognition] → Identifica aluno\\n    ↓\\n[PresenceTracker] → Registra presença\\n    ↓\\n[Database] → Persiste dados\\n```\\n\\n---\\n\\n## 🔧 Arquitetura\\n\\n### Componentes Principais\\n\\n#### 1. **FaceRecognition.ts**\\nClasse responsável por:\\n- Carregar modelo de reconhecimento facial\\n- Extrair embeddings de faces\\n- Comparar com banco de dados\\n- Gerenciar faces de alunos\\n\\n#### 2. **ProcessingPipelineWithFace.ts**\\nExtensão do ProcessingPipeline que:\\n- Integra FaceRecognition com detecção\\n- Coordena eventos de reconhecimento\\n- Gerencia status do sistema\\n\\n#### 3. **FaceEmbeddingMethods.ts**\\nMétodos do Database para:\\n- Salvar embeddings\\n- Buscar embeddings\\n- Deletar embeddings\\n- Obter estatísticas\\n\\n---\\n\\n## 💾 Banco de Dados\\n\\n### Tabela: face_embeddings\\n\\n```sql\\nCREATE TABLE face_embeddings (\\n  face_id TEXT PRIMARY KEY,\\n  student_id TEXT NOT NULL,\\n  embedding TEXT NOT NULL,  -- JSON com 128 valores\\n  timestamp DATETIME NOT NULL,\\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\\n  FOREIGN KEY (student_id) REFERENCES students(student_id)\\n);\\n```\\n\\n### Exemplo de Embedding\\n\\n```json\\n{\\n  \\\"face_id\\\": \\\"face-1234567890-abc123\\\",\\n  \\\"student_id\\\": \\\"student-001\\\",\\n  \\\"embedding\\\": [\\n    0.123, -0.456, 0.789, ..., 0.321  // 128 valores\\n  ],\\n  \\\"timestamp\\\": \\\"2026-03-04T12:00:00Z\\\"\\n}\\n```\\n\\n---\\n\\n## 🚀 Uso\\n\\n### Inicializar Pipeline com Reconhecimento Facial\\n\\n```typescript\\nimport ProcessingPipelineWithFace from './services/ProcessingPipelineWithFace';\\nimport Database from './database/Database';\\n\\nconst db = new Database();\\nconst pipeline = new ProcessingPipelineWithFace(db);\\n\\n// Adicionar câmeras\\npipeline.addCamera({\\n  cameraId: 'cam-001',\\n  cameraUrl: 'rtsp://192.168.1.101:554/stream',\\n  location: 'Corredor Principal',\\n  type: 'corridor',\\n});\\n\\n// Iniciar pipeline (carrega modelo de reconhecimento)\\nawait pipeline.start();\\n```\\n\\n### Reconhecer Rosto\\n\\n```typescript\\n// Extrair face do frame e reconhecer\\nconst faceData = Buffer.from(faceImage);\\nconst match = await pipeline.recognizeFace(faceData);\\n\\nif (match) {\\n  console.log(`Aluno identificado: ${match.studentName}`);\\n  console.log(`Confiança: ${(match.confidence * 100).toFixed(2)}%`);\\n} else {\\n  console.log('Aluno não identificado');\\n}\\n```\\n\\n### Adicionar Novo Rosto\\n\\n```typescript\\nconst faceData = Buffer.from(studentPhoto);\\nconst faceId = await pipeline.addStudentFace('student-001', faceData);\\nconsole.log(`Rosto adicionado: ${faceId}`);\\n```\\n\\n### Remover Rosto\\n\\n```typescript\\nawait pipeline.removeFace('face-123');\\nconsole.log('Rosto removido');\\n```\\n\\n### Configurar Limiar de Confiança\\n\\n```typescript\\n// Apenas reconhecer com 80% de confiança ou mais\\npipeline.setFaceConfidenceThreshold(0.8);\\n```\\n\\n### Habilitar/Desabilitar Reconhecimento\\n\\n```typescript\\n// Desabilitar reconhecimento temporariamente\\npipeline.setFaceRecognitionEnabled(false);\\n\\n// Reabilitar\\npipeline.setFaceRecognitionEnabled(true);\\n```\\n\\n---\\n\\n## 📊 Eventos\\n\\n### Eventos de Reconhecimento\\n\\n```typescript\\npipeline.on('face:recognized', (data) => {\\n  console.log(`Aluno ${data.studentId} reconhecido`);\\n  console.log(`Confiança: ${data.confidence}`);\\n});\\n\\npipeline.on('face:unknown', (data) => {\\n  console.log(`Pessoa desconhecida detectada`);\\n  console.log(`Confiança: ${data.confidence}`);\\n});\\n\\npipeline.on('face:added', (data) => {\\n  console.log(`Novo rosto adicionado para ${data.studentId}`);\\n});\\n\\npipeline.on('face:removed', (data) => {\\n  console.log(`Rosto ${data.faceId} removido`);\\n});\\n```\\n\\n---\\n\\n## 🎯 Modelos Suportados\\n\\n### 1. face_recognition.js (Recomendado)\\n- **Precisão**: 99.38%\\n- **Velocidade**: ~30 FPS em GPU\\n- **Tamanho**: ~100 MB\\n- **Dependências**: dlib, OpenCV\\n\\n**Instalação**:\\n```bash\\nnpm install face-recognition\\n```\\n\\n### 2. TensorFlow.js\\n- **Precisão**: 97%\\n- **Velocidade**: ~20 FPS em CPU\\n- **Tamanho**: ~30 MB\\n- **Vantagem**: Roda em CPU\\n\\n**Instalação**:\\n```bash\\nnpm install @tensorflow/tfjs @tensorflow-models/facemesh\\n```\\n\\n### 3. OpenCV + DNN\\n- **Precisão**: 95%\\n- **Velocidade**: ~15 FPS em CPU\\n- **Tamanho**: ~50 MB\\n- **Vantagem**: Integrado com OpenCV\\n\\n---\\n\\n## 🔍 Algoritmo de Reconhecimento\\n\\n### 1. Extração de Embedding\\n\\n```\\nFace Image (224x224)\\n    ↓\\n[Pré-processamento]\\n  - Normalizar pixels\\n  - Alinhar face\\n    ↓\\n[Rede Neural]\\n  - Convolução\\n  - Pooling\\n  - Fully Connected\\n    ↓\\nEmbedding (128 dimensões)\\n```\\n\\n### 2. Comparação de Embeddings\\n\\n```typescript\\n// Distância Euclidiana\\nconst distance = Math.sqrt(\\n  embedding1.reduce((sum, val, i) => {\\n    return sum + Math.pow(val - embedding2[i], 2);\\n  }, 0)\\n);\\n\\n// Converter para confiança (0-1)\\nconst confidence = 1 / (1 + distance);\\n```\\n\\n### 3. Busca por Similaridade\\n\\n```\\nEmbedding do Rosto Detectado\\n    ↓\\n[Calcular distância para cada embedding do banco]\\n    ↓\\n[Encontrar embedding mais próximo]\\n    ↓\\n[Converter distância para confiança]\\n    ↓\\n[Comparar com limiar]\\n    ↓\\nResultado: Match ou Não Identificado\\n```\\n\\n---\\n\\n## ⚙️ Configuração\\n\\n### Arquivo de Configuração\\n\\n```typescript\\n// config/face-recognition.ts\\nexport const faceRecognitionConfig = {\\n  // Modelo a usar\\n  model: 'face-recognition', // 'face-recognition' | 'tensorflow' | 'opencv'\\n\\n  // Limiar de confiança padrão\\n  confidenceThreshold: 0.6,\\n\\n  // Tamanho de face para processar\\n  faceSize: 224,\\n\\n  // Dimensões do embedding\\n  embeddingDimensions: 128,\\n\\n  // Número de faces por aluno\\n  facesPerStudent: 5,\\n\\n  // Atualizar embeddings automaticamente\\n  autoUpdateEmbeddings: true,\\n\\n  // Intervalo de atualização (ms)\\n  updateInterval: 3600000, // 1 hora\\n\\n  // Cache de embeddings em memória\\n  cacheEmbeddings: true,\\n\\n  // Tamanho máximo do cache\\n  maxCacheSize: 10000,\\n};\\n```\\n\\n---\\n\\n## 📈 Performance\\n\\n### Benchmarks\\n\\n| Operação | Tempo | CPU | Memória |\\n|----------|-------|-----|----------|\\n| Carregar modelo | 2-3s | 50% | 200MB |\\n| Extrair embedding | 50-100ms | 30% | 50MB |\\n| Comparar 1000 embeddings | 10-20ms | 20% | 10MB |\\n| Reconhecer face | 100-150ms | 40% | 60MB |\\n\\n### Otimizações\\n\\n1. **Cache de Embeddings**\\n   - Manter embeddings em memória\\n   - Reduz I/O do banco de dados\\n   - Aumenta velocidade de busca\\n\\n2. **Índice FAISS**\\n   - Busca rápida por similaridade\\n   - Suporta milhões de embeddings\\n   - Reduz tempo de comparação\\n\\n3. **Processamento em GPU**\\n   - Usar CUDA para TensorFlow\\n   - Aumenta velocidade 10x\\n   - Requer GPU com CUDA support\\n\\n---\\n\\n## 🐛 Troubleshooting\\n\\n### Problema: Reconhecimento Impreciso\\n\\n**Causa**: Embeddings de baixa qualidade ou limiar muito baixo\\n\\n**Solução**:\\n```typescript\\n// Aumentar limiar de confiança\\npipeline.setFaceConfidenceThreshold(0.8);\\n\\n// Adicionar mais faces de treinamento\\nawait pipeline.addStudentFace('student-001', face1);\\nawait pipeline.addStudentFace('student-001', face2);\\nawait pipeline.addStudentFace('student-001', face3);\\n```\\n\\n### Problema: Lentidão\\n\\n**Causa**: Muitos embeddings ou processamento em CPU\\n\\n**Solução**:\\n```typescript\\n// Usar GPU\\nprocess.env.TF_CPP_MIN_LOG_LEVEL = '0';\\n\\n// Limpar cache periodicamente\\nsetInterval(() => {\\n  pipeline.faceRecognition.clearCache();\\n}, 3600000); // A cada 1 hora\\n```\\n\\n### Problema: Modelo Não Carrega\\n\\n**Causa**: Dependências faltando\\n\\n**Solução**:\\n```bash\\n# Instalar dependências\\nnpm install face-recognition\\n\\n# Ou usar TensorFlow como alternativa\\nnpm install @tensorflow/tfjs @tensorflow-models/facemesh\\n```\\n\\n---\\n\\n## 📚 Referências\\n\\n- [face-recognition.js](https://github.com/justadudewhohacks/face-recognition.js)\\n- [TensorFlow.js Face Detection](https://github.com/tensorflow/tfjs-models/tree/master/face-detection)\\n- [OpenCV Face Recognition](https://docs.opencv.org/master/d5/d6f/tutorial_face_detection.html)\\n- [Embeddings e Similarity Search](https://en.wikipedia.org/wiki/Embedding)\\n\\n---\\n\\n**Última atualização**: 2026-03-04\\n": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.04652765,-0.00383845,0.01587611,0.0067299,-0.02104385,-0.00400324,0.04046418,-0.01972758,0.0339223,0.02938035,0.02720418,-0.12384018,-0.01551307,0.01811225,0.04854037,0.0003986,0.03600337,0.08234105,-0.04953508,-0.02997776,0.03457481,-0.02101242,-0.02836396,-0.02554571,0.00346197,0.03107728,0.01311579,-0.01863725,0.00038193,-0.23329405,0.02830607,-0.03591535,0.0272091,0.02276338,0.01799723,-0.01540552,-0.06725425,0.01345675,-0.04590534,0.00420033,-0.00773737,0.02211039,-0.03888386,-0.01237968,-0.0163202,-0.03994877,-0.0298782,0.01287815,-0.04976673,-0.00394116,-0.02288862,-0.05240721,0.02034562,0.04859086,-0.06300295,0.0764367,0.06022931,0.04410337,0.09071819,0.0573121,0.0591093,0.03990106,-0.18230169,0.05097702,-0.03236311,0.05041757,-0.03256103,-0.0468956,0.02202022,-0.00794696,-0.02233434,-0.02465432,0.04178716,-0.02447581,-0.00097872,0.02347056,0.03131972,-0.0293093,-0.01268389,0.00249748,0.02889588,0.09578395,-0.02604935,-0.02778646,0.00077154,-0.00689424,0.04299698,-0.05571261,-0.00350836,0.03005263,-0.07875934,0.01379971,-0.00