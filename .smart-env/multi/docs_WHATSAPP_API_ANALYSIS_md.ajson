
"smart_sources:docs/WHATSAPP_API_ANALYSIS.md": {"path":"docs/WHATSAPP_API_ANALYSIS.md","embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.02578745,-0.02969634,-0.03551294,-0.07778179,0.03292356,-0.02637506,-0.01019003,0.01632363,0.01049675,-0.03343014,0.013558,-0.05464122,0.02566016,-0.01271285,0.00182594,-0.0045277,0.04211309,-0.02662346,-0.08981726,-0.01828956,0.11589952,-0.0654498,-0.01855174,-0.02967535,-0.02871186,0.02958901,-0.04790411,0.01136985,-0.03105719,-0.16795789,0.01575682,-0.04838121,0.05136963,-0.01565389,0.02199223,0.04621999,-0.00397147,-0.04264782,-0.01716461,0.05830145,-0.02198322,-0.00555525,-0.00421463,-0.00843095,-0.01669405,-0.02699717,-0.02578363,0.04509988,-0.08398557,-0.01461643,-0.06673741,-0.01308393,-0.02267033,-0.00045437,0.00049692,0.02714137,0.03697239,0.07725687,-0.00173295,0.07539986,0.06119555,0.05210814,-0.22057919,0.05242936,-0.0179483,0.0767004,-0.11581583,0.00707289,0.01649325,-0.00511056,-0.01747722,-0.00918041,0.07067684,0.0161804,0.07684522,0.0577933,0.0197759,-0.02752519,0.01628707,0.04326459,0.03080974,0.04201233,0.00604551,0.04546886,0.01396686,-0.05521662,0.02051808,0.0019826,0.05867243,-0.00556042,-0.03202256,-0.00936888,0.02001947,0.01110112,-0.04335218,-0.01450162,0.01278786,0.0227832,-0.03828729,0.08345664,-0.03421786,0.01904183,0.00735605,-0.01259331,0.00183703,-0.05514183,-0.05594562,-0.06661469,0.04362471,0.04011914,-0.03422726,-0.00084345,0.00747357,-0.08083714,-0.04085385,-0.00763438,0.01231763,0.00166432,0.03096569,-0.03648265,0.02273012,-0.00119961,0.04632849,-0.01685853,0.02560429,-0.00537831,0.06007642,0.03985843,-0.01638573,0.06906537,0.07375089,0.09533922,-0.06217017,-0.00201928,-0.02090687,-0.0286174,0.05081794,0.02258562,-0.03417102,0.04802494,-0.05049708,-0.06715682,0.0085656,-0.07012017,-0.04019998,0.16786563,0.00437959,0.04246742,-0.00966533,-0.0400466,-0.04719314,0.09704277,-0.04682538,-0.01210509,-0.02323706,-0.0009486,0.07470016,0.0675986,-0.05600696,0.01192956,-0.07993568,-0.06882583,-0.0212692,0.16378956,0.03629727,-0.15938562,-0.02585178,0.05716245,0.00928797,-0.0231618,0.03636326,0.01994217,-0.00969904,-0.00863763,0.03667399,0.00620905,0.00475675,-0.01684326,0.01743719,-0.01163934,-0.00597443,-0.03660973,-0.08384797,0.01768992,-0.03723202,-0.04061641,0.00879481,-0.02133729,0.03105847,-0.02649117,-0.04457499,-0.01260509,-0.01682367,0.00797302,-0.0213801,0.01569486,-0.01383185,0.00361814,0.03309988,-0.05186586,0.0900174,0.04077028,0.00081386,-0.00901819,-0.00127293,0.02468637,-0.03936028,0.05008994,0.01913134,-0.00813966,-0.03824753,0.01952907,0.01491185,0.02870167,0.03764539,0.02593182,0.02405781,0.01018987,0.01547384,0.08245543,0.02083272,0.02073725,-0.0040354,-0.19551428,-0.00776315,-0.02195475,0.04293222,-0.02760353,-0.09653518,0.02845822,-0.07768137,0.08412585,0.12459847,0.09805885,0.0024953,-0.05720878,0.04331546,-0.00709165,0.0218734,0.02337203,-0.00325201,-0.02412894,0.03259802,-0.03798022,-0.01611211,0.02217535,-0.05894,0.01921027,-0.01904803,0.13777706,0.02242946,0.0073465,-0.01657143,0.06700549,-0.01360074,-0.04106299,-0.12362371,0.04369202,0.08730222,0.01753712,-0.06909517,0.0476517,-0.02277284,-0.02522111,0.06808055,0.02712169,-0.08468613,-0.01186005,-0.01551027,0.00532267,-0.04287447,-0.06276186,0.0775649,-0.02542082,0.04759393,0.05405132,0.04244372,0.00355605,-0.02921466,-0.06794695,-0.01140883,-0.0228376,0.03577492,-0.03880098,-0.02749567,0.01045422,-0.01589005,0.03505164,-0.00348191,-0.00555775,-0.03643275,-0.00035557,-0.03713969,0.01881196,0.14455998,0.00519157,0.01046049,-0.02196408,0.03695982,0.03160647,-0.07379089,-0.03760949,0.0280125,0.01627699,0.01291862,0.01428808,0.03655032,0.02975526,0.04357626,0.07815644,-0.03858615,0.00593589,-0.03206086,-0.00169946,0.00745891,-0.07204194,-0.04340338,0.07032338,-0.00259091,-0.29543215,0.02097771,-0.00541934,-0.04189697,-0.00966924,0.01506665,0.02620477,-0.04553721,-0.09246201,-0.00669033,-0.01437239,0.03069634,0.03944261,0.00643364,0.02908584,-0.01519046,0.03205603,0.00030523,0.09810563,-0.04689821,0.00479901,0.04088883,0.20594242,0.02169637,-0.00823582,0.02552496,-0.02319966,0.02575477,0.00677228,0.00714763,-0.02799155,-0.01800487,0.06327639,-0.0317867,0.00857581,0.025818,-0.03674001,0.00463584,0.03895867,0.00506972,0.0295545,-0.03691413,0.02167419,0.01447881,0.0854102,-0.06158352,-0.05660845,-0.0299492,0.02115539,0.05034961,-0.04903105,-0.07315642,-0.02033389,-0.00193195,0.03246522,0.02169571,-0.02627201,-0.01381211,-0.07606451,-0.02735491,-0.00088972,0.03024364,0.0172742,0.07300331,0.06964814],"last_embed":{"hash":"b283xy","tokens":491}}},"last_read":{"hash":"b283xy","at":1774580843764},"class_name":"SmartSource","last_import":{"mtime":1773447493351,"size":11395,"at":1774579781554,"hash":"b283xy"},"blocks":{"#📱 Análise: APIs Gratuitas de WhatsApp para Áquila Pro\\n\\n## 📋 Resumo Executivo\\n\\nExistem **3 opções viáveis** para enviar mensagens WhatsApp gratuitamente:\\n\\n1. ✅ **WhatsApp Business API (Meta)** - Gratuito com limite\\n2. ✅ **Evolution API** - Open-source, self-hosted\\n3. ✅ **Baileys** - Node.js library, simples\\n\\n---\\n\\n## 🥇 Opção 1: WhatsApp Business API (Meta) - Recomendado\\n\\n### O que é\\n\\nAPI oficial do WhatsApp fornecida pela Meta (Facebook) para negócios\\n\\n### Preços\\n\\n| Tipo | Custo | Limite |\\n|------|-------|--------|\\n| **Sandbox** | Gratuito | 100 mensagens/dia |\\n| **Produção** | $0.0035-0.0500 por msg | Ilimitado |\\n\\n### Como Funciona\\n\\n```\\n1. Criar conta Business na Meta\\n2. Solicitar acesso à API\\n3. Configurar webhook para receber mensagens\\n4. Enviar mensagens via API REST\\n```\\n\\n### Vantagens\\n\\n✅ Oficial e confiável\\n✅ Sandbox gratuito (100 msgs/dia)\\n✅ Muito simples de integrar\\n✅ Suporta templates de mensagens\\n✅ Webhooks para receber respostas\\n✅ Analytics integrado\\n\\n### Desvantagens\\n\\n❌ Requer verificação de negócio\\n❌ Requer número de telefone dedicado\\n❌ Pago em produção ($0.0035-0.05 por msg)\\n❌ Limite de 100 msgs/dia em sandbox\\n\\n### Implementação\\n\\n```typescript\\n// WhatsAppBusinessAPI.ts\\n\\nexport class WhatsAppBusinessAPI {\\n  private accessToken: string;\\n  private phoneNumberId: string;\\n  private apiUrl = 'https://graph.instagram.com/v18.0';\\n\\n  constructor(accessToken: string, phoneNumberId: string) {\\n    this.accessToken = accessToken;\\n    this.phoneNumberId = phoneNumberId;\\n  }\\n\\n  async sendMessage(to: string, message: string): Promise<any> {\\n    const url = `${this.apiUrl}/${this.phoneNumberId}/messages`;\\n\\n    const response = await fetch(url, {\\n      method: 'POST',\\n      headers: {\\n        'Authorization': `Bearer ${this.accessToken}`,\\n        'Content-Type': 'application/json',\\n      },\\n      body: JSON.stringify({\\n        messaging_product: 'whatsapp',\\n        to,\\n        type: 'text',\\n        text: { body: message },\\n      }),\\n    });\\n\\n    return response.json();\\n  }\\n\\n  async sendTemplate(\\n    to: string,\\n    templateName: string,\\n    parameters: string[]\\n  ): Promise<any> {\\n    const url = `${this.apiUrl}/${this.phoneNumberId}/messages`;\\n\\n    const response = await fetch(url, {\\n      method: 'POST',\\n      headers: {\\n        'Authorization': `Bearer ${this.accessToken}`,\\n        'Content-Type': 'application/json',\\n      },\\n      body: JSON.stringify({\\n        messaging_product: 'whatsapp',\\n        to,\\n        type: 'template',\\n        template: {\\n          name: templateName,\\n          language: { code: 'pt_BR' },\\n          parameters: {\\n            body: {\\n              parameters: parameters.map(p => ({ type: 'text', text: p })),\\n            },\\n          },\\n        },\\n      }),\\n    });\\n\\n    return response.json();\\n  }\\n}\\n```\\n\\n### Custo para Escola com 500 alunos\\n\\n```\\nCenário: 2 alertas por aluno por dia, 250 dias úteis\\n\\nMensagens/dia: 500 alunos × 2 alertas = 1,000 msgs\\nMensagens/mês: 1,000 × 22 dias = 22,000 msgs\\nMensagens/ano: 22,000 × 12 = 264,000 msgs\\n\\nCusto (taxa média $0.0035):\\n264,000 × $0.0035 = $924/ano\\n\\nCusto (taxa máxima $0.05):\\n264,000 × $0.05 = $13,200/ano\\n```\\n\\n---\\n\\n## 🥈 Opção 2: Evolution API - Open-Source\\n\\n### O que é\\n\\nAPI open-source que funciona como \\\"proxy\\\" do WhatsApp, permitindo enviar mensagens sem custos\\n\\n### Preços\\n\\n| Tipo | Custo |\\n|------|-------|\\n| **Self-hosted** | Gratuito |\\n| **Cloud** | $9.99-99.99/mês |\\n\\n### Como Funciona\\n\\n```\\n1. Instalar Evolution API em servidor próprio\\n2. Conectar conta WhatsApp pessoal/business\\n3. Usar API para enviar mensagens\\n4. Sem limites de mensagens\\n```\\n\\n### Vantagens\\n\\n✅ Completamente gratuito (self-hosted)\\n✅ Sem limites de mensagens\\n✅ Open-source\\n✅ Funciona com WhatsApp pessoal ou Business\\n✅ Suporta múltiplas contas\\n✅ Webhooks para eventos\\n\\n### Desvantagens\\n\\n❌ Requer servidor próprio\\n❌ Mais complexo de configurar\\n❌ Pode ser bloqueado pelo WhatsApp (risco)\\n❌ Requer manutenção técnica\\n❌ Não é oficial da Meta\\n\\n### Instalação\\n\\n```bash\\n# Docker\\ndocker run -d \\\\\\n  -p 8080:8080 \\\\\\n  -e DATABASE_CONNECTION_URI=mongodb://mongo:27017 \\\\\\n  -e JWT_SECRET=seu-secret \\\\\\n  --name evolution-api \\\\\\n  evolucaocodes/evolution-api:latest\\n\\n# Acessar em http://localhost:8080\\n```\\n\\n### Implementação\\n\\n```typescript\\n// EvolutionAPIIntegration.ts\\n\\nexport class EvolutionAPIIntegration {\\n  private baseUrl: string;\\n  private apiKey: string;\\n\\n  constructor(baseUrl: string, apiKey: string) {\\n    this.baseUrl = baseUrl;\\n    this.apiKey = apiKey;\\n  }\\n\\n  async sendMessage(instanceName: string, to: string, message: string): Promise<any> {\\n    const response = await fetch(\\n      `${this.baseUrl}/message/sendText/${instanceName}`,\\n      {\\n        method: 'POST',\\n        headers: {\\n          'Content-Type': 'application/json',\\n          'apikey': this.apiKey,\\n        },\\n        body: JSON.stringify({\\n          number: to,\\n          text: message,\\n        }),\\n      }\\n    );\\n\\n    return response.json();\\n  }\\n\\n  async sendMedia(\\n    instanceName: string,\\n    to: string,\\n    mediaUrl: string,\\n    caption: string\\n  ): Promise<any> {\\n    const response = await fetch(\\n      `${this.baseUrl}/message/sendMedia/${instanceName}`,\\n      {\\n        method: 'POST',\\n        headers: {\\n          'Content-Type': 'application/json',\\n          'apikey': this.apiKey,\\n        },\\n        body: JSON.stringify({\\n          number: to,\\n          mediaType: 'image',\\n          media: mediaUrl,\\n          caption,\\n        }),\\n      }\\n    );\\n\\n    return response.json();\\n  }\\n}\\n```\\n\\n### Custo para Escola\\n\\n```\\nSelf-hosted: $0/ano (apenas eletricidade ~$20)\\nCloud: $120-1,200/ano\\n```\\n\\n---\\n\\n## 🥉 Opção 3: Baileys - Node.js Library\\n\\n### O que é\\n\\nBiblioteca Node.js que simula cliente WhatsApp Web\\n\\n### Preços\\n\\n| Tipo | Custo |\\n|------|-------|\\n| **NPM** | Gratuito |\\n\\n### Como Funciona\\n\\n```\\n1. Instalar via npm\\n2. Conectar com QR code\\n3. Enviar mensagens via código\\n4. Sem API, sem custos\\n```\\n\\n### Vantagens\\n\\n✅ Completamente gratuito\\n✅ Muito simples de usar\\n✅ Sem servidor adicional\\n✅ Funciona com WhatsApp pessoal\\n✅ Suporta múltiplos tipos de mensagens\\n\\n### Desvantagens\\n\\n❌ Pode ser bloqueado pelo WhatsApp\\n❌ Menos confiável que API oficial\\n❌ Requer manutenção frequente\\n❌ Não é suportado pela Meta\\n❌ Risco de banimento\\n\\n### Instalação\\n\\n```bash\\nnpm install @whiskeysockets/baileys\\n```\\n\\n### Implementação\\n\\n```typescript\\n// BaileysIntegration.ts\\n\\nimport makeWASocket from '@whiskeysockets/baileys';\\nimport { DisconnectReason } from '@whiskeysockets/baileys';\\n\\nexport class BaileysIntegration {\\n  private sock: any;\\n\\n  async connect(): Promise<void> {\\n    const sock = makeWASocket({\\n      auth: {\\n        creds: {},\\n        keys: {},\\n      },\\n    });\\n\\n    sock.ev.on('connection.update', (update: any) => {\\n      const { connection, lastDisconnect } = update;\\n      if (connection === 'close') {\\n        const shouldReconnect =\\n          lastDisconnect?.error?.output?.statusCode !== DisconnectReason.loggedOut;\\n        console.log(\\n          'connection closed due to ',\\n          lastDisconnect?.error,\\n          ', reconnecting ',\\n          shouldReconnect\\n        );\\n      }\\n    });\\n\\n    this.sock = sock;\\n  }\\n\\n  async sendMessage(to: string, message: string): Promise<void> {\\n    await this.sock.sendMessage(to, { text: message });\\n  }\\n\\n  async sendMedia(to: string, mediaUrl: string, caption: string): Promise<void> {\\n    const media = await fetch(mediaUrl).then(r => r.buffer());\\n    await this.sock.sendMessage(to, {\\n      image: media,\\n      caption,\\n    });\\n  }\\n}\\n```\\n\\n---\\n\\n## 📊 Comparação das 3 Opções\\n\\n| Critério | Meta API | Evolution API | Baileys |\\n|----------|----------|---------------|----------|\\n| **Custo** | $0-13k/ano | $0/ano | $0/ano |\\n| **Confiabilidade** | ⭐⭐⭐⭐⭐ | ⭐⭐⭐ | ⭐⭐ |\\n| **Facilidade** | ⭐⭐⭐⭐ | ⭐⭐⭐ | ⭐⭐⭐⭐ |\\n| **Suporte** | ⭐⭐⭐⭐⭐ | ⭐⭐⭐ | ⭐⭐ |\\n| **Risco de Bloqueio** | ❌ Nenhum | ⚠️ Médio | ⚠️ Alto |\\n| **Escalabilidade** | ⭐⭐⭐⭐⭐ | ⭐⭐⭐⭐ | ⭐⭐ |\\n| **Limite de Msgs** | Ilimitado | Ilimitado | Ilimitado |\\n| **Recomendado** | ✅ Produção | ✅ Teste | ❌ Risco |\\n\\n---\\n\\n## 🎯 Recomendação para Áquila Pro\\n\\n### Estratégia Híbrida (Recomendada)\\n\\n```\\n1. Usar Meta WhatsApp Business API para alertas críticos\\n   - Custo: ~$900/ano\\n   - Confiabilidade: Máxima\\n   - Casos: Aluno saiu da escola, câmera offline\\n\\n2. Usar Evolution API para notificações gerais\\n   - Custo: $0/ano (self-hosted)\\n   - Confiabilidade: Boa\\n   - Casos: Presença, relatórios, avisos\\n\\n3. Fallback para Email (Mailgun) se WhatsApp falhar\\n   - Custo: $0/ano (5k emails/mês gratuito)\\n   - Confiabilidade: Excelente\\n```\\n\\n### Implementação\\n\\n```typescript\\n// WhatsAppNotificationService.ts\\n\\nexport class WhatsAppNotificationService {\\n  private metaAPI: WhatsAppBusinessAPI;\\n  private evolutionAPI: EvolutionAPIIntegration;\\n  private emailService: EmailService;\\n\\n  async sendAlert(\\n    parentPhone: string,\\n    studentName: string,\\n    alertType: 'critical' | 'normal'\\n  ): Promise<void> {\\n    const message = `Alerta Áquila: ${studentName} - ${alertType}`;\\n\\n    try {\\n      if (alertType === 'critical') {\\n        // Usar Meta API para alertas críticos\\n        await this.metaAPI.sendMessage(parentPhone, message);\\n      } else {\\n        // Usar Evolution API para notificações gerais\\n        await this.evolutionAPI.sendMessage('default', parentPhone, message);\\n      }\\n    } catch (error) {\\n      // Fallback para email\\n      await this.emailService.sendAlert(parentPhone, message);\\n    }\\n  }\\n}\\n```\\n\\n---\\n\\n## 💰 Custo Anual Comparativo\\n\\n### Escola com 500 alunos\\n\\n| Solução | Custo Anual | Confiabilidade | Recomendação |\\n|---------|-----------|---------------|--------------|\\n| **Meta API** | $900 | Máxima | ✅ Melhor |\\n| **Evolution API** | $0 | Boa | ✅ Bom |\\n| **Baileys** | $0 | Baixa | ❌ Risco |\\n| **Híbrida** | $900 | Máxima | ✅ Ideal |\\n\\n---\\n\\n## ✅ Próximos Passos\\n\\n1. **Escolher Estratégia**\\n   - [ ] Apenas Meta API\\n   - [ ] Apenas Evolution API\\n   - [ ] Híbrida (Meta + Evolution)\\n   - [ ] Híbrida + Email\\n\\n2. **Implementar Meta API**\\n   - [ ] Criar conta Business\\n   - [ ] Solicitar acesso à API\\n   - [ ] Configurar webhook\\n   - [ ] Integrar com Áquila Pro\\n\\n3. **Implementar Evolution API** (opcional)\\n   - [ ] Instalar servidor\\n   - [ ] Conectar WhatsApp\\n   - [ ] Integrar com Áquila Pro\\n\\n4. **Testar**\\n   - [ ] Enviar mensagens de teste\\n   - [ ] Validar entrega\\n   - [ ] Monitorar custos\\n\\n---\\n\\n## 📚 Recursos\\n\\n- [Meta WhatsApp Business API](https://developers.facebook.com/docs/whatsapp/business-messaging-api)\\n- [Evolution API GitHub](https://github.com/EvolutionAPI/evolution-api)\\n- [Baileys GitHub](https://github.com/WhiskeySockets/Baileys)\\n- [WhatsApp Cloud API Docs](https://developers.facebook.com/docs/whatsapp/cloud-api)\\n":[1,2]},"outlinks":[{"title":"Meta WhatsApp Business API","target":"https://developers.facebook.com/docs/whatsapp/business-messaging-api","line":1},{"title":"WhatsApp Cloud API Docs","target":"https://developers.facebook.com/docs/whatsapp/cloud-api","line":1},{"title":"Evolution API GitHub","target":"https://github.com/EvolutionAPI/evolution-api","line":1},{"title":"Baileys GitHub","target":"https://github.com/WhiskeySockets/Baileys","line":1}],"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"b283xy","at":1774580843572}},"smart_blocks:docs/WHATSAPP_API_ANALYSIS.md#📱 Análise: APIs Gratuitas de WhatsApp para Áquila Pro\\n\\n## 📋 Resumo Executivo\\n\\nExistem **3 opções viáveis** para enviar mensagens WhatsApp gratuitamente:\\n\\n1. ✅ **WhatsApp Business API (Meta)** - Gratuito com limite\\n2. ✅ **Evolution API** - Open-source, self-hosted\\n3. ✅ **Baileys** - Node.js library, simples\\n\\n---\\n\\n## 🥇 Opção 1: WhatsApp Business API (Meta) - Recomendado\\n\\n### O que é\\n\\nAPI oficial do WhatsApp fornecida pela Meta (Facebook) para negócios\\n\\n### Preços\\n\\n| Tipo | Custo | Limite |\\n|------|-------|--------|\\n| **Sandbox** | Gratuito | 100 mensagens/dia |\\n| **Produção** | $0.0035-0.0500 por msg | Ilimitado |\\n\\n### Como Funciona\\n\\n```\\n1. Criar conta Business na Meta\\n2. Solicitar acesso à API\\n3. Configurar webhook para receber mensagens\\n4. Enviar mensagens via API REST\\n```\\n\\n### Vantagens\\n\\n✅ Oficial e confiável\\n✅ Sandbox gratuito (100 msgs/dia)\\n✅ Muito simples de integrar\\n✅ Suporta templates de mensagens\\n✅ Webhooks para receber respostas\\n✅ Analytics integrado\\n\\n### Desvantagens\\n\\n❌ Requer verificação de negócio\\n❌ Requer número de telefone dedicado\\n❌ Pago em produção ($0.0035-0.05 por msg)\\n❌ Limite de 100 msgs/dia em sandbox\\n\\n### Implementação\\n\\n```typescript\\n// WhatsAppBusinessAPI.ts\\n\\nexport class WhatsAppBusinessAPI {\\n  private accessToken: string;\\n  private phoneNumberId: string;\\n  private apiUrl = 'https://graph.instagram.com/v18.0';\\n\\n  constructor(accessToken: string, phoneNumberId: string) {\\n    this.accessToken = accessToken;\\n    this.phoneNumberId = phoneNumberId;\\n  }\\n\\n  async sendMessage(to: string, message: string): Promise<any> {\\n    const url = `${this.apiUrl}/${this.phoneNumberId}/messages`;\\n\\n    const response = await fetch(url, {\\n      method: 'POST',\\n      headers: {\\n        'Authorization': `Bearer ${this.accessToken}`,\\n        'Content-Type': 'application/json',\\n      },\\n      body: JSON.stringify({\\n        messaging_product: 'whatsapp',\\n        to,\\n        type: 'text',\\n        text: { body: message },\\n      }),\\n    });\\n\\n    return response.json();\\n  }\\n\\n  async sendTemplate(\\n    to: string,\\n    templateName: string,\\n    parameters: string[]\\n  ): Promise<any> {\\n    const url = `${this.apiUrl}/${this.phoneNumberId}/messages`;\\n\\n    const response = await fetch(url, {\\n      method: 'POST',\\n      headers: {\\n        'Authorization': `Bearer ${this.accessToken}`,\\n        'Content-Type': 'application/json',\\n      },\\n      body: JSON.stringify({\\n        messaging_product: 'whatsapp',\\n        to,\\n        type: 'template',\\n        template: {\\n          name: templateName,\\n          language: { code: 'pt_BR' },\\n          parameters: {\\n            body: {\\n              parameters: parameters.map(p => ({ type: 'text', text: p })),\\n            },\\n          },\\n        },\\n      }),\\n    });\\n\\n    return response.json();\\n  }\\n}\\n```\\n\\n### Custo para Escola com 500 alunos\\n\\n```\\nCenário: 2 alertas por aluno por dia, 250 dias úteis\\n\\nMensagens/dia: 500 alunos × 2 alertas = 1,000 msgs\\nMensagens/mês: 1,000 × 22 dias = 22,000 msgs\\nMensagens/ano: 22,000 × 12 = 264,000 msgs\\n\\nCusto (taxa média $0.0035):\\n264,000 × $0.0035 = $924/ano\\n\\nCusto (taxa máxima $0.05):\\n264,000 × $0.05 = $13,200/ano\\n```\\n\\n---\\n\\n## 🥈 Opção 2: Evolution API - Open-Source\\n\\n### O que é\\n\\nAPI open-source que funciona como \\\"proxy\\\" do WhatsApp, permitindo enviar mensagens sem custos\\n\\n### Preços\\n\\n| Tipo | Custo |\\n|------|-------|\\n| **Self-hosted** | Gratuito |\\n| **Cloud** | $9.99-99.99/mês |\\n\\n### Como Funciona\\n\\n```\\n1. Instalar Evolution API em servidor próprio\\n2. Conectar conta WhatsApp pessoal/business\\n3. Usar API para enviar mensagens\\n4. Sem limites de mensagens\\n```\\n\\n### Vantagens\\n\\n✅ Completamente gratuito (self-hosted)\\n✅ Sem limites de mensagens\\n✅ Open-source\\n✅ Funciona com WhatsApp pessoal ou Business\\n✅ Suporta múltiplas contas\\n✅ Webhooks para eventos\\n\\n### Desvantagens\\n\\n❌ Requer servidor próprio\\n❌ Mais complexo de configurar\\n❌ Pode ser bloqueado pelo WhatsApp (risco)\\n❌ Requer manutenção técnica\\n❌ Não é oficial da Meta\\n\\n### Instalação\\n\\n```bash\\n# Docker\\ndocker run -d \\\\\\n  -p 8080:8080 \\\\\\n  -e DATABASE_CONNECTION_URI=mongodb://mongo:27017 \\\\\\n  -e JWT_SECRET=seu-secret \\\\\\n  --name evolution-api \\\\\\n  evolucaocodes/evolution-api:latest\\n\\n# Acessar em http://localhost:8080\\n```\\n\\n### Implementação\\n\\n```typescript\\n// EvolutionAPIIntegration.ts\\n\\nexport class EvolutionAPIIntegration {\\n  private baseUrl: string;\\n  private apiKey: string;\\n\\n  constructor(baseUrl: string, apiKey: string) {\\n    this.baseUrl = baseUrl;\\n    this.apiKey = apiKey;\\n  }\\n\\n  async sendMessage(instanceName: string, to: string, message: string): Promise<any> {\\n    const response = await fetch(\\n      `${this.baseUrl}/message/sendText/${instanceName}`,\\n      {\\n        method: 'POST',\\n        headers: {\\n          'Content-Type': 'application/json',\\n          'apikey': this.apiKey,\\n        },\\n        body: JSON.stringify({\\n          number: to,\\n          text: message,\\n        }),\\n      }\\n    );\\n\\n    return response.json();\\n  }\\n\\n  async sendMedia(\\n    instanceName: string,\\n    to: string,\\n    mediaUrl: string,\\n    caption: string\\n  ): Promise<any> {\\n    const response = await fetch(\\n      `${this.baseUrl}/message/sendMedia/${instanceName}`,\\n      {\\n        method: 'POST',\\n        headers: {\\n          'Content-Type': 'application/json',\\n          'apikey': this.apiKey,\\n        },\\n        body: JSON.stringify({\\n          number: to,\\n          mediaType: 'image',\\n          media: mediaUrl,\\n          caption,\\n        }),\\n      }\\n    );\\n\\n    return response.json();\\n  }\\n}\\n```\\n\\n### Custo para Escola\\n\\n```\\nSelf-hosted: $0/ano (apenas eletricidade ~$20)\\nCloud: $120-1,200/ano\\n```\\n\\n---\\n\\n## 🥉 Opção 3: Baileys - Node.js Library\\n\\n### O que é\\n\\nBiblioteca Node.js que simula cliente WhatsApp Web\\n\\n### Preços\\n\\n| Tipo | Custo |\\n|------|-------|\\n| **NPM** | Gratuito |\\n\\n### Como Funciona\\n\\n```\\n1. Instalar via npm\\n2. Conectar com QR code\\n3. Enviar mensagens via código\\n4. Sem API, sem custos\\n```\\n\\n### Vantagens\\n\\n✅ Completamente gratuito\\n✅ Muito simples de usar\\n✅ Sem servidor adicional\\n✅ Funciona com WhatsApp pessoal\\n✅ Suporta múltiplos tipos de mensagens\\n\\n### Desvantagens\\n\\n❌ Pode ser bloqueado pelo WhatsApp\\n❌ Menos confiável que API oficial\\n❌ Requer manutenção frequente\\n❌ Não é suportado pela Meta\\n❌ Risco de banimento\\n\\n### Instalação\\n\\n```bash\\nnpm install @whiskeysockets/baileys\\n```\\n\\n### Implementação\\n\\n```typescript\\n// BaileysIntegration.ts\\n\\nimport makeWASocket from '@whiskeysockets/baileys';\\nimport { DisconnectReason } from '@whiskeysockets/baileys';\\n\\nexport class BaileysIntegration {\\n  private sock: any;\\n\\n  async connect(): Promise<void> {\\n    const sock = makeWASocket({\\n      auth: {\\n        creds: {},\\n        keys: {},\\n      },\\n    });\\n\\n    sock.ev.on('connection.update', (update: any) => {\\n      const { connection, lastDisconnect } = update;\\n      if (connection === 'close') {\\n        const shouldReconnect =\\n          lastDisconnect?.error?.output?.statusCode !== DisconnectReason.loggedOut;\\n        console.log(\\n          'connection closed due to ',\\n          lastDisconnect?.error,\\n          ', reconnecting ',\\n          shouldReconnect\\n        );\\n      }\\n    });\\n\\n    this.sock = sock;\\n  }\\n\\n  async sendMessage(to: string, message: string): Promise<void> {\\n    await this.sock.sendMessage(to, { text: message });\\n  }\\n\\n  async sendMedia(to: string, mediaUrl: string, caption: string): Promise<void> {\\n    const media = await fetch(mediaUrl).then(r => r.buffer());\\n    await this.sock.sendMessage(to, {\\n      image: media,\\n      caption,\\n    });\\n  }\\n}\\n```\\n\\n---\\n\\n## 📊 Comparação das 3 Opções\\n\\n| Critério | Meta API | Evolution API | Baileys |\\n|----------|----------|---------------|----------|\\n| **Custo** | $0-13k/ano | $0/ano | $0/ano |\\n| **Confiabilidade** | ⭐⭐⭐⭐⭐ | ⭐⭐⭐ | ⭐⭐ |\\n| **Facilidade** | ⭐⭐⭐⭐ | ⭐⭐⭐ | ⭐⭐⭐⭐ |\\n| **Suporte** | ⭐⭐⭐⭐⭐ | ⭐⭐⭐ | ⭐⭐ |\\n| **Risco de Bloqueio** | ❌ Nenhum | ⚠️ Médio | ⚠️ Alto |\\n| **Escalabilidade** | ⭐⭐⭐⭐⭐ | ⭐⭐⭐⭐ | ⭐⭐ |\\n| **Limite de Msgs** | Ilimitado | Ilimitado | Ilimitado |\\n| **Recomendado** | ✅ Produção | ✅ Teste | ❌ Risco |\\n\\n---\\n\\n## 🎯 Recomendação para Áquila Pro\\n\\n### Estratégia Híbrida (Recomendada)\\n\\n```\\n1. Usar Meta WhatsApp Business API para alertas críticos\\n   - Custo: ~$900/ano\\n   - Confiabilidade: Máxima\\n   - Casos: Aluno saiu da escola, câmera offline\\n\\n2. Usar Evolution API para notificações gerais\\n   - Custo: $0/ano (self-hosted)\\n   - Confiabilidade: Boa\\n   - Casos: Presença, relatórios, avisos\\n\\n3. Fallback para Email (Mailgun) se WhatsApp falhar\\n   - Custo: $0/ano (5k emails/mês gratuito)\\n   - Confiabilidade: Excelente\\n```\\n\\n### Implementação\\n\\n```typescript\\n// WhatsAppNotificationService.ts\\n\\nexport class WhatsAppNotificationService {\\n  private metaAPI: WhatsAppBusinessAPI;\\n  private evolutionAPI: EvolutionAPIIntegration;\\n  private emailService: EmailService;\\n\\n  async sendAlert(\\n    parentPhone: string,\\n    studentName: string,\\n    alertType: 'critical' | 'normal'\\n  ): Promise<void> {\\n    const message = `Alerta Áquila: ${studentName} - ${alertType}`;\\n\\n    try {\\n      if (alertType === 'critical') {\\n        // Usar Meta API para alertas críticos\\n        await this.metaAPI.sendMessage(parentPhone, message);\\n      } else {\\n        // Usar Evolution API para notificações gerais\\n        await this.evolutionAPI.sendMessage('default', parentPhone, message);\\n      }\\n    } catch (error) {\\n      // Fallback para email\\n      await this.emailService.sendAlert(parentPhone, message);\\n    }\\n  }\\n}\\n```\\n\\n---\\n\\n## 💰 Custo Anual Comparativo\\n\\n### Escola com 500 alunos\\n\\n| Solução | Custo Anual | Confiabilidade | Recomendação |\\n|---------|-----------|---------------|--------------|\\n| **Meta API** | $900 | Máxima | ✅ Melhor |\\n| **Evolution API** | $0 | Boa | ✅ Bom |\\n| **Baileys** | $0 | Baixa | ❌ Risco |\\n| **Híbrida** | $900 | Máxima | ✅ Ideal |\\n\\n---\\n\\n## ✅ Próximos Passos\\n\\n1. **Escolher Estratégia**\\n   - [ ] Apenas Meta API\\n   - [ ] Apenas Evolution API\\n   - [ ] Híbrida (Meta + Evolution)\\n   - [ ] Híbrida + Email\\n\\n2. **Implementar Meta API**\\n   - [ ] Criar conta Business\\n   - [ ] Solicitar acesso à API\\n   - [ ] Configurar webhook\\n   - [ ] Integrar com Áquila Pro\\n\\n3. **Implementar Evolution API** (opcional)\\n   - [ ] Instalar servidor\\n   - [ ] Conectar WhatsApp\\n   - [ ] Integrar com Áquila Pro\\n\\n4. **Testar**\\n   - [ ] Enviar mensagens de teste\\n   - [ ] Validar entrega\\n   - [ ] Monitorar custos\\n\\n---\\n\\n## 📚 Recursos\\n\\n- [Meta WhatsApp Business API](https://developers.facebook.com/docs/whatsapp/business-messaging-api)\\n- [Evolution API GitHub](https://github.com/EvolutionAPI/evolution-api)\\n- [Baileys GitHub](https://github.com/WhiskeySockets/Baileys)\\n- [WhatsApp Cloud API Docs](https://developers.facebook.com/docs/whatsapp/cloud-api)\\n": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.02167519,-0.03152743,-0.03377988,-0.07791886,0.02943195,-0.02496466,-0.01496001,0.01667666,0.01511914,-0.0336573,0.01276873,-0.04585403,0.03142304,-0.01352339,0.00466345,-0.00651156,0.04382759,-0.0235799,-0.08534008,-0.01242457,0.11606354,-0.06582802,-0.01917113,-0.03108214,-0.0311244,0.02774283,-0.05080253,0.01625409,-0.03472618,-0.1658527,0.01097139,-0.04505887,0.04609414,-0.01299999,0.02301524,0.04656795,-0.00243821,-0.04089056,-0.02015298,0.06393854,-0.0225899,-0.00840582,0.0003284,-0.01273743,-0.01900888,-0.02503115,-0.02936326,0.04972146,-0.08187635,-0.01748348,-0.06615923,-0.00735158,-0.02760424,-0.00267591,0.00436766,0.02192667,0.03258955,0.07491279,-0.00644827,0.07847438,0.0598227,0.04792359,-0.22019115,0.05628856,-0.0237547,0.07283998,-0.10882206,0.00313122,0.01234671,-0.00287969,-0.01032212,-0.00675902,0.0647536,0.01399381,0.07293097,0.05345734,0.01379921,-0.02733279,0.01553212,0.0478491,0.03501432,0.03764737,0.00849758,0.04377288,0.01117799,-0.05642305,0.0223618,0.0005693,0.05803702,-0.00803756,-0.03471147,-0.00998662,0.01797772,0.01038346,-0.0480507,-0.01155098,0.01355253,0.0283343,-0.04092145,0.08231107,-0.03397914,0.0199559,0.00679841,-0.01203028,0.00666941,-0.0537584,-0.05512769,-0.06784124,0.03930465,0.03832819,-0.03343088,0.00374493,0.01146693,-0.0830227,-0.03906208,-0.00458417,0.01161161,-0.00277424,0.03169448,-0.04029259,0.02212663,0.00119448,0.04750453,-0.01742858,0.02534878,-0.00431457,0.0617829,0.04101642,-0.01579426,0.0709857,0.07256163,0.09671979,-0.0601255,-0.00512473,-0.01351236,-0.027226,0.04470558,0.0173491,-0.03802716,0.04333907,-0.05136256,-0.06882446,0.00694233,-0.07663482,-0.04001435,0.16637766,0.00680554,0.04078663,-0.00900067,-0.0409109,-0.04967674,0.09580804,-0.03769447,-0.01157092,-0.02752434,0.00053996,0.07701876,0.06738893,-0.05608297,0.00787984,-0.08152197,-0.06714302,-0.01882668,0.16882488,0.03530199,-0.16454767,-0.02867362,0.06148174,0.00864075,-0.01824981,0.03719079,0.01793083,-0.00727901,-0.01386616,0.04224002,0.00942913,0.00511643,-0.02013895,0.01908161,-0.01074083,-0.00505782,-0.04257167,-0.08357515,0.0119039,-0.03430481,-0.04531131,0.00945756,-0.02586964,0.02944018,-0.02244907,-0.05239294,-0.01128137,-0.01540347,0.00633061,-0.02095377,0.01378091,-0.01870864,0.00522093,0.0331276,-0.05286257,0.09134226,0.0447311,-0.00038204,-0.00297755,0.00592129,0.02372926,-0.03161984,0.04716298,0.01697232,-0.01304481,-0.03531276,0.01831464,0.01413377,0.03832052,0.03563501,0.02327792,0.02039836,0.00505827,0.0104949,0.08290862,0.02645239,0.01971705,-0.00151469,-0.2016094,-0.00870092,-0.02499017,0.03810182,-0.03125713,-0.09435617,0.02838371,-0.07324024,0.07974172,0.11400256,0.10277083,0.00137327,-0.0566982,0.04644615,-0.00525397,0.0249128,0.02439832,0.00075598,-0.01528842,0.02659656,-0.04215058,-0.01774731,0.0230679,-0.05628442,0.02455688,-0.01209982,0.13701767,0.02372732,0.00541665,-0.02136072,0.06756629,-0.00987221,-0.04228759,-0.12499439,0.04103011,0.08745643,0.01859614,-0.06803815,0.04628948,-0.02247029,-0.02141506,0.0606905,0.02554221,-0.08524288,-0.00846708,-0.01910372,0.00704747,-0.03257939,-0.0647598,0.07737903,-0.02446697,0.05052336,0.05896915,0.04296993,0.00296023,-0.02900882,-0.0689482,-0.00968726,-0.02324957,0.03255459,-0.03797269,-0.02571337,0.00246744,-0.01346015,0.03317681,-0.00343653,-0.00421414,-0.03866276,0.00614603,-0.03957056,0.01770056,0.14203416,0.00192262,0.0156331,-0.02616753,0.03591106,0.02873796,-0.0732563,-0.03801188,0.02741621,0.01422691,0.02130608,0.01451555,0.03790988,0.02972865,0.04040606,0.0751572,-0.04008878,0.00962483,-0.02536181,-0.00291573,0.01399785,-0.06595547,-0.04488927,0.07797068,-0.00382873,-0.30214053,0.0238876,-0.00444735,-0.04583889,-0.01514555,0.01843478,0.02241431,-0.0461488,-0.09514311,-0.0028984,-0.0170046,0.03321502,0.04282709,0.01143766,0.02724504,-0.01591975,0.03184446,0.0040813,0.097506,-0.04912116,0.00331196,0.03935663,0.20205575,0.02729714,-0.00737653,0.0268972,-0.02276366,0.02907995,0.00181432,0.00607504,-0.02247315,-0.0202562,0.06228385,-0.03507769,0.00615078,0.03199343,-0.0371583,0.00811737,0.039947,0.00624534,0.02114899,-0.03538555,0.02462145,0.02310577,0.08715153,-0.06045807,-0.05632709,-0.02810269,0.02284006,0.05071069,-0.04439393,-0.06705648,-0.01636811,-0.00509841,0.02618806,0.02148806,-0.02603222,-0.01660526,-0.07989236,-0.02649412,0.00688376,0.03556612,0.01537529,0.06887382,0.06947999],"last_embed":{"hash":"b283xy","tokens":485}}},"text":null,"length":0,"last_read":{"hash":"b283xy","at":1774580843764},"key":"docs/WHATSAPP_API_ANALYSIS.md#📱 Análise: APIs Gratuitas de WhatsApp para Áquila Pro\\n\\n## 📋 Resumo Executivo\\n\\nExistem **3 opções viáveis** para enviar mensagens WhatsApp gratuitamente:\\n\\n1. ✅ **WhatsApp Business API (Meta)** - Gratuito com limite\\n2. ✅ **Evolution API** - Open-source, self-hosted\\n3. ✅ **Baileys** - Node.js library, simples\\n\\n---\\n\\n## 🥇 Opção 1: WhatsApp Business API (Meta) - Recomendado\\n\\n### O que é\\n\\nAPI oficial do WhatsApp fornecida pela Meta (Facebook) para negócios\\n\\n### Preços\\n\\n| Tipo | Custo | Limite |\\n|------|-------|--------|\\n| **Sandbox** | Gratuito | 100 mensagens/dia |\\n| **Produção** | $0.0035-0.0500 por msg | Ilimitado |\\n\\n### Como Funciona\\n\\n```\\n1. Criar conta Business na Meta\\n2. Solicitar acesso à API\\n3. Configurar webhook para receber mensagens\\n4. Enviar mensagens via API REST\\n```\\n\\n### Vantagens\\n\\n✅ Oficial e confiável\\n✅ Sandbox gratuito (100 msgs/dia)\\n✅ Muito simples de integrar\\n✅ Suporta templates de mensagens\\n✅ Webhooks para receber respostas\\n✅ Analytics integrado\\n\\n### Desvantagens\\n\\n❌ Requer verificação de negócio\\n❌ Requer número de telefone dedicado\\n❌ Pago em produção ($0.0035-0.05 por msg)\\n❌ Limite de 100 msgs/dia em sandbox\\n\\n### Implementação\\n\\n```typescript\\n// WhatsAppBusinessAPI.ts\\n\\nexport class WhatsAppBusinessAPI {\\n  private accessToken: string;\\n  private phoneNumberId: string;\\n  private apiUrl = 'https://graph.instagram.com/v18.0';\\n\\n  constructor(accessToken: string, phoneNumberId: string) {\\n    this.accessToken = accessToken;\\n    this.phoneNumberId = phoneNumberId;\\n  }\\n\\n  async sendMessage(to: string, message: string): Promise<any> {\\n    const url = `${this.apiUrl}/${this.phoneNumberId}/messages`;\\n\\n    const response = await fetch(url, {\\n      method: 'POST',\\n      headers: {\\n        'Authorization': `Bearer ${this.accessToken}`,\\n        'Content-Type': 'application/json',\\n      },\\n      body: JSON.stringify({\\n        messaging_product: 'whatsapp',\\n        to,\\n        type: 'text',\\n        text: { body: message },\\n      }),\\n    });\\n\\n    return response.json();\\n  }\\n\\n  async sendTemplate(\\n    to: string,\\n    templateName: string,\\n    parameters: string[]\\n  ): Promise<any> {\\n    const url = `${this.apiUrl}/${this.phoneNumberId}/messages`;\\n\\n    const response = await fetch(url, {\\n      method: 'POST',\\n      headers: {\\n        'Authorization': `Bearer ${this.accessToken}`,\\n        'Content-Type': 'application/json',\\n      },\\n      body: JSON.stringify({\\n        messaging_product: 'whatsapp',\\n        to,\\n        type: 'template',\\n        template: {\\n          name: templateName,\\n          language: { code: 'pt_BR' },\\n          parameters: {\\n            body: {\\n              parameters: parameters.map(p => ({ type: 'text', text: p })),\\n            },\\n          },\\n        },\\n      }),\\n    });\\n\\n    return response.json();\\n  }\\n}\\n```\\n\\n### Custo para Escola com 500 alunos\\n\\n```\\nCenário: 2 alertas por aluno por dia, 250 dias úteis\\n\\nMensagens/dia: 500 alunos × 2 alertas = 1,000 msgs\\nMensagens/mês: 1,000 × 22 dias = 22,000 msgs\\nMensagens/ano: 22,000 × 12 = 264,000 msgs\\n\\nCusto (taxa média $0.0035):\\n264,000 × $0.0035 = $924/ano\\n\\nCusto (taxa máxima $0.05):\\n264,000 × $0.05 = $13,200/ano\\n```\\n\\n---\\n\\n## 🥈 Opção 2: Evolution API - Open-Source\\n\\n### O que é\\n\\nAPI open-source que funciona como \\\"proxy\\\" do WhatsApp, permitindo enviar mensagens sem custos\\n\\n### Preços\\n\\n| Tipo | Custo |\\n|------|-------|\\n| **Self-hosted** | Gratuito |\\n| **Cloud** | $9.99-99.99/mês |\\n\\n### Como Funciona\\n\\n```\\n1. Instalar Evolution API em servidor próprio\\n2. Conectar conta WhatsApp pessoal/business\\n3. Usar API para enviar mensagens\\n4. Sem limites de mensagens\\n```\\n\\n### Vantagens\\n\\n✅ Completamente gratuito (self-hosted)\\n✅ Sem limites de mensagens\\n✅ Open-source\\n✅ Funciona com WhatsApp pessoal ou Business\\n✅ Suporta múltiplas contas\\n✅ Webhooks para eventos\\n\\n### Desvantagens\\n\\n❌ Requer servidor próprio\\n❌ Mais complexo de configurar\\n❌ Pode ser bloqueado pelo WhatsApp (risco)\\n❌ Requer manutenção técnica\\n❌ Não é oficial da Meta\\n\\n### Instalação\\n\\n```bash\\n# Docker\\ndocker run -d \\\\\\n  -p 8080:8080 \\\\\\n  -e DATABASE_CONNECTION_URI=mongodb://mongo:27017 \\\\\\n  -e JWT_SECRET=seu-secret \\\\\\n  --name evolution-api \\\\\\n  evolucaocodes/evolution-api:latest\\n\\n# Acessar em http://localhost:8080\\n```\\n\\n### Implementação\\n\\n```typescript\\n// EvolutionAPIIntegration.ts\\n\\nexport class EvolutionAPIIntegration {\\n  private baseUrl: string;\\n  private apiKey: string;\\n\\n  constructor(baseUrl: string, apiKey: string) {\\n    this.baseUrl = baseUrl;\\n    this.apiKey = apiKey;\\n  }\\n\\n  async sendMessage(instanceName: string, to: string, message: string): Promise<any> {\\n    const response = await fetch(\\n      `${this.baseUrl}/message/sendText/${instanceName}`,\\n      {\\n        method: 'POST',\\n        headers: {\\n          'Content-Type': 'application/json',\\n          'apikey': this.apiKey,\\n        },\\n        body: JSON.stringify({\\n          number: to,\\n          text: message,\\n        }),\\n      }\\n    );\\n\\n    return response.json();\\n  }\\n\\n  async sendMedia(\\n    instanceName: string,\\n    to: string,\\n    mediaUrl: string,\\n    caption: string\\n  ): Promise<any> {\\n    const response = await fetch(\\n      `${this.baseUrl}/message/sendMedia/${instanceName}`,\\n      {\\n        method: 'POST',\\n        headers: {\\n          'Content-Type': 'application/json',\\n          'apikey': this.apiKey,\\n        },\\n        body: JSON.stringify({\\n          number: to,\\n          mediaType: 'image',\\n          media: mediaUrl,\\n          caption,\\n        }),\\n      }\\n    );\\n\\n    return response.json();\\n  }\\n}\\n```\\n\\n### Custo para Escola\\n\\n```\\nSelf-hosted: $0/ano (apenas eletricidade ~$20)\\nCloud: $120-1,200/ano\\n```\\n\\n---\\n\\n## 🥉 Opção 3: Baileys - Node.js Library\\n\\n### O que é\\n\\nBiblioteca Node.js que simula cliente WhatsApp Web\\n\\n### Preços\\n\\n| Tipo | Custo |\\n|------|-------|\\n| **NPM** | Gratuito |\\n\\n### Como Funciona\\n\\n```\\n1. Instalar via npm\\n2. Conectar com QR code\\n3. Enviar mensagens via código\\n4. Sem API, sem custos\\n```\\n\\n### Vantagens\\n\\n✅ Completamente gratuito\\n✅ Muito simples de usar\\n✅ Sem servidor adicional\\n✅ Funciona com WhatsApp pessoal\\n✅ Suporta múltiplos tipos de mensagens\\n\\n### Desvantagens\\n\\n❌ Pode ser bloqueado pelo WhatsApp\\n❌ Menos confiável que API oficial\\n❌ Requer manutenção frequente\\n❌ Não é suportado pela Meta\\n❌ Risco de banimento\\n\\n### Instalação\\n\\n```bash\\nnpm install @whiskeysockets/baileys\\n```\\n\\n### Implementação\\n\\n```typescript\\n// BaileysIntegration.ts\\n\\nimport makeWASocket from '@whiskeysockets/baileys';\\nimport { DisconnectReason } from '@whiskeysockets/baileys';\\n\\nexport class BaileysIntegration {\\n  private sock: any;\\n\\n  async connect(): Promise<void> {\\n    const sock = makeWASocket({\\n      auth: {\\n        creds: {},\\n        keys: {},\\n      },\\n    });\\n\\n    sock.ev.on('connection.update', (update: any) => {\\n      const { connection, lastDisconnect } = update;\\n      if (connection === 'close') {\\n        const shouldReconnect =\\n          lastDisconnect?.error?.output?.statusCode !== DisconnectReason.loggedOut;\\n        console.log(\\n          'connection closed due to ',\\n          lastDisconnect?.error,\\n          ', reconnecting ',\\n          shouldReconnect\\n        );\\n      }\\n    });\\n\\n    this.sock = sock;\\n  }\\n\\n  async sendMessage(to: string, message: string): Promise<void> {\\n    await this.sock.sendMessage(to, { text: message });\\n  }\\n\\n  async sendMedia(to: string, mediaUrl: string, caption: string): Promise<void> {\\n    const media = await fetch(mediaUrl).then(r => r.buffer());\\n    await this.sock.sendMessage(to, {\\n      image: media,\\n      caption,\\n    });\\n  }\\n}\\n```\\n\\n---\\n\\n## 📊 Comparação das 3 Opções\\n\\n| Critério | Meta API | Evolution API | Baileys |\\n|----------|----------|---------------|----------|\\n| **Custo** | $0-13k/ano | $0/ano | $0/ano |\\n| **Confiabilidade** | ⭐⭐⭐⭐⭐ | ⭐⭐⭐ | ⭐⭐ |\\n| **Facilidade** | ⭐⭐⭐⭐ | ⭐⭐⭐ | ⭐⭐⭐⭐ |\\n| **Suporte** | ⭐⭐⭐⭐⭐ | ⭐⭐⭐ | ⭐⭐ |\\n| **Risco de Bloqueio** | ❌ Nenhum | ⚠️ Médio | ⚠️ Alto |\\n| **Escalabilidade** | ⭐⭐⭐⭐⭐ | ⭐⭐⭐⭐ | ⭐⭐ |\\n| **Limite de Msgs** | Ilimitado | Ilimitado | Ilimitado |\\n| **Recomendado** | ✅ Produção | ✅ Teste | ❌ Risco |\\n\\n---\\n\\n## 🎯 Recomendação para Áquila Pro\\n\\n### Estratégia Híbrida (Recomendada)\\n\\n```\\n1. Usar Meta WhatsApp Business API para alertas críticos\\n   - Custo: ~$900/ano\\n   - Confiabilidade: Máxima\\n   - Casos: Aluno saiu da escola, câmera offline\\n\\n2. Usar Evolution API para notificações gerais\\n   - Custo: $0/ano (self-hosted)\\n   - Confiabilidade: Boa\\n   - Casos: Presença, relatórios, avisos\\n\\n3. Fallback para Email (Mailgun) se WhatsApp falhar\\n   - Custo: $0/ano (5k emails/mês gratuito)\\n   - Confiabilidade: Excelente\\n```\\n\\n### Implementação\\n\\n```typescript\\n// WhatsAppNotificationService.ts\\n\\nexport class WhatsAppNotificationService {\\n  private metaAPI: WhatsAppBusinessAPI;\\n  private evolutionAPI: EvolutionAPIIntegration;\\n  private emailService: EmailService;\\n\\n  async sendAlert(\\n    parentPhone: string,\\n    studentName: string,\\n    alertType: 'critical' | 'normal'\\n  ): Promise<void> {\\n    const message = `Alerta Áquila: ${studentName} - ${alertType}`;\\n\\n    try {\\n      if (alertType === 'critical') {\\n        // Usar Meta API para alertas críticos\\n        await this.metaAPI.sendMessage(parentPhone, message);\\n      } else {\\n        // Usar Evolution API para notificações gerais\\n        await this.evolutionAPI.sendMessage('default', parentPhone, message);\\n      }\\n    } catch (error) {\\n      // Fallback para email\\n      await this.emailService.sendAlert(parentPhone, message);\\n    }\\n  }\\n}\\n```\\n\\n---\\n\\n## 💰 Custo Anual Comparativo\\n\\n### Escola com 500 alunos\\n\\n| Solução | Custo Anual | Confiabilidade | Recomendação |\\n|---------|-----------|---------------|--------------|\\n| **Meta API** | $900 | Máxima | ✅ Melhor |\\n| **Evolution API** | $0 | Boa | ✅ Bom |\\n| **Baileys** | $0 | Baixa | ❌ Risco |\\n| **Híbrida** | $900 | Máxima | ✅ Ideal |\\n\\n---\\n\\n## ✅ Próximos Passos\\n\\n1. **Escolher Estratégia**\\n   - [ ] Apenas Meta API\\n   - [ ] Apenas Evolution API\\n   - [ ] Híbrida (Meta + Evolution)\\n   - [ ] Híbrida + Email\\n\\n2. **Implementar Meta API**\\n   - [ ] Criar conta Business\\n   - [ ] Solicitar acesso à API\\n   - [ ] Configurar webhook\\n   - [ ] Integrar com Áquila Pro\\n\\n3. **Implementar Evolution API** (opcional)\\n   - [ ] Instalar servidor\\n   - [ ] Conectar WhatsApp\\n   - [ ] Integrar com Áquila Pro\\n\\n4. **Testar**\\n   - [ ] Enviar mensagens de teste\\n   - [ ] Validar entrega\\n   - [ ] Monitorar custos\\n\\n---\\n\\n## 📚 Recursos\\n\\n- [Meta WhatsApp Business API](https://developers.facebook.com/docs/whatsapp/business-messaging-api)\\n- [Evolution API GitHub](https://github.com/EvolutionAPI/evolution-api)\\n- [Baileys GitHub](https://github.com/WhiskeySockets/Baileys)\\n- [WhatsApp Cloud API Docs](https://developers.facebook.com/docs/whatsapp/cloud-api)\\n","lines":[1,2],"size":11094,"outlinks":[{"title":"Meta WhatsApp Business API","target":"https://developers.facebook.com/docs/whatsapp/business-messaging-api","line":1},{"title":"WhatsApp Cloud API Docs","target":"https://developers.facebook.com/docs/whatsapp/cloud-api","line":1},{"title":"Evolution API GitHub","target":"https://github.com/EvolutionAPI/evolution-api","line":1},{"title":"Baileys GitHub","target":"https://github.com/WhiskeySockets/Baileys","line":1}],"class_name":"SmartBlock","last_embed":{"hash":"b283xy","at":1774580843764}},
