# Áquila Pro — Cloud Backend
# Copie este arquivo para .env e preencha os valores

# ─── Banco de Dados ──────────────────────────────────────────
# Railway: copie o DATABASE_URL do painel do serviço PostgreSQL
DATABASE_URL=postgresql://user:password@host:port/aquila_cloud

# ─── Servidor ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
BASE_URL=https://api.aquilapro.com.br

# ─── Segurança ───────────────────────────────────────────────
# Tokens separados por vírgula para autorizar novas matrículas de escolas
# NUNCA commitar este valor no Git
AQUILA_ADMIN_TOKENS=token_mestre_1,token_mestre_2

# CORS — origem do dashboard admin web
CORS_ORIGIN=https://admin.aquilapro.com.br

# ──────────────────────────────────────────────────────────────────
# WhatsApp Chatbot — Evolution API (auto-hospedado)
# Siga o guia em docker-compose.evolution.yml para subir a Evolution API
# ──────────────────────────────────────────────────────────────────

# URL base da sua instância Evolution API
EVOLUTION_API_URL=http://localhost:8080

# Chave de autenticação (deve ser igual à AUTHENTICATION_API_KEY no docker-compose)
EVOLUTION_API_KEY=aquila-evolution-key-change-me

# Nome da instância criada no painel da Evolution API
EVOLUTION_INSTANCE=aquilapro

# Número do WhatsApp do administrador (somente este número pode usar o bot)
# Formato: código do país + DDD + número, sem hífen ou espaço. Ex: 5561999623099
ADMIN_WHATSAPP_NUMBER=55XXXXXXXXXXX

# URL pública deste servidor (usada pela Evolution API para enviar webhooks)
# Se rodando localmente, use ngrok: https://ngrok.com/
AQUILA_CLOUD_URL=http://localhost:3001

# ─── IA — Google Gemini ──────────────────────────────────────────────
# Obtenha em: https://ai.google.dev/
GEMINI_API_KEY=sua-gemini-api-key-aqui
