# ==============================================================================
# ÁQUILA PRO — AMBIENTE & CONFIGURAÇÕES (TEMPLATE .env.example)
# ==============================================================================
# IMPORTANTE: Nunca versione arquivos .env contendo segredos reais.
# Copie este arquivo para .env e preencha com as credenciais do seu ambiente.
# ==============================================================================

# --- 1. PERSISTÊNCIA & BANCO DE DADOS ---
# SQLite local (padrão soberano de borda em apps/electron)
AQUILA_DB_PATH=%APPDATA%/AquilaPro/aquila.db
SQLITE_WAL_MODE=true

# PostgreSQL / Drizzle (opcional para sincronização de retaguarda / nuvem privada)
DATABASE_URL=postgresql://postgres:password@localhost:5432/aquila_school_db
REDIS_URL=redis://localhost:6379

# --- 2. SUPABASE (BACKEND SOBERANO EM NUVEM) ---
# Atenção: SUPABASE_SERVICE_ROLE_KEY tem privilégios totais e NUNCA deve ser incluída
# no app mobile ou renderer do Electron (apenas processos de backend / migrações).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=DO_NOT_EXPOSE_TO_CLIENT_OR_MOBILE

# --- 3. ÁQUILA GATEWAY CORE (WEBSOCKET & REST) ---
GATEWAY_PORT=9000
GATEWAY_HOST=0.0.0.0
GATEWAY_JWT_SECRET=GENERATE_A_64_CHAR_HEX_SECRET_FOR_SESSION_TOKENS
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,app://aquila.local

# --- 4. LIQUIDAÇÃO FINANCEIRA PIX & PAGAMENTOS ---
# Provedor de Serviços de Pagamento (PSP) e Webhooks
PIX_PSP_API_URL=https://api.psp-homolog.com.br/v2
PIX_PSP_CLIENT_ID=YOUR_PSP_CLIENT_ID
PIX_PSP_CLIENT_SECRET=YOUR_PSP_CLIENT_SECRET
PIX_PSP_CERT_PATH=C:/aquila/certs/pix_certificate.pem
PIX_WEBHOOK_SECRET=YOUR_HMAC_SHA256_WEBHOOK_SIGNING_SECRET

# --- 5. INTELIGÊNCIA ARTIFICIAL & COPILOTS ---
# Google Gemini API (para geração de trilhas pedagógicas e BNCC scaffolding)
GOOGLE_GENERATIVE_AI_API_KEY=YOUR_GEMINI_API_KEY
# Ollama Local (fallback offline para inferência em borda sem envio externo)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_DEFAULT=llama3:8b

# --- 6. COMUNICAÇÃO INSTITUCIONAL & WHATSAPP ---
# Canal Oficial: Meta Cloud API (WhatsApp Business Platform)
META_WHATSAPP_PHONE_ID=YOUR_PHONE_NUMBER_ID
META_WHATSAPP_BEARER_TOKEN=YOUR_META_PERMANENT_ACCESS_TOKEN
META_WHATSAPP_WABA_ID=YOUR_WHATSAPP_BUSINESS_ACCOUNT_ID

# Canal Alternativo (Apenas testes/desenvolvimento): Evolution API
EVOLUTION_API_URL=https://your-evolution-instance.example.com
EVOLUTION_API_KEY=YOUR_EVOLUTION_API_KEY
EVOLUTION_INSTANCE=aquila-pilot

# --- 7. SEGURANÇA, CRIPTOGRAFIA & LGPD ---
# Chave mestra para cifragem local de embeddings biométricos (AES-256-GCM)
BIOMETRIC_ENCRYPTION_SECRET=GENERATE_A_STRONG_AES256_KEY_MIN_32_CHARS
# Segredo para assinatura de integridade da trilha de auditoria (zero_bypass_audits)
AUDIT_LOG_SECRET=GENERATE_AN_AUDIT_LOG_HMAC_SALT_KEY
